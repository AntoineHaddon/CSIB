    "# Import relevant modules\n",
    "from cftime import date2num,num2date\n",
    "import datetime as dt\n",
    "import glob\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import os\n",
    "import scipy as sp\n",
    "import time\n",
    "import warnings\n",
    "import xarray as xr\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "#############\n",
    "# FUNCTIONS #\n",
    "#############\n",
    "\n",
    "def varList(varName,path0,run0):\n",
    "    # search for all variables\n",
    "    if varName=='all':\n",
    "        flist=glob.glob(os.path.join(path0,f'{run0}_*_timeseries.nc'))\n",
    "    else:\n",
    "        flist=glob.glob(os.path.join(path0,f'{run0}_{varName}_timeseries.nc'))\n",
    "    vars2append=[]\n",
    "    if len(flist) > 0:\n",
    "        for fF in flist:\n",
    "            vName=''\n",
    "            vSplit=os.path.basename(fF).split('_')\n",
    "            for iV,vV in enumerate(vSplit):\n",
    "                if iV > 0 and vV != 'timeseries.nc':\n",
    "                    vName+=f'{vV}_'\n",
    "            vars2append.append(vName[0:-1])\n",
    "    return vars2append\n",
    "\n",
    "def annualCycle(dset,var,lcol,rName,axs):\n",
    "    \"\"\"\n",
    "    Plot the mean annual cycle.\n",
    "    \"\"\"\n",
    "    # resample dataset to monthyl frequency\n",
    "    if resampleType=='min':\n",
    "        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time='1ME',skipna=True).min()\n",
    "    elif resampleType=='max':\n",
    "        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time='1ME',skipna=True).max()\n",
    "    else:\n",
    "        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time='1ME',skipna=True).mean()\n",
    "\n",
    "    # get mean of each month\n",
    "    mnths=rds.time.dt.month\n",
    "    aMean=np.full(12,np.nan)\n",
    "    for mM in range(1,13):\n",
    "        aMean[mM-1]=np.nanmean(rds[var].values[mnths==mM])\n",
    "    \n",
    "    # plot\n",
    "    axs.plot(range(1,13),aMean,color=lcol,linewidth=2,label=rName,zorder=np.nanmax([1,1000/len(rds['year'].values)]))\n",
    "\n",
    "def timePerNode(tfile,ofile):\n",
    "    \"\"\"\n",
    "    Simple file parsing to get the time per node based on the\n",
    "    timing.output file and number of nodes in the ocean.output file\n",
    "    \"\"\"\n",
    "    # get times from file\n",
    "    with open(tfile,'r') as tf:\n",
    "        tt=False; et=-1\n",
    "        for iL,lL in enumerate(tf.readlines()):\n",
    "            if tt and (iL==(et+1)):\n",
    "                elapsed=float(lL.split()[0])\n",
    "                cpu=float(lL.split()[1])\n",
    "                break\n",
    "            if tt and 'Elapsed Time (s)  CPU Time (s)' in lL:\n",
    "                et=iL\n",
    "            if 'Total timing (sum)' in lL:\n",
    "                tt=True\n",
    "                \n",
    "    # get number of nodes from output file\n",
    "    with open(ofile,'r') as of:\n",
    "        nproc=None ; nocn=None\n",
    "        for iL,lL in enumerate(of.readlines()):\n",
    "            if 'number of mpi processes:' in lL.lower():\n",
    "                nproc=int(lL.split()[-1])\n",
    "            # if  'number of ocean subdomains =' in lL.lower():\n",
    "            #     nocn=int(lL.split()[-1])\n",
    "            if (nproc is not None): #and (nocn is not None):\n",
    "                break\n",
    "\n",
    "    # return time elapsed in secondes/mpi process and core hours\n",
    "    return (cpu/nproc),cpu/(60.*60.)\n",
    "\n",
    "def findLatestRestart(runpath):\n",
    "    \"\"\"\n",
    "    Find the lastest restart directory in the desired runpath.\n",
    "    \"\"\"\n",
    "    rsd=sorted(glob.glob(os.path.join(runpath,\"mc_*_m12_nemors.*\")),reverse=True)\n",
    "\n",
    "    if len(rsd) > 0:\n",
    "        return rsd[0]\n",
    "    else:\n",
    "        return None\n",
    "\n",
    "def numGridCells(oFile,ovar):\n",
    "    \"\"\"\n",
    "    Determine the number of 3D ocean grid cells from a model output file.\n",
    "    Just removes NaN and 0 values. Not the most elegant, but gives a rough\n",
    "    estimate.\n",
    "    Since it looks for values == 0, best to look for variables such as salinity\n",
    "    which will have very few values = 0 if not a land cell.\n",
    "    \"\"\"\n",
    "\n",
    "    with xr.open_dataset(oFile) as ds:\n",
    "        dsv=ds[ovar].values[0,:,:,:].ravel()\n",
    "        iGood=np.logical_and(~np.isnan(dsv),dsv!=0)\n",
    "\n",
    "    return sum(iGood)\n",
    "\n",
    "\n"
   ]
  },
