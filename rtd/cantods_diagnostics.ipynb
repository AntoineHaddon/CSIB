    "##################\n",
    "# RUN COMPARISON #\n",
    "##################\n",
    "\n",
    "# close existing figures\n",
    "plt.close('all')\n",
    "\n",
    "# get list of variables to plot from first run that contains files\n",
    "vars2plot=[]; iP=0\n",
    "while len(vars2plot)<len(variables):\n",
    "    for vV in variables:\n",
    "        if vV not in vars2plot:\n",
    "            vars2plot.extend(varList(vV,paths[iP],runids[iP]))\n",
    "    iP+=1\n",
    "    if iP==len(runids):\n",
    "        break \n",
    "\n",
    "if len(vars2plot) == 0:\n",
    "    print('No variables to plot!')\n",
    "else:\n",
    "    # loop through each variable\n",
    "    nF=0\n",
    "    for iV,var in enumerate(vars2plot):\n",
    "        print(var)\n",
    "        if rsType is not None:\n",
    "            resampleType=rsType\n",
    "        elif ('T' in var) or ('S' in var) or ('vol' in var):\n",
    "            resampleType='mean'\n",
    "        elif ('si' in var) or ('MLD' in var):\n",
    "            resampleType='max'\n",
    "        # create empty figures\n",
    "        fig={}; ax={}\n",
    "        for iF,freq in enumerate(freqs2plot):\n",
    "            fig[f'{var}_{freq}']=plt.figure(nF+1); nF+=1\n",
    "            ax[f'{var}_{freq}']=plt.gca()\n",
    "            fig[f'{var}_{freq}'].set_figwidth(1.25*fig[f'{var}_{freq}'].get_figwidth())\n",
    "            plt.ylabel(var)\n",
    "            if freq=='default':\n",
    "                plt.xlabel('Simulation Year')\n",
    "                plt.title(f'{var}\\nDefault Output')\n",
    "            else:\n",
    "                plt.xlabel(freq)\n",
    "                plt.title(f'{var}\\n{freq} ({resampleType})')\n",
    "        if plotAnnual:\n",
    "            fig[f'{var}_ann']=plt.figure(nF+1); nF+=1\n",
    "            ax[f'{var}_ann']=plt.gca()\n",
    "            fig[f'{var}_ann'].set_figwidth(1.25*fig[f'{var}_ann'].get_figwidth())\n",
    "            plt.title(f'{var} ({resampleType})\\nMean Annual Cycle')\n",
    "            plt.ylabel(var)\n",
    "            plt.xlabel('Month')\n",
    "            plt.xlim([0.75,12.25])\n",
    "            ax[f'{var}_ann'].set_xticks(range(1,13))\n",
    "            ax[f'{var}_ann'].set_xticklabels(['J','F','M','A','M','J','J','A','S','O','N','D'])\n",
    "\n",
    "        # loop through each runid and load variable if available\n",
    "        rpt=False\n",
    "        for iR,rR in enumerate(runids):\n",
    "            if rR == highlight:\n",
    "                lcol='k'\n",
    "                lwidth=3\n",
    "            else:\n",
    "                lcol=f'C{iR}'\n",
    "                lwidth=2\n",
    "            if rR == repeat and rpt:\n",
    "                RPT=True\n",
    "                # axis range over which to repeat\n",
    "                xax=ax[list(fig.keys())[0]].get_xlim()\n",
    "            else:\n",
    "                RPT=False\n",
    "            rfile=os.path.join(paths[iR],f'{rR}_{var}_timeseries.nc')\n",
    "            if os.path.isfile(rfile):\n",
    "                with xr.open_dataset(rfile,decode_times='False') as ds0:\n",
    "                    skip=False\n",
    "                    if yRange is None or RPT:\n",
    "                        ds=ds0.copy()\n",
    "                        if RPT:\n",
    "                            # repeat time series as many times as necessary\n",
    "                            yrs=-year0[iR]+np.array([yY.year for yY in ds0['time'].values])\n",
    "                            mxyr=np.nanmax(yrs); lnyr=mxyr-np.nanmin(yrs); dyr=xax[1]-mxyr\n",
    "                            if dyr > 0:\n",
    "                                nrpt=int(np.ceil(dyr/lnyr))\n",
    "                                # extend dataset as many times as necessary\n",
    "                                datasets=[ds]\n",
    "                                mxyr=np.nanmax(ds['year'].values)\n",
    "                                for irpt in range(nrpt):\n",
    "                                    datasets.append(ds0.copy())\n",
    "                                    # increment date\n",
    "                                    nums=date2num(datasets[-1]['time'].values,units='days since 0001-01-01')\n",
    "                                    dates=num2date(nums+365.*(irpt+1)*mxyr,units='days since 0001-01-01')\n",
    "                                    datasets[-1]=datasets[-1].assign_coords(time=dates)\n",
    "                                    datasets[-1]['year'].values=ds0['year'].values+(irpt+1)*mxyr\n",
    "                                ds=xr.concat(datasets,dim='time')\n",
    "                    else:\n",
    "                        yrs=-year0[iR]+np.array([yY.year for yY in ds0['time'].values])\n",
    "                        iT=np.where(np.logical_and(yrs>=yRange[0],yrs<=yRange[1]))[0]\n",
    "                        if len(iT) > 0:\n",
    "                            ds=ds0.isel(time=iT)\n",
    "                        else:\n",
    "                            skip=True\n",
    "                    if not skip:\n",
    "                        for iF,freq in enumerate(freqs2plot):\n",
    "                            # loop through each plotting frequency and add to plot\n",
    "                            # because values are not necessarily ordered in time, drop duplicates\n",
    "                            if freq=='default':\n",
    "                                if not RPT:\n",
    "                                    ax[f'{var}_{freq}'].plot(ds.drop_duplicates(dim='time',keep='last').sortby('time')['year'],\n",
    "                                                            ds.drop_duplicates(dim='time',keep='last').sortby('time')[var],color=lcol,linewidth=lwidth,label=rR,\n",
    "                                                            zorder=np.nanmax([1,1000/len(ds.drop_duplicates(dim='time',keep='last').sortby('time')['year'])]))\n",
    "                                else:\n",
    "                                    ax[f'{var}_{freq}'].plot(ds.drop_duplicates(dim='time',keep='last').sortby('time')['year'],\n",
    "                                                            ds.drop_duplicates(dim='time',keep='last').sortby('time')[var],color=lcol,linewidth=lwidth,\n",
    "                                                            zorder=0)\n",
    "                            else:\n",
    "                                # need to resample to get desired mean value\n",
    "                                if freq.lower() in ['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec']:\n",
    "                                    if resampleType=='min':\n",
    "                                        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time='1ME',skipna=True).min()\n",
    "                                    elif resampleType=='max':\n",
    "                                        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time='1ME',skipna=True).max()\n",
    "                                    else:\n",
    "                                        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time='1ME',skipna=True).mean()\n",
    "                                    # indexes of specific month\n",
    "                                    iM=np.where(np.array(['jan','feb','mar','apr','may','jun','jul','aug','sep','oct','nov','dec'])==freq.lower())[0][0]\n",
    "                                    mnth_idxs=rds.groupby('time.month').groups[iM]\n",
    "                                    # Extract the desired month by selecting the relevant indices\n",
    "                                    rds=rds.isel(time=mnth_idxs)\n",
    "                                else:\n",
    "                                    if resampleType=='min':\n",
    "                                        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time=freq,skipna=True).min()\n",
    "                                    elif resampleType=='max':\n",
    "                                        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time=freq,skipna=True).max()\n",
    "                                    else:\n",
    "                                        rds=ds.drop_duplicates(dim='time',keep='last').sortby('time').resample(time=freq,skipna=True).mean()\n",
    "                                if not RPT:\n",
    "                                    ax[f'{var}_{freq}'].plot(rds['year'].values,rds[var],color=lcol,linewidth=lwidth,label=rR,zorder=np.nanmax([1,1000/len(rds['year'].values)]))\n",
    "                                else:\n",
    "                                    ax[f'{var}_{freq}'].plot(rds['year'].values,rds[var],color=lcol,linewidth=lwidth,zorder=0)\n",
    "                                rds.close()\n",
    "\n",
    "                        if plotAnnual and not RPT:\n",
    "                            # plot annual cycle, excluding the repeated run\n",
    "                            annualCycle(ds,var,lcol,rR,ax[f'{var}_ann'])\n",
    "            if rR == repeat:\n",
    "                rpt=True\n",
    "        \n",
    "        # add legends and finalize figures\n",
    "        for iA in list(fig.keys()):\n",
    "            ax[iA].legend(loc='center left', bbox_to_anchor=(1, 0.5))\n",
    "            ax[iA].grid(visible=True)\n",
    "            fig[iA].tight_layout()\n",
    "            if RPT and (not plotAnnual or (iA != f'{var}_ann')):\n",
    "                ax[iA].set_xlim(xax)\n",
    "        plt.show()\n",
    "        time.sleep(1)\n",
    "\n",
    "# add bar plot showing timing of each run\n",
    "if plotTiming:\n",
    "    # plot timing\n",
    "    # create figure\n",
    "    fig=plt.figure()\n",
    "    plt.gca().set_xticks(range(len(runids))); xtls=[]\n",
    "    plt.xlim([-0.5,len(runids)-0.5])\n",
    "    plt.grid(visible=True)\n",
    "    plt.ylabel(r'Core Hours [Total Elapsed CPU Time]')\n",
    "    cput=np.full(len(runids),np.nan)\n",
    "    # loop through each run\n",
    "    for iR,rR in enumerate(runids):\n",
    "        rpth=paths[iR].replace('/RTD','')\n",
    "        # find restart path\n",
    "        rstP=findLatestRestart(rpth)\n",
    "        if rstP is not None:\n",
    "            # get timing per node from file in minutes per processor\n",
    "            cput[iR]=timePerNode(os.path.join(rstP,'rs_timing.output'),os.path.join(rstP,'rs_ocean.output'))[1]\n",
    "            # add bar to plot\n",
    "            plt.bar(iR,cput[iR],facecolor=[0.5,0.5,0.5],edgecolor='k')\n",
    "        plt.text(iR,0,rR,fontweight='bold',rotation=90,color='k')\n",
    "    plt.show()\n",
    "    time.sleep(1)\n",
    "\n",
    "    # plot number of grid cells\n",
    "    # create figure\n",
    "    fig=plt.figure()\n",
    "    plt.gca().set_xticks(range(len(runids))); xtls=[]\n",
    "    plt.xlim([-0.5,len(runids)-0.5])\n",
    "    plt.grid(visible=True)\n",
    "    plt.ylabel(r'Number of Ocean Grid Cells (3D)')\n",
    "    nocn=np.full(len(runids),np.nan)\n",
    "    # loop through each run\n",
    "    for iR,rR in enumerate(runids):\n",
    "        rpth=paths[iR].replace('/RTD','')\n",
    "        rfle=sorted(glob.glob(os.path.join(rpth,'mc_*1m_grid_t*')))\n",
    "        if len(rfle) > 0:\n",
    "            nocn[iR]=numGridCells(rfle[-1],'so')\n",
    "            # add bar to plot\n",
    "            plt.bar(iR,nocn[iR],facecolor=[0.5,0.5,0.5],edgecolor='k')\n",
    "        plt.text(iR,0,rR,fontweight='bold',rotation=90)\n",
    "    plt.show()\n",
    "    time.sleep(1)\n",
    "\n",
    "    # plot timing vs number of grid cells\n",
    "    fig=plt.figure()\n",
    "    plt.grid(visible=True)\n",
    "    plt.ylabel(r'Core Hours [Total Elapsed CPU Time]')\n",
    "    plt.xlabel(r'Number of Ocean Grid Cells (3D)')\n",
    "    # add scatter plot\n",
    "    plt.plot(nocn,cput,'.')\n",
    "    xl=plt.xlim(); qtr=0.45*(xl[1]-xl[0])\n",
    "    yl=plt.ylim()\n",
    "    # loop through each run and annotate each scatter point\n",
    "    yp=0; dy=(yl[1]-yl[0])/(2*len(runids))\n",
    "    for iR in np.argsort(cput):\n",
    "        # annotate with runid\n",
    "        yp=np.nanmax([cput[iR],yp+dy])\n",
    "        if nocn[iR] > xl[1]-qtr:\n",
    "            plt.plot([xl[0]+qtr,nocn[iR]],[yp,cput[iR]],color=[0.25,0.25,0.25],linestyle='--')\n",
    "            plt.text(xl[0]+qtr,yp,runids[iR].replace('jgi-dmn-','').replace('e025-',''),ha='right',va='center')\n",
    "        else:\n",
    "            plt.plot([xl[1]-qtr,nocn[iR]],[yp,cput[iR]],color=[0.25,0.25,0.25],linestyle='--')\n",
    "            plt.text(xl[1]-qtr,yp,runids[iR].replace('jgi-dmn-','').replace('e025-',''),ha='left',va='center')\n",
    "    # calculate and plot regression\n",
    "    regr=sp.stats.linregress(nocn,cput)\n",
    "    plt.plot(nocn,regr.slope*nocn+regr.intercept,'k-',label=f\"y={regr.slope:0.2e}*x + {regr.intercept:0.2f}\\n\"+r'r$^2$='+f\"{regr.rvalue**2:0.4f}\")#\\np={regr.pvalue:0.2f}\")\n",
    "    # replot scatter to cover annotations\n",
    "    plt.plot(nocn,cput,'o',markerfacecolor=[0.5,0.5,0.5],markeredgecolor='k')\n",
    "    plt.legend(loc='best',bbox_to_anchor=[0.1,0.5,0.5,0.4])\n",
    "    plt.show()\n",
    "    time.sleep(1)\n",
    "\n",
    "    # Bar plot of file size\n",
    "    fig=plt.figure()\n",
    "    plt.gca().set_xticks(range(len(runids))); xtls=[]\n",
    "    plt.xlim([-0.5,len(runids)-0.5])\n",
    "    plt.grid(visible=True)\n",
    "    plt.ylabel(r'GRID_T File Size [GB]')\n",
    "    fsze=np.full(len(runids),np.nan)\n",
    "    # loop through each run\n",
    "    for iR,rR in enumerate(runids):\n",
    "        rpth=paths[iR].replace('/RTD','')\n",
    "        rfle=sorted(glob.glob(os.path.join(rpth,'mc_*1m_grid_t*')))\n",
    "        if len(rfle) > 0:\n",
    "            fsze[iR]=os.path.getsize(rfle[0])/1e9\n",
    "            # add bar to plot\n",
    "            plt.bar(iR,fsze[iR],facecolor=[0.5,0.5,0.5],edgecolor='k')\n",
    "        plt.text(iR,0,rR,fontweight='bold',rotation=90,color='k')\n",
    "    plt.show()\n",
    "    time.sleep(1)\n",
    "\n",
    "    # file size vs number of grid cells\n",
    "    fig=plt.figure()\n",
    "    plt.grid(visible=True)\n",
    "    plt.ylabel(r'GRID_T File Size [GB]')\n",
    "    plt.xlabel(r'Number of Ocean Grid Cells (3D)')\n",
    "    # add scatter plot\n",
    "    plt.plot(nocn,fsze,'.')\n",
    "    xl=plt.xlim(); qtr=0.45*(xl[1]-xl[0])\n",
    "    yl=plt.ylim()\n",
    "    # loop through each run and annotate each scatter point\n",
    "    yp=0; dy=(yl[1]-yl[0])/(2*len(runids))\n",
    "    for iR in np.argsort(fsze):\n",
    "        # annotate with runid\n",
    "        yp=np.nanmax([fsze[iR],yp+dy])\n",
    "        if nocn[iR] > xl[1]-qtr:\n",
    "            plt.plot([xl[0]+qtr,nocn[iR]],[yp,fsze[iR]],color=[0.25,0.25,0.25],linestyle='--')\n",
    "            plt.text(xl[0]+qtr,yp,runids[iR].replace('jgi-dmn-','').replace('e025-',''),ha='right',va='center')\n",
    "        else:\n",
    "            plt.plot([xl[1]-qtr,nocn[iR]],[yp,fsze[iR]],color=[0.25,0.25,0.25],linestyle='--')\n",
    "            plt.text(xl[1]-qtr,yp,runids[iR].replace('jgi-dmn-','').replace('e025-',''),ha='left',va='center')\n",
    "    # calculate and plot regression\n",
    "    regr=sp.stats.linregress(nocn,fsze)\n",
    "    plt.plot(nocn,regr.slope*nocn+regr.intercept,'k-',label=f\"y={regr.slope:0.2e}*x + {regr.intercept:0.2f}\\n\"+r'r$^2$='+f\"{regr.rvalue**2:0.4f}\")#\\np={regr.pvalue:0.2f}\")\n",
    "    # replot scatter to cover annotations\n",
    "    plt.plot(nocn,fsze,'o',markerfacecolor=[0.5,0.5,0.5],markeredgecolor='k')\n",
    "    plt.legend(loc='best',bbox_to_anchor=[0.1,0.5,0.5,0.4])\n",
    "    plt.show()\n",
    "    time.sleep(1)\n",
    "\n"
   ]
