# ====================
# "raw_env_setup_file" 
# ====================
# if runid_env isn't empty, then assume that we are already in some runtime environment
if [[ -n "${runid_env}" ]]; then
    # clean PATH of entries associated with the previous env before adding more
    reset_path_var=""
    for path_entry in $(echo $PATH | sed "s#:# #g"); do
        if [[ "$path_entry" != *"${runid_env}"* ]]; then
            reset_path_var="${reset_path_var} ${path_entry}"
        fi
    done
    # clean trailing whitespaces
    reset_path_var=$(echo $reset_path_var | xargs)
    # reset PATH
    PATH=$( echo $reset_path_var | sed "s# #:#g" )
    export PATH
fi

runid_env=myrun ; export runid_env
WRK_DIR=/path/to/run ; export WRK_DIR
CCRNSRC=/path/to/source/dirs ; export CCRNSRC
HPFX_RUNLOG_DIR=/path/to/runlogs ; export HPFX_RUNLOG_DIR
DIAGJOB_SFX=mydiag_suffix ; export DIAGJOB_SFX
CANESM_CMIP=bool; export CANESM_CMIP
CANESM_DFFSFX=mydiagff_suffix; export CANESM_DFFSFX
CUSTOM_ENV_FILE=${WRK_DIR}/env_setup_file ; export CUSTOM_ENV_FILE

HOSTID=`hostname | cut -d'.' -f1 `
HOSTID=${HOSTID:-`/usr/bin/hostname | cut -d'.' -f1 `}
HOSTID=`echo $HOSTID | sed -e 's/hpcr4-in/ppp4/' -e 's/hpcr3-in/ppp3/' `
export HOSTID
if [ -n "${HOSTID}" ] ; then
  case ${HOSTID} in
         mom*) if [ -s "/fs/xc3lustre1/eccc/crd/." ] ; then
                . $CCRNSRC/CanESM/CCCma_tools/generic/banting_linux_setup_profile
               elif [ -s "/fs/xc4lustre1/eccc/crd/." ] ; then
                . $CCRNSRC/CanESM/CCCma_tools/generic/daley_linux_setup_profile
               fi                                                                                          ;;
         xc3*) . $CCRNSRC/CanESM/CCCma_tools/generic/banting_linux_setup_profile ;;
         xc4*) . $CCRNSRC/CanESM/CCCma_tools/generic/daley_linux_setup_profile ;;
        hpcr3*|cs3*|ppp3*|eccc*-ppp3*) . $CCRNSRC/CanESM/CCCma_tools/generic/ppp3_linux_setup_profile ;;
        hpcr4*|cs4*|ppp4*|eccc*-ppp4*) . $CCRNSRC/CanESM/CCCma_tools/generic/ppp4_linux_setup_profile ;;
        sc5*)   . $CCRNSRC/CanNEMO_tmp_src/generic/nemo_underhill_linux_setup_profile ;;
        sc6*)   . $CCRNSRC/CanNEMO_tmp_src/generic/nemo_robert_linux_setup_profile ;;
        hpcr5*|*ppp5*) . $CCRNSRC/CanNEMO_tmp_src/generic/nemo_ppp5_linux_setup_profile ;;
        hpcr6*|*ppp6*) . $CCRNSRC/CanNEMO_tmp_src/generic/nemo_ppp6_linux_setup_profile ;;

            *) echo "env_setup_file: Sorry, no standard setup support yet for hostname --> $HOSTID  <-- !" ;;
  esac
else
  echo "env_setup_file: Sorry, not able to continue !"
  exit 2
fi

# add local experiment bins to the PATH
if ! [[ ":$PATH:" == *":${WRK_DIR}/bin:"* ]]; then
    export PATH="${WRK_DIR}/bin:${PATH}"
fi

# activate python infrastructure environment
if ! which conda >> /dev/null 2>&1 ; then
    # add cccma conda path if there is no conda on the path
    export PATH="${CCCMA_CONDA_PATH}:${PATH}"
fi

# prepend local database to the master database
export DATAPATH_DB="$RUNID_ROOT/datapath_local.db:$DATAPATH_DB"

# set TOPDOG=off by default
export TOPDOG=off
