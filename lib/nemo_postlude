		acclist=''
		for full_path in $found_file; do
		  bname=`basename $full_path|sed 's/\.[0-9][0-9][0-9]$//'`
		  acclist="$acclist $bname"
		 done
		# Ensure all file names are unique
		# Copies will be created when multiple edition numbers exist for the
