    fi # if [ $nemo_rtd -eq 1 ]; then 1215

  echo '####################################################################'
  echo '  DUMPING and DELETING'

  # Optionally dump history files saved on DATAPATH to cfs
  nemo_dump_hist=${nemo_dump_hist:=off}
