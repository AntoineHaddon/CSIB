#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# NEMO postlude
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

  if [ ! -s reorder_list ]; then
cat >reorder_list << 'end_reorder_list'
#!/usr/bin/perl

  # ---Start_submit_ignore_code----

  # Process input file which must contain valid file names, one name per line
  # Only the first white space separated word in each line is used
  while ($flist = shift) {
    open(FLIST,$flist) or die "reorder_list: Cannot open input file $flist\n";
    while (<FLIST>) {
      chomp;
      # Ignore blank lines and comment lines
      next if /^\s*$/;
      next if /^\s*#/;
      # Only the first word on the line is significant
      ($fin) = split;
      # This must be a valid non-empty file
      die "reorder_list: $fin is missing or empty.\n" unless -s $fin;
      $list{$fin} = -s $fin;
    }
  }
  die "reorder_list: No valid file names found.\n" unless defined %list;

  # Sort in ascending order by size and print the reordered list to stdout
  foreach (sort {$list{$a} <=> $list{$b}} keys %list) {
    print "$_\n";
  }

  # ---Stop_submit_ignore_code----

end_reorder_list
  fi

  rtd_staging() {
    # Copy a single rtd file to a local staging directory
    # Usage: rtd_staging local_rtd_file remote_rtd_file
    [ -z "$1" ] && bail "rtd_staging requires a file name as the first arg."
    [ -z "$2" ] && bail "rtd_staging requires a file name as the second arg."
    [ -e $1 ] || bail "rtd_staging: File --> $1 <-- is missing."

    # Do not abort if the copy fails

    # Identify the staging directory
    case $(uname -n|awk -F'.' '{print $1}' -) in
      xc1*|eccc1-ppp1*) # hare or ppp1
            rtd_staging_dir=/space/hall1/work/eccc/crd/ccrn/prod/rtd/nemo_rtd
            ;;
      xc2*|eccc1-ppp2*) # brooks or ppp2
            rtd_staging_dir=/space/hall2/work/eccc/crd/ccrn/prod/rtd/nemo_rtd
            ;;
    esac

    cp $1 $rtd_staging_dir/$2
  }

  parallel_rebuild_rs_hist() {
    # Rebuild a number of NEMO restart and/or/ history file in parallel
    # The following parameters must be defined prior to invoking this function
    #     cn_exp, start_date, stop_date, jpnij, nn_itend, pisces_offline,
    #     nemo_trc, nemo_carbon, nemo_save_hist, nemo_rtd
    # as well as the history file suffix and frequency lists
    #     nemo_hist_file_suffix_list, nemo_hist_file_freq_list

    rebuild_list=""
    declare -i n_rebuild=0

    if [ $nemo_save_hist -eq 1 ] || [ $nemo_rtd -eq 1 ]; then
      # Define the list of history files to rebuild
      for sfx in ${nemo_hist_file_suffix_list}; do
        for freq in ${nemo_hist_file_freq_list}; do
          pfx=${cn_exp}_${freq}_${start_date}_${stop_date}_$sfx
          eval fnpatt=${pfx}_\[0-9\]\[0-9\]\[0-9\]\[0-9\].nc
          found_file=`(ls -1 $fnpatt || : ) 2>/dev/null`
          if [ -n "$found_file" ]; then
            # At least 1 file name matches the current pattern
            # Create a namelist file for use with this rebuild
            # Each file that is rebuilt requires a namelist file
            n_rbnl=$(echo $n_rebuild|awk '{printf "%2.2d",$1}')
            rbnl_file=nam_rebuild$n_rbnl
            echo "&nam_rebuild"           > $rbnl_file
            echo "    filebase='${pfx}'" >> $rbnl_file
            echo "    ndomain=$jpnij"    >> $rbnl_file
            echo "/"                     >> $rbnl_file
            echo "rebuild namelist:"
            cat $rbnl_file
            # Increment file count and append to the rebuild list
            n_rebuild+=1
            rebuild_list+=" $pfx"
          fi
        done
      done
    fi

    # Keep track of history files in a separate list
    hist_file_list=$rebuild_list

    # Add relevant restarts to rebuild_list
    end_step=$(echo $nn_itend | awk '{printf "%8.8d",$1}')
    if [ $pisces_offline -eq 0 ]; then
        pfx=${cn_exp}_${end_step}_restart
        n_rbnl=$(echo $n_rebuild|awk '{printf "%2.2d",$1}')
        rbnl_file=nam_rebuild$n_rbnl
        echo "&nam_rebuild"           > $rbnl_file
        echo "    filebase='${pfx}'" >> $rbnl_file
        echo "    ndomain=$jpnij"    >> $rbnl_file
        echo "/"                     >> $rbnl_file
        rebuild_list+=" $pfx"
        n_rebuild+=1

        pfx=${cn_exp}_${end_step}_restart_ice
        n_rbnl=$(echo $n_rebuild|awk '{printf "%2.2d",$1}')
        rbnl_file=nam_rebuild$n_rbnl
        echo "&nam_rebuild"           > $rbnl_file
        echo "    filebase='${pfx}'" >> $rbnl_file
        echo "    ndomain=$jpnij"    >> $rbnl_file
        echo "/"                     >> $rbnl_file
        rebuild_list+=" $pfx"
        n_rebuild+=1
    fi
    if [ $nemo_trc -eq 1 ] || [ $nemo_carbon -eq 1 ]; then
        pfx=${cn_exp}_${end_step}_restart_trc
        n_rbnl=$(echo $n_rebuild|awk '{printf "%2.2d",$1}')
        rbnl_file=nam_rebuild$n_rbnl
        echo "&nam_rebuild"           > $rbnl_file
        echo "    filebase='${pfx}'" >> $rbnl_file
        echo "    ndomain=$jpnij"    >> $rbnl_file
        echo "/"                     >> $rbnl_file
        rebuild_list+=" $pfx"
        n_rebuild+=1
    fi

    # Add the mesh_mask file created by the model, if present
    if [ -s mesh_mask_0000.nc ]; then
        rm -f rs_mesh_mask.nc
        pfx=mesh_mask
        n_rbnl=$(echo $n_rebuild|awk '{printf "%2.2d",$1}')
        rbnl_file=nam_rebuild$n_rbnl
        echo "&nam_rebuild"           > $rbnl_file
        echo "    filebase='${pfx}'" >> $rbnl_file
        echo "    ndomain=$jpnij"    >> $rbnl_file
        echo "/"                     >> $rbnl_file
        rebuild_list+=" $pfx"
        n_rebuild+=1
    fi

    # Do nothing more if there are no files to rebuild
    [[ $n_rebuild == 0 ]] && return

    # Invoke the parallel rebuild
    export OMP_NUM_THREADS=5
    # The total number for "n" must be <=36 to fit on one node of the XC40
    # This could be tuned, and defitely changed for other machines.
    while [ $(($OMP_NUM_THREADS * $n_rebuild)) -gt 36 ]; do
        OMP_NUM_THREADS=$(($OMP_NUM_THREADS -1))
    done

    # Each file that is rebuilt uses 1 MPI task and OMP_NUM_THREADS OpenMP threads
    # The executable must be accessable at run time and namelist files present in cwd
    [ -s rebuild_nemo_mpi.exe ] || access rebuild_nemo_mpi.exe rebuild_nemo_mpi.exe nocp=no na
    [ -s rebuild_nemo_mpi.exe ] || bail "Unable to access rebuild_nemo_mpi.exe"
    aprun -j 1 -n $n_rebuild -N $n_rebuild -d $OMP_NUM_THREADS rebuild_nemo_mpi.exe

    if [ $nemo_save_hist -eq 1 ]; then
      # Save the global history files htat were just created
      for pfx in ${hist_file_list}; do
        ncout=${pfx}.nc
        [ -s $ncout ] || { echo "$ncout is missing or empty. Ignored"; continue; }
        save $ncout ${uxxx}_$ncout && echo "${uxxx}_$ncout" >> saved_history_FILE_NAMES
      done
    fi

    # Rename mesh_mask.nc if it was created
    # This file will be added to the restart archive if it exists
    [ -s mesh_mask.nc ] && mv mesh_mask.nc rs_mesh_mask.nc

    # Clean up
    if [ -s mesh_mask_0000.nc ]; then
      rm mesh_mask_[0-9][0-9][0-9].nc
    fi
  }

  #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
  #=#=#=#     Post processing     #=#=#=#
  #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

  echo " "
  echo "#################### NEMO post processing #################"

  # bail_prefix is used in the error exit function bail (defined in nemo_prelude)
  bail_prefix="nemo postlude"

  # The job name
  cn_exp=$runid

  # Part of the input ocean restart name (default restart)
  # The input ocean restart file name will be ${cn_ocerst_in}_MMMM.nc
  # where MMMM is the MPI task number (I4.4)
  cn_ocerst_in="restart"

  # Part of output ocean restart name (default restart)
  # The output ocean restart file name will be ${cn_exp}_NNNNNNNN_${cn_ocerst_out}_MMMM.nc
  # where NNNNNNNN is the time step (I8.8) and MMMM is the MPI task number (I4.4)
  cn_ocerst_out="restart"

  # Part of input ice restart name (default restart_ice_in)
  # The input ice restart file name will be ${cn_icerst_in}_MMMM.nc
  # where MMMM is the MPI task number (I4.4)
  cn_icerst_in="restart_ice_in"

  # Part of output ice restart name (default restart_ice)
  # The output ice restart file name will be ${cn_exp}_NNNNNNNN_${cn_icerst_out}_NNNN.nc
  # where NNNNNNNN is the time step (I8.8) and MMMM is the MPI task number (I4.4)
  cn_icerst_out="restart_ice"

  # Part of input pisces restart name (default restart_trc_in)
  # The input pisces restart file name will be ${cn_trcrst_in}_MMMM.nc
  # where MMMM is the MPI task number (I4.4)
  cn_trcrst_in="restart_trc_in"

  # Part of output pisces restart name (default restart_trc)
  # The output pisces restart file name will be ${cn_exp}_NNNNNNNN_${cn_trcrst_out}_NNNN.nc
  # where NNNNNNNN is the time step (I8.8) and MMMM is the MPI task number (I4.4)
  cn_trcrst_out="restart_trc"

  # Determine the year and month of the current restart to be saved below
  # This restart will be for the last month of the current run
  nemo_rsout_year=$nemo_stop_year
  nemo_rsout_mon=$nemo_stop_mon

  # Determine the number of days in the last month of the previous restart
  case $nemo_rsout_mon in
    1|01) nemo_rsout_day=31 ;;
    2|02) nemo_rsout_day=28 ;;
    3|03) nemo_rsout_day=31 ;;
    4|04) nemo_rsout_day=30 ;;
    5|05) nemo_rsout_day=31 ;;
    6|06) nemo_rsout_day=30 ;;
    7|07) nemo_rsout_day=31 ;;
    8|08) nemo_rsout_day=31 ;;
    9|09) nemo_rsout_day=30 ;;
      10) nemo_rsout_day=31 ;;
      11) nemo_rsout_day=30 ;;
      12) nemo_rsout_day=31 ;;
       *) bail "nemo_rsout_mon=$nemo_rsout_mon is out of range" ;;
  esac

  # After the job has run remove input restart files (if any)
  [ -s input_ocn_restart_file_names ] && cat input_ocn_restart_file_names | xargs rm -f
  [ -s input_ice_restart_file_names ] && cat input_ice_restart_file_names | xargs rm -f
  [ -s input_trc_restart_file_names ] && cat input_trc_restart_file_names | xargs rm -f

  ######## Save history and restart files #######

  # do_nemo_run needs to be looked at
  do_nemo_run=${do_nemo_run:-on}
  ToF do_nemo_run

  # Should we save the NEMO restart to DATAPATH
  nemo_save_rs=${nemo_save_rs:-on}
  ToF nemo_save_rs

  # If nemo_rtd is true then execute the nemo run time diagnostics
  # If nemo_rtd is true then history files need to be rebuilt
  nemo_rtd=${nemo_rtd:=on}
  ToF nemo_rtd

  # tarlist contains a list of additional files to add to the restart archive
  tarlist=''

  if [ $do_nemo_run -eq 1 ]; then

    # The file saved_history_file_names will contain a list of saved files to be archived.
    # Since "save" will blindly transpose all file name characters to lower case before
    # saving to DATAPATH, we must keep track of the case of these files in some way.
    # The file saved_history_FILE_NAMES will contain the same list of file names that
    # saved_history_file_names contains but it will preserve case. (Large pita)
    rm -f saved_history_file_names
    touch saved_history_file_names
    rm -f saved_history_FILE_NAMES
    touch saved_history_FILE_NAMES

    # History file suffix and frequency lists
    nemo_hist_file_suffix_list=${nemo_hist_file_suffix_list:="icemod grid_T grid_U grid_V grid_W ptrc_T diad_T"}
    nemo_hist_file_freq_list=${nemo_hist_file_freq_list:="1y 1m 5d 1d 3h 1h"}

    nemo_save_hist=${nemo_save_hist:-on}
    ToF nemo_save_hist

    # Rebuild restart and history files and optionally save history files
    parallel_rebuild_rs_hist || bail "Unable to rebuild NEMO files"

    if [ -s saved_history_FILE_NAMES ]; then
      # Once files have been rebuilt and saved to DATAPATH create a file that is
      # equivalent to the file saved_history_FILE_NAMES except that all file names
      # contained therein are lower case.
      rm -f saved_history_file_names
      cat saved_history_FILE_NAMES | tr '[A-Z]' '[a-z]' > saved_history_file_names
    fi

    #=#=#=# Save the current restart files.

    nemo_rebuild_rs=${nemo_rebuild_rs:-off}
    ToF nemo_rebuild_rs

    if [ $nemo_save_rs -eq 1 ]; then
      # tar up the current restarts and save them to DATAPATH

      # Format nn_itend for use in identifying the restart file names
      end_step=$(echo $nn_itend | awk '{printf "%8.8d",$1}')

      eval ofnpatt=${cn_exp}_${end_step}_${cn_ocerst_out}.nc
      found_rs=`(ls -1 $ofnpatt || : ) 2>/dev/null`
      if [ -z "$found_rs" ]; then
        # No ocean restart files exist
        bail "Attempting to save restarts but no ocean restart files exist. Looking for $ofnpatt"
      fi

      if [ $nemo_trc -eq 1 ] || [ $nemo_carbon -eq 1 ]; then
        # Deal with Pisces restarts
        eval pfnpatt=${cn_exp}_${end_step}_${cn_trcrst_out}.nc
        found_rs=`(ls -1 $pfnpatt || : ) 2>/dev/null`
        if [ -z "$found_rs" ]; then
          # No pisces restart files exist
          bail "Attempting to save restarts but no pisces restart files exist. Looking for $pfnpatt"
        fi
      else
        pfnpatt=''
      fi

      if [ $with_ice -eq 1 ]; then
        if [ $nn_ice -eq 4 ]; then
          # The ice model is CICE
          # ifnpatt must contain the value of the CICE variable pointer_file as well as ice restart file names
          # nemo_cice_pointer_file is the value of the parameter pointer_file in the CICE namelist setup_nml
          # and is initialized as "ice.restart_file" in CICE source code
          nemo_cice_pointer_file=${nemo_cice_pointer_file:=ice.restart_file}
          [ ! -s "$nemo_cice_pointer_file" ] && bail "CICE pointer file $nemo_cice_pointer_file is missinmg or empty"
          ifnpatt=`cat $nemo_cice_pointer_file | xargs`
          [ -z `echo $ifnpatt|sed 's/ *//g'` ] && bail "Problem reading CICE restart pointer file $nemo_cice_pointer_file"
          # Include the CICE pointer file name as well as the restart file names
          ifnpatt="$ifnpatt $nemo_cice_pointer_file"
        else
          # Anything but CICE
          eval ifnpatt=${cn_exp}_${end_step}_${cn_icerst_out}.nc
          found_rs=`(ls -1 $ifnpatt || : ) 2>/dev/null`
          if [ -z "$found_rs" ]; then
            # No ice restart files exist
            bail "Attempting to save restarts but no ice restart files exist. Looking for $ifnpatt"
          fi
        fi
      else
        ifnpatt=''
      fi

      # tarlist contains a list of additional files to add to the restart archive
      tarlist=''

      # Create copies of the namelists used and include them in the tar file
      cp -f namelist rs_namelist || :
      [ -s rs_namelist ] && tarlist="$tarlist rs_namelist"
      cp -f namelist_top    rs_namelist_top    || :
      [ -s rs_namelist_top ]     && tarlist="$tarlist rs_namelist_top"

      case $nn_ice in
        0) ;; # no ice boundary condition
        1) ;; # use observed ice cover
        2) # LIM2 ice-model
           cp -f namelist_ice rs_namelist_ice || :
           [ -s rs_namelist_ice ] && tarlist="$tarlist rs_namelist_ice"
           ;;
        3) # LIM3 ice-model
           cp -f namelist_ice rs_namelist_ice || :
           [ -s rs_namelist_ice ] && tarlist="$tarlist rs_namelist_ice"
           ;;
        4) # CICE ice-model
           cp -f ice_in rs_ice_in || :
           [ -s rs_ice_in ] && tarlist="$tarlist rs_ice_in"
           ;;
        *) bail "Invalid value for nn_ice = $nn_ice" ;;
      esac

      if [ $nemo_trc -eq 1 ] || [ $nemo_carbon -eq 1 ];
	cp -f namelist_top    rs_namelist_top    || :
	[ -s rs_namelist_top ]     && tarlist="$tarlist rs_namelist_top"
      fi

      if [ $nemo_carbon -eq 1 ]; then
	cp -f namelist_pisces rs_namelist_pisces || :
	[ -s rs_namelist_pisces ]  && tarlist="$tarlist rs_namelist_pisces"

        if [ $nemo_cmoc -eq 1 ]; then
	  cp -f namelist_cmoc rs_namelist_cmoc || :
	  if [ -s rs_namelist_cmoc ]; then
            chmod u+rw rs_namelist_cmoc
            tarlist="$tarlist rs_namelist_cmoc"
          fi
        fi
      fi

      # Save a copy of the executable that was just run to the restart archive
      cp -f nemo.exe rs_nemo_exec || :
      [ -s rs_nemo_exec ] && tarlist="$tarlist rs_nemo_exec"

      # Add a file containing the time step
      cp -f time.step rs_time.step || :
      [ -s rs_time.step ] && tarlist="$tarlist rs_time.step"

      # Add ocean output and timing info
      cp -f ocean.output rs_ocean.output || :
      [ -s rs_ocean.output ] && tarlist="$tarlist rs_ocean.output"

      cp -f timing.output rs_timing.output || :
      [ -s rs_timing.output ] && tarlist="$tarlist rs_timing.output"

      cp -f saved_history_file_names rs_saved_history_file_names || :
      [ -s rs_saved_history_file_names ] && tarlist="$tarlist rs_saved_history_file_names"

      cp -f xnemo_access_log rs_xnemo_access_log || :
      [ -s rs_xnemo_access_log ] && tarlist="$tarlist rs_xnemo_access_log"

      cp -f nemo_prelude rs_nemo_prelude || :
      [ -s rs_nemo_prelude ] && tarlist="$tarlist rs_nemo_prelude"

      cp -f nemo_postlude rs_nemo_postlude || :
      [ -s rs_nemo_postlude ] && tarlist="$tarlist rs_nemo_postlude"

      [ -s rs_mesh_mask.nc ] && tarlist="$tarlist rs_mesh_mask.nc"

    fi  # if [ $nemo_save_rs -eq 1 ]; then

    # Echo ocean output to stdout, if requested
    nemo_write_stdout=on
    ToF nemo_write_stdout
    if [ $nemo_write_stdout -eq 1 ]; then
      if [ -s ocean.output ]; then
        echo " "
        echo "########################## ocean output ##########################"
        echo " "
        cat ocean.output
      fi
    fi

  else
    # Make sure we have the most recent restart archive name, even if do_nemo_run=off.
    rs_out=${uxxx}_${cn_exp}_${stop_date}_restart.tar
    # Make sure nemo_save_hist is defined
    nemo_save_hist=on
    ToF nemo_save_hist
  fi

  ######## Run time diagnostics #######

  pisces_offline=${pisces_offline:=off}
  ToF pisces_offline

  nemo_new_rtd=${nemo_new_rtd:=off}
  ToF nemo_new_rtd
  [ ${first_job_in_run:-0} -eq 0 ] && nemo_new_rtd=0

  # rtd_file_list will contain a list of rtd associated files to be added
  # to the nemo restart tarball
  rtd_file_list=''

  if [ $nemo_rtd -eq 1 ]; then

    # Specify the location of some NCO tools
    # These are required for manipulation of the netcdf files
    NCOBIN=$CCRNOPT/package/bin
    NCATTED="$NCOBIN/ncatted"
        
    # File containing grid information
    orca_grid_info=nemo3.4.1_orca1_mesh_mask_ngr.nc
    [ -s orca_mesh_mask ] || access orca_mesh_mask $orca_grid_info 

    # Invoke the nemo run time diagnostics
    if [ $pisces_offline -eq 0 ]; then

        # This currently requires certain yearly history files, which may or may not have
        # been created above. Verify that they exist by attempting to access them
        # These files could be modified so create local copies with write access

        if [ $nemo_save_hist -eq 1 ]; then
          # Attempt to access these history files
          rtd_hist1="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_grid_t.nc"
          rtd_hist2="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_grid_u.nc"
          rtd_hist3="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_grid_v.nc"
          rtd_hist4="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_grid_w.nc"
          access grid_t $rtd_hist1 || bail "NEMO rdt cannot access $rtd_hist1"
          access grid_u $rtd_hist2 || bail "NEMO rdt cannot access $rtd_hist2"
          access grid_v $rtd_hist3 || bail "NEMO rdt cannot access $rtd_hist3"
          access grid_w $rtd_hist4 || bail "NEMO rdt cannot access $rtd_hist4"
        else
          # History files are not saved but they should exist in the cwd
          # Note the capitol T,U,V,W in these names
          rtd_hist1="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_grid_T.nc"
          rtd_hist2="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_grid_U.nc"
          rtd_hist3="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_grid_V.nc"
          rtd_hist4="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_grid_W.nc"
          [ -s $rtd_hist1 ] || bail "NEMO rdt: $rtd_hist1 is missing or empty"
          [ -s $rtd_hist2 ] || bail "NEMO rdt: $rtd_hist2 is missing or empty"
          [ -s $rtd_hist3 ] || bail "NEMO rdt: $rtd_hist3 is missing or empty"
          [ -s $rtd_hist4 ] || bail "NEMO rdt: $rtd_hist4 is missing or empty"
          cp -f $rtd_hist1 grid_t
          cp -f $rtd_hist2 grid_u
          cp -f $rtd_hist3 grid_v
          cp -f $rtd_hist4 grid_w
        fi

        # The user must define year_rtdiag_start
        year_rtdiag_start=${nemo_rtdiag_start_year:=''}
        [ -z "$year_rtdiag_start" ] &&
          bail "Run time diagnostics was requested but year_rtdiag_start is not defined."

        # Access the rtd executable
        physical_rtd_exe=${nemo_physical_rtd_exe:=nemo_physical_rtd_xc40_test-v2_exe}
        [ -z "$physical_rtd_exe" ] && bail "physical_rtd_exe is not defined."
        [ -s "$physical_rtd_exe" ] || access $physical_rtd_exe $physical_rtd_exe nocp=no
        chmod u+x $physical_rtd_exe

        cp -f $physical_rtd_exe rs_$physical_rtd_exe || :
        [ -s rs_$physical_rtd_exe ] && rtd_file_list="$rtd_file_list rs_$physical_rtd_exe"

        # Create run time diagnostics for physical ocean variables
        [ $nemo_new_rtd -eq 1 ] && rm -f rs_nemo_physical_rtd.nc
        if [ -s rs_nemo_physical_rtd.nc ]; then
          # Append to the rtd file found in the restart
          cp -f rs_nemo_physical_rtd.nc nemo_physical_rtd.nc
          rm -f rs_nemo_physical_rtd.nc
          chmod u+rw nemo_physical_rtd.nc
          $physical_rtd_exe $stop_year $start_mon
        else
          # Create a new rtd file
          $physical_rtd_exe $stop_year $start_mon
          [ -s nemo_physical_rtd.nc ] && [ -x $NCATTED ] && $NCATTED -O -a RTD_version,global,a,c,"${physical_rtd_exe}" nemo_physical_rtd.nc
        fi

        cp -f nemo_physical_rtd.nc rs_nemo_physical_rtd.nc || :
        [ -s rs_nemo_physical_rtd.nc ] && rtd_file_list="$rtd_file_list rs_nemo_physical_rtd.nc"

        # Copy the new physical rtd file to a staging directory
        [ -s nemo_physical_rtd.nc ] && rtd_staging nemo_physical_rtd.nc sc_${runid}_nemo_physical_rtd.nc

        # Move deleting to the delete part
        # delete RTD files from 2 years ago from RUNPATH (if we are 2+ years from rtd starting).
        # yearcm2=`expr ${current_year} - 2 | awk  '{printf "%04d",$1}'`        
        # 
        # if [ ${yearcm2} -ge ${year_rtdiag_start} ] ; then
        #     access  old_rtd  na  nocp  sc_${runid}_${year_rtdiag_start}_${yearcm2}_nemo_physical_rtd.nc
        #     delete  old_rtd na 
        # fi
        if [ $nn_ice -ne 0 ]; then
          # Also generate ICE run time diagnostics

          if [ $nemo_save_hist -eq 1 ]; then
            # Access additional annual history files containing PISCES related variables
            rtd_hist7="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_icemod.nc"
            access icemod $rtd_hist7 || bail "NEMO rdt cannot access $rtd_hist7"
          else
            rtd_hist7="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_icemod.nc"
            [ -s $rtd_hist7 ] || bail "NEMO rdt: $rtd_hist7 is missing or empty"
            cp -f $rtd_hist7 icemod
          fi

          # Access the rtd executable
          ice_rtd_exe=${nemo_ice_rtd_exe:=nemo_ice_rtd_xc40_test-v2_exe}
          [ -z "$ice_rtd_exe" ] && bail "ice_rtd_exe is not defined."
          [ -s "$ice_rtd_exe" ] || access $ice_rtd_exe $ice_rtd_exe nocp=no
          chmod u+x $ice_rtd_exe

          cp -f $ice_rtd_exe rs_$ice_rtd_exe || :
          [ -s rs_$ice_rtd_exe ] && rtd_file_list="$rtd_file_list rs_$ice_rtd_exe"

          # Create run time diagnostics for ice variables
          [ $nemo_new_rtd -eq 1 ] && rm -f rs_nemo_ice_rtd.nc
          if [ -s rs_nemo_ice_rtd.nc ]; then
            # Append to the rtd file found in the restart
            cp -f rs_nemo_ice_rtd.nc nemo_ice_rtd.nc
            rm -f rs_nemo_ice_rtd.nc
            chmod u+rw nemo_ice_rtd.nc
            $ice_rtd_exe $stop_year $start_mon
          else
            # Create a new rtd file
            $ice_rtd_exe $stop_year $start_mon
            [ -s nemo_ice_rtd.nc ] && [ -x $NCATTED ] && $NCATTED -O -a RTD_version,global,a,c,"${ice_rtd_exe}" nemo_ice_rtd.nc
          fi

          cp -f nemo_ice_rtd.nc rs_nemo_ice_rtd.nc || :
          [ -s rs_nemo_ice_rtd.nc ] && rtd_file_list="$rtd_file_list rs_nemo_ice_rtd.nc"

          # Copy the new carbon rtd file to Victoria
          [ -s nemo_ice_rtd.nc ] && rtd_staging nemo_ice_rtd.nc sc_${runid}_nemo_ice_rtd.nc

          # delete RTD files from 2 years ago from RUNPATH (if we are 2+ years from rtd starting).
          #if [ ${yearcm2} -ge ${year_rtdiag_start} ] ; then
          #  access  old_rtd  na  nocp  sc_${runid}_${year_rtdiag_start}_${yearcm2}_nemo_ice_rtd.nc
          #  delete  old_rtd na
          #fi
        fi
    fi # if [pisces_offline -eq 0 ]

    if [ $nemo_carbon -eq 1 ]; then
      # Also generate PISCES run time diagnostics

      if [ $nemo_save_hist -eq 1 ]; then
        # Access additional annual history files containing PISCES related variables
        rtd_hist5="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_ptrc_t.nc"
        rtd_hist6="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_diad_t.nc"
        access ptrc_t $rtd_hist5 
        access diad_t $rtd_hist6 
      else
        rtd_hist5="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_ptrc_T.nc"
        rtd_hist6="${uxxx}_${cn_exp}_1m_${start_date}_${stop_date}_diad_T.nc"
        [ -s $rtd_hist5 ] || bail "NEMO rdt: $rtd_hist5 is missing or empty"
        [ -s $rtd_hist6 ] || bail "NEMO rdt: $rtd_hist6 is missing or empty"
        cp -f $rtd_hist5 ptrc_t
        cp -f $rtd_hist6 diad_t
      fi

      # Access the rtd executable
      if [ $nemo_cmoc -eq 1 ]; then
        carbon_rtd_exe=${nemo_carbon_rtd_exe:=nemo_orca1_carbon_rtd_v02c}
      fi
      if [ $nemo_canoe -eq 1 ]; then
        carbon_rtd_exe=${nemo_carbon_rtd_exe:=nemo_carbon-canoe_rtd_v03c_exe}
      fi
      [ -z "$carbon_rtd_exe" ] && bail "carbon_rtd_exe is not defined."
      [ -s "$carbon_rtd_exe" ] || access $carbon_rtd_exe $carbon_rtd_exe nocp=no
      chmod u+x $carbon_rtd_exe

      cp -f $carbon_rtd_exe rs_$carbon_rtd_exe || :
      [ -s rs_$carbon_rtd_exe ] && rtd_file_list="$rtd_file_list rs_$carbon_rtd_exe"

      [ $nemo_new_rtd -eq 1 ] && rm -f rs_nemo_carbon_rtd.nc
      if [ -s rs_nemo_carbon_rtd.nc ]; then
        # Append to the rtd file found in the restart
        cp -f rs_nemo_carbon_rtd.nc nemo_carbon_rtd.nc
        rm -f rs_nemo_carbon_rtd.nc
        chmod u+rw nemo_carbon_rtd.nc
        $carbon_rtd_exe $stop_year $start_mon
      else
        # Create a new rtd file
        $carbon_rtd_exe $stop_year $start_mon
        [ -s nemo_carbon_rtd.nc ] && [ -x $NCATTED ] && $NCATTED -O -a RTD_version,global,a,c,"${carbon_rtd_exe}" nemo_carbon_rtd.nc
      fi

      cp -f nemo_carbon_rtd.nc rs_nemo_carbon_rtd.nc || :
      [ -s rs_nemo_carbon_rtd.nc ] && rtd_file_list="$rtd_file_list rs_nemo_carbon_rtd.nc"

      # Copy the new carbon rtd file to Victoria
      [ -s nemo_carbon_rtd.nc ] && rtd_staging nemo_carbon_rtd.nc sc_${runid}_nemo_carbon_rtd.nc

    fi

    # Clean up
    release grid_t
    release grid_u
    release grid_v
    release grid_w
    release icemod
    if [ $nemo_carbon -eq 1 ]; then
      # PISCES related files
      release ptrc_t
      release diad_t
      release orca_mesh_mask
    fi
    
  fi # if [ $nemo_rtd -eq 1 ]; then 1215

  ########## Save the NEMO restart ##########

  if [ $do_nemo_run -eq 1 -a $nemo_save_rs -eq 1 ]; then
    # Save the restart file here so that rtd files may be included
    rm -f NEXT_RESTART_ARC
    tar cf NEXT_RESTART_ARC $tarlist $rtd_file_list $ofnpatt $ifnpatt $pfnpatt ||
      bail "Unable to create restart archive"
    if [ -n "$model" ]; then
      # Assume we are running from gcmjcl
      rs_out=${model}nemors.tar
    else
      rs_out=${uxxx}_${cn_exp}_${stop_date}_restart.tar
    fi
    save NEXT_RESTART_ARC $rs_out
    release NEXT_RESTART_ARC
  fi

  echo '####################################################################'
  echo '  DUMPING and DELETING'

  # Optionally dump history files saved on DATAPATH to cfs
  nemo_dump_hist=${nemo_dump_hist:=off}
  ToF nemo_dump_hist

  # Optionally dump restart archives saved on DATAPATH to cfs
  nemo_dump_rs=${nemo_dump_rs:=off}
  ToF nemo_dump_rs

  # Optionally delete history files saved on DATAPATH.
  nemo_del_hist=${nemo_del_hist:=off}
  ToF nemo_del_hist

  # If nemo_del_rs=on, then delete the previous restart tar archive from DATAPATH.
  nemo_del_rs=${nemo_del_rs:=off}
  ToF nemo_del_rs
 
  nemo_ann_cat=${nemo_ann_cat:=off}
  ToF nemo_ann_cat

  if [ -n "$month_counter" -a -n "$months" ]; then
    # months and month_counter are defined
    # These variables are define when running in gcmjcl mode
    # Assume month_counter counts down from the value of months to 1
    if [ $months -gt 1 ]; then
      if [ $month_counter -eq $months ]; then
        # This should be the first month of the current submission job
        first_month_in_curr_job=1
        last_month_in_curr_job=0
      elif [ $month_counter -eq 1 ]; then
        # This should be the last month of the current submission job
        first_month_in_curr_job=0
        last_month_in_curr_job=1
      else
        first_month_in_curr_job=0
        last_month_in_curr_job=0
      fi
    else
      # months must be 1 otherwise
      first_month_in_curr_job=1
      last_month_in_curr_job=1
    fi
  else
    # months and month_counter are not defined. Set first/last to False
    first_month_in_curr_job=0
    last_month_in_curr_job=0
  fi

  # nemo_dump_other flags dumping other (non-nemo) files
  # but only when running in gcmjcl mode
  nemo_dump_other=${nemo_dump_other:=on}
  ToF nemo_dump_other

  # nemo_del_other flags deleting other (non-nemo) files
  # but only when running in gcmjcl mode
  nemo_del_other=${nemo_del_other:=off}
  ToF nemo_del_other

  # nemo_other_hist_suffix_list will contain a list of other (non-nemo) history file suffixes
  # that may be dumped and deleted when in gcmjcl mode (e.g. gs ss cplhist.nc)
  nemo_other_hist_suffix_list=${nemo_other_hist_suffix_list:=''}

  # nemo_other_rs_suffix_list will contain a list of other (non-nemo) restart file suffixes
  # that may be dumped and deleted when in gcmjcl mode (e.g. rs cplrs.nc an ab cpl.exe)
  nemo_other_rs_suffix_list=${nemo_other_rs_suffix_list:=''}

  # IF any dumps or deletes
  if [ $nemo_dump_hist -eq 1 -o $nemo_dump_rs -eq 1 -o $nemo_del_hist -eq 1 -o $nemo_del_rs -eq 1 ]; then
    # If nemo_ann_cat=on, only dump/delete in December. Else do it every step.
    if [ $nemo_ann_cat -eq 1 -a $stop_mon -eq 12 ] || [ $nemo_ann_cat -ne 1 ]; then
      if [ $nemo_dump_hist -eq 1 -o $nemo_dump_rs -eq 1 ]; then
        # The user can redefine nemo_dump_hist_freq_list and nemo_dump_hist_suffix_list
        # to only dump a subset of the history files
        nemo_dump_hist_freq_list=${nemo_dump_hist_freq_list:='1y 1m 1d 5d'}
        nemo_dump_hist_suffix_list=${nemo_dump_hist_suffix_list:='icemod grid_t grid_u grid_v grid_w ptrc_t diad_t'}

        # The user can redefine nemo_dump_rs_month_list. Restarts will
        # only be dumped for those months listed in nemo_dump_rs_month_list.
        nemo_dump_rs_month_list='01 02 03 04 05 06 07 08 09 10 11 12'

	# Keep track of history files to dump in hist_file_dump_list
	hist_file_dump_list=hist_file_dump_list_$$
	rm -f $hist_file_dump_list
	touch $hist_file_dump_list

	# For the history files
        echo '###### hist file dumping ################'

        if [ $nemo_dump_hist -eq 1 ]; then
	  if [ $nemo_save_hist -ne 1 -a $do_nemo_run -eq 1 ]; then
	    bail "Dumping for history files was requested but nemo_save_hist = off"
	  fi

	  for freq in $nemo_dump_hist_freq_list; do
	    for sfx in $nemo_dump_hist_suffix_list; do
	      if [ $nemo_ann_cat -eq 1 ]; then
		pfx="${uxxx}_${cn_exp}_${freq}_${stop_year}????_${stop_year}????_$sfx"
	      else
		pfx="${uxxx}_${cn_exp}_${freq}_${stop_year}${start_mon}01_${stop_year}${stop_mon}${stop_day}_$sfx"
	      fi
	      eval fnpatt=${pfx}.nc.\[0-9\]\[0-9\]\[0-9\]
	      found_file=`(ls -1 $DATAPATH/$fnpatt || : ) 2>/dev/null`
	      if [ -n "$found_file" ]; then
		# At least 1 matching file name was found on DATAPATH
		# Identify a list of unique matching file names to be accessed
		acclist=''
		for full_path in $found_file; do
		  bname=`basename $full_path|sed 's/\.[0-9][0-9][0-9]$//'`
		  acclist="$acclist $bname"
		 done
		# Ensure all file names are unique
		# Copies will be created when multiple edition numbers exist for the
		#same file
		acclist=`echo $acclist|awk '{for(i=1;i<=NF;i++){printf "%s\n",$i}}' |sort -u|xargs`
	        # echo the files to hist_file_dump_list
	        echo ${acclist} >> ${hist_file_dump_list}
	      fi  
	    done
	  done

          if [ -n "$model" ]; then
            # Assume we are running from gcmjcl
            if [ $nemo_dump_other -eq 1 ]; then
              # Dump agcm and/or coupler history files as well
              acclist=''
              for sfx in $nemo_other_hist_suffix_list; do
                acclist="$acclist $model$sfx"
              done
              # filter through lsdat to only get files saved to DATAPATH
              [ -n "$acclist" ] && lsdat -1 --quiet $acclist >> $hist_file_dump_list
            fi
          fi

	  [ -s ${hist_file_dump_list} ] || 
            echo " WARNING: nemo_dump_hist=on but could not create a list of history files to dump"  
	fi

	# For the restart files
        dump_this_rs=0
	if [ $nemo_dump_rs -eq 1 ]; then
          # First determine if this is a month in nemo_dump_rs_month_list
          if [ -n "$model" ]; then
            # Assume we are running from gcmjcl where the nemo rs file name is ${model}nemors.tar
            mmrs=`echo $rs_out | sed 's/^.*_m\([0-9][0-9]\)_nemors\.tar$/\1/'`
          else
            mmrs=`echo $rs_out | sed 's/^.*_\([0-9][0-9]*\)_restart\.tar$/\1/'|cut -c 5-6`
          fi
          for mitem in ${nemo_dump_rs_month_list}; do
            if [ x"${mitem}" = x"${mmrs}" ]; then
              dump_this_rs=1
            fi
          done

	  if [ $dump_this_rs -eq 1 ]; then
	    eval fnpatt=${rs_out}.\[0-9\]\[0-9\]\[0-9\]
	    found_rs_file=`(ls -1 $DATAPATH/$fnpatt || : ) 2>/dev/null`
	    [ -n "$found_rs_file" ] || bail "nemo_dump_rs=on but cannot find ${rs_out} on DATAPATH"
	    echo ${rs_out} >> ${hist_file_dump_list}

            if [ -n "$model" -a $nemo_dump_other -eq 1 ]; then
              # Assume we are running from gcmjcl
              # Dump agcm and/or coupler restart files as well
              acclist=''
              for sfx in $nemo_other_rs_suffix_list; do
                acclist="$acclist $model$sfx"
              done
              if [ -n "$acclist" ]; then
                # filter through lsdat to only get files saved to DATAPATH
                lsdat -1 --quiet $acclist | sed -e 's/[a-zA-Z0-9_.-]*_rs_nmf//g' >> $hist_file_dump_list
              fi
            fi

	    [ -s ${hist_file_dump_list} ] || 
              echo "WARNING: nemo_dump_rs=on but could not create a list of restart files to dump"  
	  fi
	fi

	# For the RTD files
	if [ $nemo_rtd -eq 1 ]; then
            if [ -n "$curr_rtd_tar" ]; then
                echo $curr_rtd_tar >> ${hist_file_dump_list}
            fi
	fi
        
        if [ $nemo_dump_hist -ne 1 -a $dump_this_rs -ne 1 ]; then
            DUMPHIST=''
        else
     	  # Create DUMPHIST variable to pass to cccjob.
	  if [ -s ${hist_file_dump_list} ]; then
	    DUMPHIST="dump_sublist=${hist_file_dump_list}:s"
          else
            DUMPHIST=""
          fi
        fi

      fi  # if [ $nemo_dump_hist -eq 1 -o $nemo_dump_rs -eq 1 ]; then

      ####################################################################
      echo '# DELETE SECTION #'

      # The user can redefine nemo_del_hist_freq_list and nemo_del_hist_suffix_list
      # to only delete a subset of the history files
      nemo_del_hist_freq_list=${nemo_del_hist_freq_list:='1y 1m 1d 5d'}
      nemo_del_hist_suffix_list=${nemo_del_hist_suffix_list:='icemod grid_t grid_u grid_v grid_w ptrc_t diad_t'}

      if [ $nemo_del_hist -eq 1 -o $nemo_del_rs -eq 1 ]; then
	# Keep track of history files to delete in hist_file_del_list
	hist_file_del_list=hist_file_del_list_$$
	rm -f $hist_file_del_list
	touch $hist_file_del_list

	if [ $nemo_del_hist -eq 1 ]; then
	  if [ $nemo_save_hist -ne 1 -a $do_nemo_run -eq 1 ]; then
	    echo "nemo_postlude: ** WW ** Deleting for history files was requested but nemo_save_hist = off"
	  fi

	  for freq in $nemo_del_hist_freq_list; do
	    for sfx in $nemo_del_hist_suffix_list; do
	      if [ $nemo_ann_cat -eq 1 ]; then
		pfx="${uxxx}_${cn_exp}_${freq}_${stop_year}????_${stop_year}????_$sfx"
	      else
		pfx="${uxxx}_${cn_exp}_${freq}_${stop_year}${start_mon}01_${stop_year}${stop_mon}${stop_day}_$sfx"
	      fi
	      eval fnpatt=${pfx}.nc.\[0-9\]\[0-9\]\[0-9\]
	      echo ${fnpatt}
	      found_file=`(ls -1 $DATAPATH/$fnpatt || : ) 2>/dev/null`
	      if [ -n "$found_file" ]; then
		# At least 1 matching file name was found on DATAPATH
		# Identify a list of unique matching file names to be accessed
		acclist=''
		for full_path in $found_file; do
		  bname=`basename $full_path|sed 's/\.[0-9][0-9][0-9]$//'`
		  acclist="$acclist $bname"
		 done
		# Ensure all file names are unique
		# Copies will be created when multiple edition numbers exist for the
		#same file
		acclist=`echo $acclist|awk '{for(i=1;i<=NF;i++){printf "%s\n",$i}}' |sort -u|xargs`
	        # echo the files to hist_file_dump_list
	        echo ${acclist} >> ${hist_file_del_list}
	      fi  
	    done
	  done

          if [ -n "$model" -a $nemo_dump_other -eq 1 ]; then
            # Assume we are running in gcmjcl mode
            # Dump agcm and/or coupler history files as well
            if [ $nemo_del_other -eq 1 ]; then
              acclist=''
              for sfx in $nemo_other_hist_suffix_list; do
                acclist="$acclist $model$sfx"
              done
              # filter through lsdat to only get files saved to DATAPATH
              [ -n "$acclist" ] && lsdat -1 --quiet $acclist >> $hist_file_del_list
            fi
          fi

	  [ -s ${hist_file_del_list} ] || 
             echo "nemo_postlude: ** WW ** nemo_del_hist=on but could not create a list of history files to delete"  
	fi

	if [ $nemo_del_rs -eq 1 ]; then
	  if [ $nemo_ann_cat -eq 1 ]; then
	    # In this case we will want to delete all restart files for the year.
            rsy=`echo $rs_year |awk '{printf "%4.4d",$1}'`
	    rspfx="${uxxx}_${runid}_${rsy}????_restart.tar"
	    eval rsfnpatt=${rspfx}.\[0-9\]\[0-9\]\[0-9\]
	    found_file=`(ls -1 $DATAPATH/$rsfnpatt || : ) 2>/dev/null`
	    if [ -n "$found_file" ]; then
	      # At least 1 matching file name was found on DATAPATH
	      # Identify a list of unique matching file names to be accessed
	      acclist=''
	      for full_path in $found_file; do
		bname=`basename $full_path|sed 's/\.[0-9][0-9][0-9]$//'`
		acclist="$acclist $bname"
	       done
	      # Ensure all file names are unique
	      # Copies will be created when multiple edition numbers exist for the
	      #same file
	      acclist=`echo $acclist|awk '{for(i=1;i<=NF;i++){printf "%s\n",$i}}' |sort -u|xargs`
	      # echo the files to hist_file_dump_list
	      echo ${acclist} >> ${hist_file_del_list}
	    fi  
	  else
            rsfnpatt=${nemo_rs}.\[0-9\]\[0-9\]\[0-9\]
            found_file=`(ls -1 $DATAPATH/${rsfnpatt} || : ) 2>/dev/null`  
            if [ -n "$found_file" ]; then
	      # we just want to delete the last restart
              if [ $first_month_in_curr_job -eq 1 ]; then
                # Do not delete on the first month in the current submission job
                # Rather write this file name into a disk file for use later
                echo $nemo_rs > nemo_rs_first_month
              else
                # Otherwise delete
                echo "${nemo_rs} to be deleted..."
	        echo ${nemo_rs} >> ${hist_file_del_list}
              fi
            fi
            if [ $last_month_in_curr_job -eq 1 ]; then
              # Delete the nemo restart file from the first month after the last month is done
              if [ -s nemo_rs_first_month ]; then
                # Do not consider it an error if this file does not exist
                cat nemo_rs_first_month >> ${hist_file_del_list}
              fi
            fi
	  fi

          if [ -n "$model" -a $nemo_dump_other -eq 1 ]; then
            # Assume we are running in gcmjcl mode
            if [ $last_month_in_curr_job -eq 0 ]; then
              # Delete agcm and/or coupler restart files
              # Do not delete if this is the last month of the current submission job
              acclist=''
              for sfx in $nemo_other_rs_suffix_list; do
                # Never delete certain files
                [ "x$sfx" = 'xan' ] && continue
                [ "x$sfx" = 'xab' ] && continue
                [ "x$sfx" = 'xcpl.exe' ] && continue
                acclist="$acclist $model$sfx"
              done
              if [ -n "$acclist" ]; then
                # filter through lsdat to only get files saved to DATAPATH
                lsdat -1 --quiet $acclist | sed -e 's/[a-zA-Z0-9_.-]*_rs_nmf//g' >> $hist_file_del_list
              fi
            fi
          fi

#	  # For the RTD files
#  	  if [ $nemo_rtd -eq 1 ]; then
#              cat ${rtd_file_del_list} >> ${hist_file_del_list}
#              echo "deleting... `cat ${hist_file_del_list}`"
#	  fi
          
	  [ -s ${hist_file_del_list} ] || 
            echo "nemo_postlude: ** WW ** nemo_del_rs=on but could not create a list of restart files to delete
                  (ignore if this is the first run step)."  
	fi
	
	# Creat DELHIST variable to pass to cccjob.
        if [ -s ${hist_file_del_list} ]; then
	  DELHIST="del_list=${hist_file_del_list}:s"
        else
          DELHIST=""
        fi
      fi

      # make the dump_del_job with the lists from above and run it.
      # Check that at least one of DUMPHIST or DELHIST are defined.
      if [ -n "${DUMPHIST}" -o -n "${DELHIST}" ]; then  
	[ -n "${DUMPHIST}" ] || DUMPHIST=''
	[ -n "${DELHIST}" ]  || DELHIST=''

	# If arclabel is set then the cmcarc filename will be ${arclabel}_${timestamp}_arc.
	# If not set then the cmcarc filename will be ${commonprefix}_${timestamp}_arc
	# where commonprefix is the common prefix of all of the individual file names
	# of all files that are dumped.
	dump_sublist_arclabel=${uxxx}_${cn_exp}_${stop_year}0101_${stop_year}1231

	bemach=$this_mach
	shortermdir=${nemo_shortermdir:=off}
	masterdir=${nemo_masterdir:=on}
	sv=${sv:=off}
	besc=${besc:=on}
	with_lsarc=off

	varlist="dump_sublist_arclabel uxxx runid shortermdir masterdir sv bemach
		 besc with_lsarc"
	rm -f dump_del_defs
	touch dump_del_defs
	for var in $varlist; do
	  eval val=\$$var
	  # If this variable is defined add it to the list
	  [ -n "$val" ] && echo ${var}=\'$val\' >> dump_del_defs
	done

	dump_del_job="dump_del_job_$$"
	cccjob --out=$dump_del_job --job="$DUMPHIST $DELHIST" dump_del_defs
	rm -f dump_del_defs
	CWD=`pwd`

	# Submit the job just created
	if [ -n "$ROUTE_SSH" ]; then
	  $ROUTE_SSH "cd ${CWD} ; rsub $dump_del_job $this_mach"
	else
	  cd ${CWD}
	  rsub $dump_del_job $this_mach
	fi

	# Clean up
	rm -f $dump_del_job
      fi # if [ $nemo_del_hist -eq 1 -o $nemo_del_rs -eq 1 ]

    fi # If nemo_ann_cat=on, only dump/delete in December. Else do it every step.
  fi # IF any dumps or deletes

