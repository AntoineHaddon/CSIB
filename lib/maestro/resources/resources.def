# Where to run
FRONTEND=ppp6
BACKEND=robert

SEQ_DEFAULT_MACHINE=ppp6

# Prefix to job/file names
SEQ_JOBNAME_PREFIX=nemo4-integration-iat2-

# Maestro submission method
SEQ_CONTAINER_METHOD=immediate
#SEQ_CONTAINER_METHOD=submit

# Queues 
BACKEND_XFER_Q=xfer
#FRONTEND_XFER_Q=xxfer
#FRONTEND_XFER_Q=archive
#FRONTEND_XFER_Q=dev_xxfer
FRONTEND_XFER_Q=development
BACKEND_DEFAULT_Q=development
FRONTEND_DEFAULT_Q=development

# NEMO related info, used for looping in maestro and setting resources.
NEMO_LOOP_START=1
NEMO_LOOP_STEP=1
NEMO_LOOP_END=2
NEMO_FREQ_MONTHS=60
NEMO_RUN_START_MONTH=01
NEMO_RUN_START_YEAR=0001
NEMO_NPROC=240
NEMO_RDT=2700
NEMO_WALLCLOCK=180
