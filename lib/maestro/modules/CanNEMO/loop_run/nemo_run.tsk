#!/bin/bash
#=====================================
# This script is adapted for NEMO4.0.3
# (D. Yang, OCT 2020)
#=====================================

# Move in inputs
ln -sf ../input/modfiles/* .

# source run environment to be consistent with the compilation environment
source ${TASK_BIN}/nemo_env ||
    bail "Failed to source the nemo compilation & execution environment! Are the modules available?"

module list

# Run the model
ulimit -s unlimited

# jpnij: number of total local NEMO domains
# xios_jpnij: number of total cores used for XIOS
PMI_NO_FORK=1 mpirun -n $jpnij ./nemo.exe : -n $xios_jpnij ./xios_server.exe

# Verify that run has completed, else exit
time_step=`cat time.step`
if [ ${NEMO_CHUNK_NN_ITEND} -ne ${time_step} ] ; then
    echo "Time step not consistent. Should be: ${NEMO_CHUNK_NN_ITEND}, but is: ${time_step}. The run might have crashed." >&2
    exit 1
fi

# Move files to output
files_out=`find . -type f -name "${cn_exp}_*"`
for ofile in $files_out; do
   mv $ofile ../output/
done

