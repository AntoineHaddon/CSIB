#!/bin/bash
#===========================================================================
#
#  NEMO PRELUDE
#
#  Gets the files required to run the model and sets up namelists etc.
#  Implemented here for running as a maestro task within the CanNEMO suite.
#  
#  Derived from XNEMO/nemo_prelude.
#
#  NCS, May 2017.  
#
#  Enable cmip6_diag option when with_nemo_diag=on (D. YANG, OCT 2017)
#
#  Re-write to source the script - nemo_pre.sh (D. YANG, AUG 2020)
#===========================================================================

# -------------------------------
# Input variables from sequencing
# -------------------------------

  # Total number of time steps in the current job
  nemo_steps_in_job=${NEMO_CHUNK_NITERS}
  nemo_loop_index=${LOOP_INDEX}
  loop_start=${NEMO_LOOP_START}
  chunk_nn_it000=${NEMO_CHUNK_NN_IT000}
  nemo_seq_workbase=${SEQ_WORKBASE}
  nemo_seq_container=${SEQ_CONTAINER}
  chunk_start_date=${NEMO_CHUNK_START_DATE}
  chunk_years=${NEMO_CHUNK_YEARS}

# -------------------------------
# Source shell script nemo_pre.sh
# -------------------------------  

  . ${TASK_BIN}/nemo_pre.sh 
