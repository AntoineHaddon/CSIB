#!/bin/bash
#===================================================
# This task contains two functions:
# * Rebuild the tiled history and restart files.
# * Create the restart tar archive.
#
# Re-write to source the script (D. Yang, Sep 2020) 
#===================================================
#
# -------------------------------
# Input variables from sequencing
# -------------------------------

  seq_exp_home_dir=${SEQ_EXP_HOME}
  chunk_start_date=${NEMO_CHUNK_START_DATE}
  chunk_end_date=${NEMO_CHUNK_END_DATE}
  chunk_nn_itend=${NEMO_CHUNK_NN_ITEND}
  task_work_dir=${TASK_WORK}
  seq_workbase_dir=${SEQ_WORKBASE}
  task_input_dir=../input
  task_input_modfiles_dir=${task_input_dir}/modfiles
  task_output_dir=../output
  # runwrk is the working directory of this iteration of the run loop.
  runwrk=${seq_workbase_dir}/CanNEMO/loop_run/nemo_run+${loop_postproc}/work

# --------------------------------
# Source shell script nemo_post.sh
# --------------------------------

  . ${TASK_BIN}/nemo_post.sh
