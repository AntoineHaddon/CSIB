#!/bin/bash
#=========================================================
# This task contains three functions:
# * CMIP6 nemo diagnostics (offline)
# * Time mean (1d_diaptr -> 1m_diaptr)
# * Generation of time series
# (requires with_nemo_diag = on)
# 
# Re-write to source the script (D. Yang, Sep 2020)
#=========================================================
#
# -------------------------------
# Input variables from sequencing
# -------------------------------

  chunk_start_month=${NEMO_CHUNK_START_MONTH}
  chunk_end_month=${NEMO_CHUNK_END_MONTH}
  chunk_start_year=${NEMO_CHUNK_START_DATE}
  chunk_end_year=${NEMO_CHUNK_END_DATE}
  chunk_start_year=${NEMO_CHUNK_START_YEAR}
  chunk_end_year=${NEMO_CHUNK_END_YEAR}
  chunk_start_date=${NEMO_CHUNK_START_DATE}
  chunk_end_date=${NEMO_CHUNK_END_DATE}

# --------------------------------
# Source shell script nemo_diag.sh
# --------------------------------

  . ${TASK_BIN}/nemo_diag.sh
