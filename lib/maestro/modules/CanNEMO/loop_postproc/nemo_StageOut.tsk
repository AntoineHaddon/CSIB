#!/bin/bash

# Copy the output to the defined storage location
mkdir -p ${OUTPUT_PATH}

if [ $nemo_save_hist -eq 1 ] ; then
    rsync -aL ../input/rebuilt_files/*.nc ${OUTPUT_PATH} --exclude *rtd.nc
fi
#cp ../input/rebuilt_files/*.nc ${OUTPUT_PATH} 
cp ../input/*.tar ${OUTPUT_PATH} 

# Cleanup up temporary run files
if [ "${NEMO_CLEAN_TMP}" == 1 ] ; then

    # clean files as the run progresses, as defined by NEMO_CLEANUP_LAG
    if [ "${loop_postproc}" > ${NEMO_CLEANUP_LAG} ] ; then
        lmlag=$((${loop_postproc}-${NEMO_CLEANUP_LAG}))
        rm -rf ${SEQ_WORKBASE}/CanNEMO/loop_postproc/nemo_StageOut+${lmlag}
        rm -rf ${SEQ_WORKBASE}/CanNEMO/loop_run/nemo_pre+${lmlag}
        rm -rf ${SEQ_WORKBASE}/CanNEMO/loop_run/nemo_run+${lmlag}
        rm -rf ${SEQ_WORKBASE}/CanNEMO/loop_postproc/nemo_post+${lmlag}
    fi

    # clean entire SEQ_WORKBASE directory if we are at the end of the job
    [ ${loop_postproc} == ${NEMO_LOOP_END} ] && cd $TMPDIR && rm -rf ${SEQ_WORKBASE}
fi
