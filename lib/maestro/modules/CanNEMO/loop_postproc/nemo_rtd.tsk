#!/bin/bash
#========================================================================
# This task contains two functions:
# * Run time diagnostics (RTDs) for physical ocean, sea ice and ocean carbon
#   (computaion of RTDs requires nemo_rtd is true)
# * NemoVal plots
#   (production of the NemoVal plots requires nemoval_diag is true)
#
# Re-write to source the script (D. Yang, Sep 2020)
#========================================================================
#
# -------------------------------
# Input variables from sequencing
# -------------------------------
#
  chunk_start_date=${NEMO_CHUNK_START_DATE}
  chunk_end_date=${NEMO_CHUNK_END_DATE}
  chunk_start_year=${NEMO_CHUNK_START_YEAR}
  chunk_end_year=${NEMO_CHUNK_END_YEAR}
  chunk_start_month=${NEMO_CHUNK_START_MONTH}
  run_start_year=${NEMO_RUN_START_YEAR}
  seq_exp_home_dir=${SEQ_EXP_HOME}

# -------------------------------
# Source shell script nemo_pre.sh
# -------------------------------  

  . ${TASK_BIN}/nemo_rtd.sh
