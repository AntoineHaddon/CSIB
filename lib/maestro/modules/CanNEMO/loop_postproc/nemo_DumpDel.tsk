#=======================================
# If nemo_dump=on, then archive to tape
#=======================================
if [ $nemo_dump -eq 1 ]; then
    #-----------------------------
    # create list of files to dump
    #-----------------------------
        dump_list=""
    
        #--- history files ---#
        # create arrays
        suff_arr=($nemo_dump_file_suff)
        freq_arr=($nemo_dump_file_freq)
        
        # check that arrays are the same size
        if [ ${#suff_arr[@]} -ne ${#freq_arr[@]} ]; then
            bail "list of suffixes and file frequency for dumping (nemo_dump_file_suff & nemo_dump_file_freq)\
            must be the same length.... aborting..."
        fi

        # loop through suffixes and file frequencies
        for ((i=0;i<${#suff_arr[@]};++i)); do
            dump_file=$OUTPUT_PATH/${cn_exp}_${freq_arr[i]}_${NEMO_CHUNK_START_DATE}_${NEMO_CHUNK_END_DATE}_${suff_arr[i]}.nc
            
            if [ -e $dump_file ]; then
                dump_list="${dump_list}${dump_file} "
            else
                echo "${dump_file} doesn't exist on ${OUTPUT_PATH}...skipping in archiving step."
            fi
        done

        #--- restart files ---#
        if [ $nemo_dump_rs -eq 1 ]; then
            dump_file=${OUTPUT_PATH}/${cn_exp}_${NEMO_CHUNK_END_DATE}_restart.tar

            if [ -e $dump_file ]; then
                dump_list="${dump_list}${dump_file} " 
            else
                echo "${dump_file} doesn't exist on ${OUTPUT_PATH}...skipping in archiving step."
            fi
        fi

    #-------------------------------------------------------------------------
    # copy files to a single directory and dump to tape, remove once completed
    #-------------------------------------------------------------------------
        dump_dir=${cn_exp}_${NEMO_CHUNK_START_DATE}_${NEMO_CHUNK_END_DATE}
        mkdir $dump_dir
        cp $dump_list $dump_dir/
        echo $(hostname)
        echo $(date)
        hpcarchive -v -g -p $nemo_arch_proj -a $dump_dir -c ${cn_exp}_${NEMO_CHUNK_START_DATE}_${NEMO_CHUNK_END_DATE}_$(date -u +%Y%j%H%M)
        rm -r $dump_dir

fi
#============================================================
# If nemo_del=on, then delete desired data from sitestore
#============================================================
if [ $nemo_del -eq 1 ]; then
    #-------------------------------
    # create list of files to delete
    #-------------------------------
        del_list=""

        #--- history files ---#
        # create arrays
        suff_arr=($nemo_del_file_suff)
        freq_arr=($nemo_del_file_freq)

        # check that arrays are the same size
        if [ ${#suff_arr[@]} -ne ${#freq_arr[@]} ]; then
            bail "list of suffixes and file frequency for deleting (nemo_del_file_suff \
            & nemo_del_file_freq) must be the same length.... aborting..."
        fi

        # loop through suffixes and file frequencies
        for ((i=0;i<${#suff_arr[@]};++i)); do
            del_file=$OUTPUT_PATH/${cn_exp}_${freq_arr[i]}_${NEMO_CHUNK_START_DATE}_${NEMO_CHUNK_END_DATE}_${suff_arr[i]}.nc
            
            if [ -e $del_file ]; then
                del_list="${del_list}${del_file} "
            else
                echo "${dump_file} doesn't exist on ${OUTPUT_PATH}...skipping in deletion step."
            fi
        done
fi

#--- restart files ---#
if [ $with_nemo_diag -eq 1 ]; then # leave two restarts on disk for offline diagnostics
   chunkendyearm1=`echo $NEMO_CHUNK_END_YEAR | awk '{printf "%d", $1-1}' -`
   chunkenddatepy=`echo $chunkendyearm1 ${NEMO_CHUNK_END_MONTH} ${NEMO_CHUNK_END_DAY} |\
                   awk '{printf "%4.4d%2.2d%2.2d",$1,$2,$3}' -`
   if [ $nemo_del_rs -eq 1 ] ; then
        del_file=${OUTPUT_PATH}/${cn_exp}_${chunkenddatepy}_restart.tar

        if [ -e $del_file ]; then
            del_list="${del_list}${del_file} " 
        else
            echo "${del_file} doesn't exist on ${OUTPUT_PATH}...skipping in deletion step."
        fi
   fi
else                               # only leave the last restart on disk
   if [ $nemo_del_rs -eq 1 ] && [ ${loop_postproc} -ne ${NEMO_LOOP_END} ] ; then
        del_file=${OUTPUT_PATH}/${cn_exp}_${NEMO_CHUNK_END_DATE}_restart.tar

        if [ -e $del_file ]; then
            del_list="${del_list}${del_file} "
        else
            echo "${del_file} doesn't exist on ${OUTPUT_PATH}...skipping in deletion step."
        fi
   fi
fi # end of with_nemo_diag

    #-----------------------------
    # delete files in created list 
    #-----------------------------
        rm -f $del_list

#=======================================
# Cleanup temporary run files off ppp* 
#=======================================
if [ "${NEMO_CLEAN_TMP}" == 1 ] ; then

    # clean files as the run progresses, as defined by NEMO_CLEANUP_LAG 
    if [ "${loop_postproc}" > ${NEMO_CLEANUP_LAG} ] ; then
        lmlag=$((${loop_postproc}-${NEMO_CLEANUP_LAG}))
        [ -e ${SEQ_WORKBASE}/CanNEMO/loop_postproc/nemo_diag+${lmlag} ] && rm -rf ${SEQ_WORKBASE}/CanNEMO/loop_postproc/nemo_diag+${lmlag}
        rm -rf ${SEQ_WORKBASE}/CanNEMO/loop_postproc/nemo_DumpDel+${lmlag}
    fi

    # if we are at the end of the job, clean SEQ_WORKBASE entirely
    [ ${loop_postproc} == ${NEMO_LOOP_END} ] && rm -rf ${SEQ_WORKBASE}
fi

