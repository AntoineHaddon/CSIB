# NEMO prelude
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# TODO:
#   - make it so the variables used to define the expected restart names (cn_*rst_in/out)
#     variables are getting the information from canesm.cfg as opposed to being hard coded here
#   - come up with a new way that defaults are set (WAY TOO MANY THINGS ARE SET IN THIS SCRIPT)
#
# NOTE:
#   - this script relies on CanESM_shell_functions.sh

# Local Functions (these should be revaluated)
  function acc_cp() {
    # Attempt to access a file and if that fails attempt to copy it
    [ -z "$1" ] && bail "--> acc_cp <-- requires a local file name as the first arg"
    local_file=$1
    [ -z "$2" ] && bail "--> acc_cp $1 <-- requires a remote file name as the second arg"
    remote_file=$2
    shift 2
    access $local_file $remote_file $*
      #cp $remote_file $local_file ||
      #bail "--> acc_cp $local_file $remote_file $* <-- Unable to locate $remote_file"

    # sha1sum $local_file >> xnemo_access_log
  }

  function find_nemo_config_EXP00() {
    # Find a file in a CONFIG subdir of a NEMO repository
    [ -z "$1" ] && bail "find_nemo_config_EXP00: requires a file name as the first arg"
    if [ -n "$2" ]; then
      # If there is a second argument then assume it is the file name on DATAPATH
      acc_cp $1 $2 nocp=no
    else
      # Otherwise look for a configuration specific file in the NEMO repository
      # nemo_repo, nemo_ver and nemo_config must be defined in this case
      [ -z "$nemo_repo" -o -z "$nemo_ver" -o -z "$nemo_config" ] &&
        bail "find_nemo_config_EXP00: One or more of nemo_repo, nemo_ver, nemo_config are undefined"
      # Attempt to extract this file from the NEMO repository
      rm -f $1
      cp ${nemo_repo}/nemo/cfgs/$nemo_config/EXPREF/$1 .
      [ -s $1 ] || bail "find_nemo_config_EXP00: Unable to copy $1 from $nemo_repo"
    fi
  }

echo "#################### Start NEMO pre-processing #################"
  # TODO CanOE : add the top and CanOE namlist if activer
  nemo_namelists=( namelist_ref     \
                   namelist_cfg     \
                   namelist_ice_ref \
                   namelist_ice_cfg
  )
  # ======================================================
  # Make sure we have necessary variables from parent code
  # ======================================================
  is_defined $chunk_start_date      || bail "nemo_prelude: chunk_start_date must be defined"
  is_defined $chunk_start_year      || bail "nemo_prelude: chunk_start_year must be defined"
  is_defined $chunk_start_month     || bail "nemo_prelude: chunk_start_month must be defined"
  is_defined $run_start_year        || bail "nemo_prelude: run_start_year must be defined"
  is_defined $run_start_month       || bail "nemo_prelude: run_start_month must be defined"
  is_defined $run_stop_year         || bail "nemo_prelude: run_stop_year must be defined"
  is_defined $run_stop_month        || bail "nemo_prelude: run_stop_month must be defined"
  is_defined $nemo_config           || bail "nemo_prelude: nemo_config must be defined"
  is_defined $runid                 || bail "nemo_prelude: runid must be defined"
  is_defined $uxxx                  || bail "nemo_prelude: uxxx must be defined"
  is_defined $nemo_exec             || bail "nemo_prelude: nemo_exec must be defined"
  is_defined $xios_exec             || bail "nemo_prelude: xios_exec must be defined"
  is_defined $runmode               || bail "nemo_prelude: runmode must be defined"

  # ================================
  # Set overrideable default values
  # ================================
  # location of the source code
  nemo_repo=${nemo_repo:=$CCRNSRC/CanESM/CanNEMO}

  # The name of a tar file containing the NEMO restart files
  # This must be set for the first job of a run unless nemo_from_rest = on
  # Restart files created by the submission job will have names of the form
  #     ${uxxx}_${runid}_YYYYMMDD_restart.tar
  nemo_restart=${nemo_restart:=''}

  # nemo_from_rest is used to flag starting nemo from rest rather than a restart
  #     Either define nemo_restart or set nemo_from_rest = on but not both.
  nemo_from_rest=${nemo_from_rest:=off}

  # This is the start of the simulation
  year_run_start=${run_start_time[0]:-1}

  # Forcing method (coupled or bulk_iaf is supported)
  nemo_forcing=${nemo_forcing:-coupled}

  # Define nn_ice which identifies the ice model used in NEMO
  #     0 : no ice boundary condition (does this mean NO ice?)
  #     1 : observed ice cover
  #     2 : SI3 ice-model
  #     3 : CICE ice-model
  nn_ice=${nemo_nn_ice:=2}

  # Default input files
  nemo_coordinates=${nemo_coordinates:=eorca1_domcfg_eorca1v2.2x_orca_jstart_closea.nc}
  nemo_mixing_power_bot=${nemo_mixing_power_bot:=nemo_4.0.1_orca2_mixing_power_bot.nc}
  nemo_mixing_power_pyc=${nemo_mixing_power_pyc:=nemo_4.0.1_orca2_mixing_power_pyc.nc}
  nemo_mixing_power_cri=${nemo_mixing_power_cri:=nemo_4.0.1_orca2_mixing_power_cri.nc}
  nemo_decay_scale_bot=${nemo_decay_scale_bot:=nemo_4.0.1_orca2_decay_scale_bot.nc}
  nemo_decay_scale_cri=${nemo_decay_scale_cri:=nemo_4.0.1_orca2_decay_scale_cri.nc}
  nemo_eddy_viscosity_3D=${nemo_eddy_viscosity_3D:=urdy_eorca1_eddy_viscosity_3d_eorca1_jstart.nc}
  nemo_resto=${nemo_resto:=nemo_4.0.1_orca2_resto.nc}
  nemo_empave_old=${nemo_empave_old:=empave_old.dat}
  nemo_geothermal_heating=${nemo_geothermal_heating:=urdy_eorca1_goutorbe_1x1_0360_eorca1_v2.2x_jstart.nc}
  nemo_sss_data=${nemo_sss_data:=urdy_eorca1_sss_1m_en4_eorca1_blackseapatch_northfoldfix_jstart.nc}
  nemo_sst_data=${nemo_sst_data:=uros_sst_1m_en4_eorca1_blackseapatch_northfoldfix_jstart.nc}
  nemo_chlorophyll=${nemo_chlorophyll:=nemo_4.0.1_orca2_chlorophyll.nc}
  nemo_calving=${nemo_calving:=urdy_eorca1_ecalving_v2.2x_jstart.nc}
  nemo_bfr_coef=${nemo_bfr_coef:=urdy_eorca1_bfr_coef01_jstart.nc}
  nemo_subbasins=${nemo_subbasins:=urdy_eorca1_subbasins_cmip6_jstart.nc}
  nemo_data_1m_potential_temperature_nomask=${nemo_data_1m_potential_temperature_nomask:=urdy_eorca1_en4_v1.1.1995_2014.monthlymean_eorca1t_nemo_l75_jstart.nc}
  nemo_data_1m_salinity_nomask=${nemo_data_1m_salinity_nomask:=urdy_eorca1_en4_v1.1.1995_2014.monthlymean_eorca1t_nemo_l75_jstart.nc}

  # Interannual forcing consideration (TODO : add "coupled" mayby)
  if [[ $nemo_forcing == "bulk_iaf" ]]; then
    nemo_runoff_core_monthly=${nemo_runoff_core_monthly:=urdy_eorca1_runoff_v2.2x_jstart.nc}
    nemo_weights_bicubic2=${nemo_weights_bicubic2:=urdy_weights_canamgrid_bicubic_eorca1_jstart.nc}
    nemo_weights_bilinear2=${nemo_weights_bilinear2:=urdy_weights_canamgrid_bilinear_eorca1_jstart.nc}

    # loop the forching for yyyy-1  to  yyyy+1  to do the interpolation with dec 31st of yyyy-1 and Jan 1st yyyy+1
    for current_year in `seq $(( $chunk_start_year -1 )) $(( $chunk_stop_year +1 )) `; do
        ## first and last year won't find the yyyy-1 and yyyy+1 (respectivelly).
        [[ $current_year -lt run_start_year || $current_year -gt run_stop_year ]] && continue

        yearc=`expr ${current_year} | awk  '{printf "%04d",$1}'`
        fy=`expr ${yearc} + ${iaf_year_offset} | awk  '{printf "%04d",$1}'`
        yd=`expr ${iaf_loop_year} - ${iaf_year_offset}`
        fyl=`expr ${fy} - '(' '(' ${yearc} - 1 ')' / ${yd} ')' \* ${yd}`           
        forcing_year=`expr ${fyl} | awk  '{printf "%04d",$1}'`
        acc_cp tair10m_y${yearc}.nc          ${nemo_t}_y${forcing_year}.nc
        acc_cp uwnd10m_y${yearc}.nc          ${nemo_u}_y${forcing_year}.nc
        acc_cp vwnd10m_y${yearc}.nc          ${nemo_v}_y${forcing_year}.nc
        acc_cp humi10m_y${yearc}.nc          ${nemo_q}_y${forcing_year}.nc
        acc_cp qsr_y${yearc}.nc              ${nemo_qsr}_y${forcing_year}.nc
        acc_cp qlw_y${yearc}.nc              ${nemo_qlw}_y${forcing_year}.nc
        acc_cp precip_y${yearc}.nc           ${nemo_precip}_y${forcing_year}.nc
        acc_cp snow_y${yearc}.nc             ${nemo_snow}_y${forcing_year}.nc
	    acc_cp slp_y${yearc}.nc              ${nemo_slp}_y${forcing_year}.nc
    done
    acc_cp weights_bic2.nc           $nemo_weights_bicubic2   # weights for bulk mode
    acc_cp weights_bil2.nc           $nemo_weights_bilinear2  # weights for bulk mode

    acc_cp runoff.nc    $nemo_runoff_core_monthly
  fi

  acc_cp domain_cfg.nc             $nemo_coordinates
  acc_cp mixing_power_bot.nc       $nemo_mixing_power_bot # still used ?
  acc_cp mixing_power_pyc.nc       $nemo_mixing_power_pyc # still used ?
  acc_cp mixing_power_cri.nc       $nemo_mixing_power_cri # still used ?
  acc_cp decay_scale_bot.nc        $nemo_decay_scale_bot # still used ?
  acc_cp decay_scale_cri.nc        $nemo_decay_scale_cri # still used ?
  acc_cp eddy_viscosity_3D.nc      $nemo_eddy_viscosity_3D # still used ?
  acc_cp resto.nc                  $nemo_resto # still used ?
  acc_cp EMPave_old.dat            $nemo_empave_old # still used ?
  acc_cp geothermal_heating.nc     $nemo_geothermal_heating
  acc_cp sss_data.nc               $nemo_sss_data
  acc_cp sst_data.nc               $nemo_sst_data
  acc_cp chlorophyll.nc            $nemo_chlorophyll
  acc_cp calving.nc                $nemo_calving # still used ?
  acc_cp bfr_coef.nc               $nemo_bfr_coef
  acc_cp subbasins.nc              $nemo_subbasins  # still used ?  
  acc_cp data_1m_potential_temperature_nomask.nc $nemo_data_1m_potential_temperature_nomask
  acc_cp data_1m_salinity_nomask.nc              $nemo_data_1m_salinity_nomask

  # Access files required to run NEMO
  xios_files=( axis_def_nemo.xml \
               context_nemo.xml \
               domain_def_nemo.xml \
               field_def_nemo-ice.xml \
               field_def_nemo-oce.xml \
               field_def_nemo-pisces.xml \
               file_def_nemo-ice.xml \
               file_def_nemo-oce.xml \
               file_def_nemo-pisces.xml \
               grid_def_nemo.xml \
               iodef.xml )

  for file in "${xios_files[@]}"; do
    find_nemo_config_EXP00 $file
  done

  # ==============================
  # High level consistency checks
  # ==============================
  # Translate switches into 0/1 booleans
  ToF nemo_from_rest
  # Switch 'nemo_from_rest' off if this isn't the first job in the run as it was
  #   _already_ started from rest
  if [[ $chunk_start_date != $run_start_date ]] && (( nemo_from_rest == 1 )); then
    nemo_from_rest=0
  fi

  # bail if use asked to use a specific restart and start from rest
  if is_defined $nemo_restart && (( nemo_from_rest == 1 )); then
    bail "nemo_prelude: nemo_restart=$nemo_restart and nemo_from_rest=1 are mutually exclusive"
  fi

  # confirm a valid ice settings
  case $nn_ice in
    2) ;; # SI3 ice-model
    *) bail "Invalid value for nn_ice = $nn_ice" ;;
  esac

  # =====================
  # Set Inherited params
  # =====================

  # Identify the location of the NEMO git repository and the commit within
  #   that repository that is associated with the current run
  if is_defined $nemo_ver; then
    # Dereference this commit and ensure we have a full sha1 hash
    nemo_ver=`(cd $nemo_repo; git rev-parse $nemo_ver)` ||
        bail "Unable to validate runtime nemo_ver"
  fi
  export nemo_ver nemo_repo nemo_config
  echo "### NEMO runtime: nemo_repo   = $nemo_repo"
  echo "### NEMO runtime: nemo_ver    = $nemo_ver"
  echo "### NEMO runtime: nemo_config = $nemo_config"

  run_start_day=1
  run_start_date=$( printf "%04d%02d%02d" $run_start_year $run_start_month $run_start_day )
  run_stop_day=$(days_in_month $run_stop_month)
  run_stop_date=$( printf "%04d%02d%02d" $run_stop_year $run_stop_month $run_stop_day )
  echo "nemo_prelude: chunk_start_date=$chunk_start_date"
  echo "nemo_prelude: run_start_date=$run_start_date"
  echo "nemo_prelude: run_stop_date=$run_stop_date"

  # Touch xnemo_access_log so that it will exist even if it never gets appended to
  rm -f xnemo_access_log
  touch xnemo_access_log

  # Ignore missing ice restart files when with_ice = off
  if (( nn_ice >= 2 )); then
    with_ice=1
  else
    with_ice=0
  fi

  if (( nemo_from_rest == 1 )); then
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
    #=#=#=#    Start from rest    #=#=#=#
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

    echo "###############################"
    echo "###   Starting from rest.   ###"
    echo "###############################"

    # Initial date
    prev_date0="010101"
  else
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
    #=#=#=#   Start from a restart  #=#=#=#
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

    # Determine what restart to use
    # -----------------------------
    if (( chunk_start_month == 1 )); then
      rs_mon=12
      rs_year=$(( chunk_start_year - 1 ))
    else
      rs_mon=$(( chunk_start_month - 1 ))
      rs_year=$chunk_start_year
    fi

    # Restart file name
    rs_sfx="nemors.tar"
    rs_date_string=$(printf "%04d_m%02d" $rs_year $rs_mon) # YYYY_mMM
    rs_file=${uxxx}_${runid}_${rs_date_string}_${rs_sfx}

    # Set the name of the restart file that is ACTUALLY used (can be overridden by user)
    nemo_rs=${nemo_restart:-$rs_file}

    # Access the restart and process it as necessary
    # ----------------------------------------------
    echo "##########################"
    echo "###   Restarting from file $nemo_rs"
    echo "##########################"

    rm -f RESTART_ARC
    access RESTART_ARC $(basename $nemo_rs .tar) nocp=off || access RESTART_ARC $nemo_rs

    # Deal with "old" tar archives, or new directory based restarts
    if ! tar tf RESTART_ARC &> /dev/null; then
        # This is the directory. checksum the contents
        sha1sum RESTART_ARC/* >> xnemo_access_log
        mv RESTART_ARC/* . || bail "Cannot get files from restart directory"
    else
        # this is the tar file. checksum it.
        sha1sum RESTART_ARC >> xnemo_access_log
        # Ensure that we can overwrite existing files with files from the restart
        # Ignore any netcdf files in the restart
        tar tf RESTART_ARC | grep -v '\.nc$' | xargs -I'{}' chmod u+rw {} || :
        tar xf RESTART_ARC || bail "Cannot extract files from $nemo_rs"
    fi
    release RESTART_ARC

    # Rename each task specific restart files (extracted above)
    # ---------------------------------------------------------
    # - When starting a new run from an existing restart the ocean and ice restart
    #   file names found in the restart tar file will be prefixed with the runid used
    #   in the previous run.

    # Define the names that nemo will look for
    # - these files get extracted from the 'nemo_rs' file
    # - for INPUT files each domain's specific file will look like ${cn_*rst_in}_MMMM.nc
    #   while for OUTPUT files, each domain's specific file will look like ${runid}_NNNNNNN_${cn_*rst_out}_MMMM.nc
    #       - where MMMM is the MPI task number and NNNNNNNN is the timestep
    cn_ocerst_in=${nemo_cn_ocerst_in:="restart"}
    cn_ocerst_out=${nemo_cn_ocerst_out:="restart"}
    cn_icerst_in=${nemo_cn_icerst_in:="restart_ice_in"}
    cn_icerst_out=${nemo_cn_icerst_out:="restart_ice"}
    cn_trcrst_in=${nemo_cn_trcrst_in:="restart_trc_in"}
    cn_trcrst_out=${nemo_cn_trcrst_out:="restart_trc"}

    # Ocean restart files
    found_rs=`(ls -1 *_${cn_ocerst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_ocerst_out}.nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && bail "No ocean restart files were found in $nemo_rs"
    rm -f input_ocn_restart_file_names
    touch input_ocn_restart_file_names
    for rsfile in $found_rs; do
      [ $rsfile = 'cpl_restart.nc' ] && continue
      sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
      [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
      mv $rsfile ${cn_ocerst_in}$sfx
      echo "${cn_ocerst_in}$sfx" >> input_ocn_restart_file_names
    done

    # Ice restart files
    rm -f input_ice_restart_file_names
    touch input_ice_restart_file_names
    found_rs=`(ls -1 *_${cn_icerst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_icerst_out}.nc || : ) 2>/dev/null`
    if [ -z "$found_rs" ]; then
      [ $nn_ice -ge 2 ] && bail "No ice restart files were found in $nemo_rs"
      with_ice=off
    else
      for rsfile in $found_rs; do
        [ $rsfile = 'cpl_restart.nc' ] && continue
        sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
        [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
        mv $rsfile ${cn_icerst_in}$sfx
        echo "${cn_icerst_in}$sfx" >> input_ice_restart_file_names
      done
    fi

    # trc restart files
    rm -f input_trc_restart_file_names
    touch input_trc_restart_file_names
    found_rs=`(ls -1 *_${cn_trcrst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_trcrst_out}.nc || : ) 2>/dev/null`
    if [ -z "$found_rs" ]; then
      [ $nemo_carbon -eq 1 ] && bail "No trc restart files were found in $nemo_rs"
      with_trc=off
    else
      for rsfile in $found_rs; do
        [ $rsfile = 'cpl_restart.nc' ] && continue
        sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
        [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
        mv $rsfile ${cn_trcrst_in}$sfx
        echo "${cn_trcrst_in}$sfx" >> input_trc_restart_file_names
      done
    fi
  fi

  # ===================
  # Access input files
  # ===================
  # - many are only pulled in they don't already exist
  # - the main defaults are defined at the top of this script (should we move other runmode specific files?)

  # run namelists
  for f in "${nemo_namelists[@]}"; do
      ! is_file $f && cp ${WRK_DIR}/config/namelists/${f} .
  done

  # nemo executable
  ! is_file $nemo_exec && cp ${EXEC_STORAGE_DIR}/$nemo_exec .
  # # xios executable
  ! is_file $xios_exec && cp ${EXEC_STORAGE_DIR}/$xios_exec .

echo "#################### Stop NEMO pre-processing #################"
