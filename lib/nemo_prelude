#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# NEMO prelude
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# TODO:
#   - make it so the variables used to define the expected restart names (cn_*rst_in/out)
#     variables are getting the information from canesm.cfg as opposed to being hard coded here
#   - come up with a new way that defaults are set (WAY TOO MANY THINGS ARE SET IN THIS SCRIPT)
#
# NOTE:
#   - this script relies on CanESM_shell_functions.sh

echo "#################### Start NEMO pre-processing #################"

  # Make sure we have necessary variables from parent code
  is_defined $chunk_start_date      || bail "nemo_prelude: chunk_start_date must be defined"
  is_defined $chunk_start_year      || bail "nemo_prelude: chunk_start_year must be defined"
  is_defined $chunk_start_month     || bail "nemo_prelude: chunk_start_month must be defined"
  is_defined $chunk_stop_date       || bail "nemo_prelude: chunk_stop_date must be defined"
  is_defined $chunk_stop_year       || bail "nemo_prelude: chunk_stop_year must be defined"
  is_defined $chunk_stop_month      || bail "nemo_prelude: chunk_stop_month must be defined"
  is_defined $current_year          || bail "nemo_prelude: current_year must be defined"
  is_defined $run_start_year        || bail "nemo_prelude: run_start_year must be defined"
  is_defined $run_start_month       || bail "nemo_prelude: run_start_month must be defined"
  is_defined $run_stop_year         || bail "nemo_prelude: run_stop_year must be defined"
  is_defined $run_stop_month        || bail "nemo_prelude: run_stop_month must be defined"
  is_defined $nemo_config           || bail "nemo_prelude: nemo_config must be defined"
  is_defined $runid                 || bail "nemo_prelude: runid must be defined"
  is_defined $uxxx                  || bail "nemo_prelude: uxxx must be defined"
  is_defined $nemo_exec             || bail "nemo_prelude: nemo_exec must be defined"
  is_defined $nemo_namelists        || bail "nemo_prelude: nemo_namelists must be defined"
  is_defined $nemo_iodef            || bail "nemo_prelude: nemo_iodef must be defined"
  is_defined $output_level          || bail "nemo_prelude: output_level must be defined"
  is_defined $nemo_xmlio_server_def || bail "nemo_prelude: nemo_xmlio_server_def must be defined"
  is_defined $runmode               || bail "nemo_prelude: runmode must be defined"

  # Identify the location of the NEMO git repository and the commit within
  #   that repository that is associated with the current run
  nemo_repo=${nemo_repo:=$CCRNSRC/ocean_dir/nemo-CCCma.git}
  nemo_repo=${nemo_repo:=$CCRNSRC/CanESM/CanNEMO}
  if is_definied $nemo_ver; then
    # Dereference this commit and ensure we have a full sha1 hash
    nemo_ver=`(cd $nemo_repo; git rev-parse $nemo_ver)` ||
        bail "Unable to validate runtime nemo_ver"
  fi

  # Identify the NEMO configuration associated with the current run
  #     (e.g. CCC_ORCA1_LIM, CCC_ORCA1_LIM_CMOC, CCC_ORCA1_LIM_CANOE, ...)
  export nemo_ver nemo_repo nemo_config
  echo "### NEMO runtime: nemo_repo   = $nemo_repo"
  echo "### NEMO runtime: nemo_ver    = $nemo_ver"
  echo "### NEMO runtime: nemo_config = $nemo_config"

  # The name of a tar file containing the NEMO restart files
  # This must be set for the first job of a run unless nemo_from_rest = on
  # Restart files created by the submission job will have names of the form
  #     ${uxxx}_${runid}_YYYYMMDD_restart.tar
  nemo_restart=${nemo_restart:=''}

  # nemo_from_rest is used to flag starting nemo from rest rather than a restart
  #     Either define nemo_restart or set nemo_from_rest = on but not both.
  nemo_from_rest=${nemo_from_rest:=0}

  # nemo_forcing identifies the type of forcing to use
  #     Currenlty the only valid values are "bulk", "bulk_iaf", "flux", "flux_iaf" or "coupled"
  nemo_forcing=${nemo_forcing:=coupled}

  # For interannual forcing, iaf_year_offset gives the offset between
  #     the current nemo year and the desired year in the forcing dataset
  #     such that forcing_year = current_year + iaf_year_offset.
  #     The data to be used will end in _y${forcing_year}.nc
  iaf_year_offset=${iaf_year_offset:=0}

  # For interannual forcing, iaf_loop_year gives the year at which the
  #     forcing will loop back to the first specified year of forcing.
  #     The number is given in terms of "forcing_year" as opposed to
  #     nemo "current_year": forcing_year = current_year + iaf_year_offset
  iaf_loop_year=${iaf_loop_year:=0}

  # This is the start of the simulation
  year_run_start=${run_start_time[0]:-1}

  # nemo_trc = 0 means use physical ocean only
  # nemo_trc = 1  means use passive tracers (general, CFC, MY_TRC, even if pisces/cmoc=off)
  nemo_trc=${nemo_trc:=1}

  # nemo_carbon = 0 means use physical ocean only
  # nemo_carbon = 1 means include PISCES
  nemo_carbon=${nemo_carbon:=0}

  # Miscelaneous local definitions
  ToF(){
    #   usage: ToF var_name
    # purpose: Possibly reset the value of var_name to "0" (false) or "1" (true)
    #          If var_name is null or has a value of "off" or "no" then reset to "0"
    #          If var_name has a value of "on" or "yes" then reset to "1"
    #          Otherwise return with var_name unchanged
    [ -z "$1" ] && bail "ToF requires a variable name as an argument"
    eval ToF_var\=\$$1
    XXX=$(echo $ToF_var|sed 's/ //g')
    eval ToF_var\=$XXX
    if [ -n "$ToF_var" ]; then
      if   [ "$ToF_var" = 'on'  ]; then eval ToF_var\=1
      elif [ "$ToF_var" = 'off' ]; then eval ToF_var\=0
      elif [ "$ToF_var" = 'yes' ]; then eval ToF_var\=1
      elif [ "$ToF_var" = 'no'  ]; then eval ToF_var\=0
      else
        eval ToF_var\=\$$1
      fi
    else
      eval ToF_var\=0
    fi
    eval $1=$ToF_var
  }

  acc_cp() {
    # Attempt to access a file and if that fails attempt to copy it
    [ -z "$1" ] && bail "--> acc_cp <-- requires a local file name as the first arg"
    local_file=$1
    [ -z "$2" ] && bail "--> acc_cp $1 <-- requires a remote file name as the second arg"
    remote_file=$2
    shift 2
    access $local_file $remote_file $*
      #cp $remote_file $local_file ||
      #bail "--> acc_cp $local_file $remote_file $* <-- Unable to locate $remote_file"

    # sha1sum $local_file >> xnemo_access_log
  }

  find_nemo_config_EXP00() {
    # Find a file in a CONFIG subdir of a NEMO repository
    [ -z "$1" ] && bail "find_nemo_config_EXP00: requires a file name as the first arg"
    if [ -n "$2" ]; then
      # If there is a second argument then assume it is the file name on DATAPATH
      acc_cp $1 $2 nocp=no
    else
      # Otherwise look for a configuration specific file in the NEMO repository
      # nemo_repo, nemo_ver and nemo_config must be defined in this case
      [ -z "$nemo_repo" -o -z "$nemo_ver" -o -z "$nemo_config" ] &&
        bail "find_nemo_config_EXP00: One or more of nemo_repo, nemo_ver, nemo_config are undefined"
      # Attempt to extract this file from the NEMO repository
      rm -f $1
      cp ${nemo_repo}/nemo/CONFIG/$nemo_config/EXP00/$1 .
      [ -s $1 ] || bail "find_nemo_config_EXP00: Unable to copy $1 from $nemo_repo"
    fi
  }

  run_start_day=1
  run_start_date=$( printf "%04d-%02d-%02d" $run_start_year $run_start_month $run_start_day )
  run_stop_day=$(days_in_month $run_stop_month)
  run_start_date=$( printf "%04d-%02d-%02d" $run_stop_year $run_stop_month $run_stop_day )

  echo "nemo_prelude: chunk_start_date=$chunk_start_date"
  echo "nemo_prelude: chunk_stop_date=$chunk_stop_date"
  echo "nemo_prelude: run_start_date=$run_start_date"
  echo "nemo_prelude: run_stop_date=$run_stop_date"

  # Translate switches into 0/1 booleans - NOTE THAT THIS WILL SET TO 0 IF UNDEFINED
  ToF nemo_from_rest
  ToF nemo_carbon
  ToF nemo_trans_co2
  ToF nemo_trc
  ToF nemo_cfc

  # bail if use asked to use a specific restart and start from rest
  if is_defined $nemo_restart && (( nemo_from_rest == 1 )); then
    bail "nemo_prelude: nemo_restart=$nemo_restart and nemo_from_rest=1 are mutually exclusive"
  fi

  # Identify the type of forcing to use
  nemo_forcing=${nemo_forcing:-coupled}
  case $nemo_forcing in
    coupled) ;; # These are valid values
    bulk_iaf) ;;
    *) bail "Invalid value for nemo_forcing = $nemo_forcing" ;;
  esac

  # Switch 'nemo_from_rest' off if this isn't the first job in the run as it was
  #   _already_ started from rest
  if [[ "$chunk_start_date" == "$run_start_date" ]] && (( nemo_from_rest == 1 )); then
    nemo_from_rest=0
  fi

  nemo_cmoc=0
  nemo_canoe=0
  case $nemo_config in
    *_CANOE*) nemo_canoe=1 ;; # use CANOE carbon in NEMO
     *_CMOC*) nemo_cmoc=1  ;; # use CMOC carbon in NEMO
  esac

  # Use CFCs or not
  nemo_cfc=${nemo_cfc:=0}

  # Touch xnemo_access_log so that it will exist even if it never gets apppended to
  rm -f xnemo_access_log
  touch xnemo_access_log

  # Define nn_ice which identifies the ice model used in NEMO
  nn_ice=${nemo_nn_ice:=2}
  case $nn_ice in
    0) ;; # no ice boundary condition
    1) ;; # observed ice cover
    2) ;; # LIM2 ice-model
    3) ;; # LIM3 ice-model
    *) bail "Invalid value for nn_ice = $nn_ice" ;;
  esac

  # Ignore missing ice restart files when with_ice = off
  if (( nn_ice >= 2 )); then
    with_ice=on
  else
    with_ice=off
  fi
  ToF with_ice

  # If do_nemo_run=on then access all the required files and do the run.
  # Using do_nemo_run=off can be used, for example, to process RTD for a
  # run that has already been done.
  do_nemo_run=${do_nemo_run:=on}
  ToF do_nemo_run

  [ -z "$nemo_from_rest" ] && bail "nemo_from_rest is not defined"
  ToF nemo_from_rest
  if (( nemo_from_rest == 1 )); then
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
    #=#=#=#    Start from rest    #=#=#=#
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

    echo "###############################"
    echo "###   Starting from rest.   ###"
    echo "###############################"

    # Initial date
    prev_date0="010101"
  else
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
    #=#=#=#   Start from a restart  #=#=#=#
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

    # Determine what restart to use
    # -----------------------------
    if (( chunk_start_month == 1 )); then
      rs_mon=12
      if (( chunk_start_year == 1 )); then
        rs_year=0
      else
        rs_year=$(( chunk_start_year - 1 ))
      fi
    else
      rs_mon=$(( chunk_start_mon - 1 ))
      rs_year=$start_year
    fi

    # Restart file name
    rs_sfx="nemors.tar"
    rs_file=${uxxx}_${runid}_${rs_year_mon}_$rs_sfx

    # Set the name of the restart file that is ACTUALLY used (can be overridden by user)
    nemo_rs=${nemo_restart:-$rs_file}

    # Access the restart and process it as necessary
    # ----------------------------------------------
    echo "##########################"
    echo "###   Restarting from file $nemo_rs"
    echo "##########################"

    rm -f RESTART_ARC
    access RESTART_ARC $(basename $nemo_rs .tar) nocp=off || access RESTART_ARC $nemo_rs

    # Deal with "old" tar archives, or new directory based restarts
    if ! tar tf RESTART_ARC &> /dev/null; then
        # This is the directory. checksum the contents
        sha1sum RESTART_ARC/* >> xnemo_access_log
        mv RESTART_ARC/* . || bail "Cannot get files from restart directory"
    else
        # this is the tar file. checksum it.
        sha1sum RESTART_ARC >> xnemo_access_log
        # Ensure that we can overwrite existing files with files from the restart
        # Ignore any netcdf files in the restart
        tar tf RESTART_ARC | grep -v '\.nc$' | xargs -I'{}' chmod u+rw {} || :
        tar xf RESTART_ARC || bail "Cannot extract files from $nemo_rs"
    fi
    release RESTART_ARC

    # Rename each task specific restart files (extracted above)
    # ---------------------------------------------------------
    # - When starting a new run from an existing restart the ocean and ice restart
    #   file names found in the restart tar file will be prefixed with the runid used
    #   in the previous run.

    # Define the names that nemo will look for
    # - these files get extracted from the 'nemo_rs' file
    # - for INPUT files each domain's specific file will look like ${cn_*rst_in}_MMMM.nc
    #   while for OUTPUT files, each domain's specific file will look like ${runid}_NNNNNNN_${cn_*rst_out}_MMMM.nc
    #       - where MMMM is the MPI task number and NNNNNNNN is the timestep
    cn_ocerst_in="restart"          # ocean input
    cn_ocerst_out="restart"         # ocean output
    cn_icerst_in="restart_ice_in"   # ice input
    cn_icerst_out="restart_ice"     # ice output
    cn_trcrst_in="restart_trc_in"   # pisces input
    cn_trcrst_out="restart_trc"     # pisces output

    if [[ "$runmode" == NEMO-AGCM-dcpp-assim* ]] ; then
      if [ -s "rs_EMPave.dat" ] ; then
        cp rs_EMPave.dat EMPave_old.dat
      fi
    fi

    # Ocean restart files
    found_rs=`(ls -1 *_${cn_ocerst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_ocerst_out}.nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && bail "No ocean restart files were found in $nemo_rs"
    rm -f input_ocn_restart_file_names
    touch input_ocn_restart_file_names
    for rsfile in $found_rs; do
      [ $rsfile = 'cpl_restart.nc' ] && continue
      sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
      [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
      mv $rsfile ${cn_ocerst_in}$sfx
      echo "${cn_ocerst_in}$sfx" >> input_ocn_restart_file_names
    done

    # Ice restart files
    rm -f input_ice_restart_file_names
    touch input_ice_restart_file_names
    found_rs=`(ls -1 *_${cn_icerst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_icerst_out}.nc || : ) 2>/dev/null`
    if [ -z "$found_rs" ]; then
      [ $nn_ice -ge 2 ] && bail "No ice restart files were found in $nemo_rs"
      with_ice=off
    else
      for rsfile in $found_rs; do
        [ $rsfile = 'cpl_restart.nc' ] && continue
        sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
        [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
        mv $rsfile ${cn_icerst_in}$sfx
        echo "${cn_icerst_in}$sfx" >> input_ice_restart_file_names
      done
    fi

    # (IF ON) Pisces restart files
    if [ $nemo_trc -eq 1 ] || [ $nemo_carbon -eq 1 ]; then
      found_rs=`(ls -1 *_${cn_trcrst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
      [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_trcrst_out}.nc || : ) 2>/dev/null`
      [ -z "$found_rs" ] && bail "No Pisces restart files were found in $nemo_rs"
      rm -f input_trc_restart_file_names
      touch input_trc_restart_file_names
      for rsfile in $found_rs; do
        [ $rsfile = 'cpl_restart.nc' ] && continue
        sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
        [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
        mv $rsfile ${cn_trcrst_in}$sfx
        echo "${cn_trcrst_in}$sfx" >> input_trc_restart_file_names
      done
    fi
  fi

  # Access additional files required to run NEMO
  # --------------------------------------------
  # - many are only pulled in they don't already exist

  # run namelists
  for f in $nemo_namelists; do
      ! is_file $f && cp ${WRK_DIR}/config/namelists/${f} .
  done

  # nemo executable
  ! is_file $nemo_exec && cp ${CCRNSRC}/executables/$nemo_exec .

  # i/o definition file (bring it in and update output_level)
  is_zero_size iodef.xml && find_nemo_config_EXP00 iodef.xml $nemo_iodef
  sed -i "s/output_level=\"\([0-9]\+\)\"/output_level=\"${output_level}\"/" iodef.xml

  is_zero_size xmlio_server.def && find_nemo_config_EXP00 xmlio_server.def $nemo_xmlio_server_def

  # NOTE: we should think on where to move defaults for this...
  nemo_ahmcoef=${nemo_ahmcoef:=nemo_3.4_orca1_ahmcoef}
  nemo_coordinates=${nemo_coordinates:=nemo_3.4_orca1_coordinates_ukorca1.nc}
  nemo_bathy_meter=${nemo_bathy_meter:=nemo_3.4_orca1_bathy_meter_050308_ukmo_mod.nc}
  nemo_mask_itf=${nemo_mask_itf:=nemo_3.4_orca1_mask_itf_orca1_new.nc}
  nemo_M2rowdrg=${nemo_M2rowdrg:=nemo_3.4_orca1_m2rowdrg_r1_modif.nc}
  nemo_K1rowdrg=${nemo_K1rowdrg:=nemo_3.4_orca1_k1rowdrg_r1_modif.nc}
  nemo_Eddyengf=${nemo_Eddyengf:=nemo_3.4_orca1_eddy_mix.nc}
#  nemo_geothermal_heating=${nemo_geothermal_heating:=nemo_3.3_orca2_geothermal_heating.nc}
  nemo_runoff_core_monthly=${nemo_runoff_core_monthly:=nemo_3.4_orca1_runoff_1m_orca1.nc}
  nemo_sst_data=${nemo_sst_data:=nemo_3.4_orca1_sst_1m_orca1.nc}
  nemo_sss_data=${nemo_sss_data:=omip6_orca1_data_sss_nomask.nc}
  nemo_chlorophyll=${nemo_chlorophyll:=nemo_3.4_orca1_chlorophyll-orca1_1m.nc}
  nemo_subbasins=${nemo_subbasins:=nemo_3.4_orca1_basinmask_050308_ukmo_modified.nc}
  nemo_o2=${nemo_o2:=urdy_fafmip_hfds_orca1_record.nc}

  if [[ "$runmode" == NEMO-AGCM-dcpp-assim* ]] ; then
    nemo_weights_bilinear1=${nemo_weights_bilinear1:=uws_orca1_oisst_weights_bilin.nc}
    nemo_weights_bicubic1=${nemo_weights_bicubic1:=uws_orca1_oisst_weights_bicubic.nc}
    nemo_dist_coast=uws_orca1_dist_coast.nc
    is_zero_size weights_bil1.nc && acc_cp weights_bil1.nc     $nemo_weights_bilinear1
    is_zero_size weights_bic1.nc && acc_cp weights_bic1.nc     $nemo_weights_bicubic1
    is_zero_size dist.coast.nc   && acc_cp dist.coast.nc       $nemo_dist_coast

    nemo_sst=uws_oisst_daily
  fi

  if [[ "$runmode" == "NEMO-AGCM-dcpp-assim" ]] || [[ "$runmode" == "NEMO-AGCM-dcpp-assim-relaxed-co2" ]] ; then
    nemo_data_1m_potential_temperature=uws_oras5_thetao
    nemo_data_1m_salinity=uws_oras5_so
    nemo_hicif_damping=uws_hicif_damping
    nemo_frld_damping=uws_frld_damping

    before_current_year=`expr $current_year - 1 | awk  '{printf "%04d",$1}'`
    after_current_year=`expr $current_year + 1 | awk  '{printf "%04d",$1}'`

    acc_cp sst_y${current_year}.nc                                  ${nemo_sst}_y${current_year}.nc

    acc_cp hicif_damping_y${current_year}.nc                        ${nemo_hicif_damping}_1m_y${current_year}.nc
    acc_cp frld_damping_y${current_year}.nc                         ${nemo_frld_damping}_1m_y${current_year}.nc
    acc_cp data_1m_potential_temperature_y${current_year}.nc        ${nemo_data_1m_potential_temperature}_1m_y${current_year}.nc
    acc_cp data_1m_salinity_y${current_year}.nc                     ${nemo_data_1m_salinity}_1m_y${current_year}.nc

    acc_cp hicif_damping_y${before_current_year}.nc                 ${nemo_hicif_damping}_dec_y${before_current_year}.nc
    acc_cp frld_damping_y${before_current_year}.nc                  ${nemo_frld_damping}_dec_y${before_current_year}.nc
    acc_cp data_1m_potential_temperature_y${before_current_year}.nc ${nemo_data_1m_potential_temperature}_dec_y${before_current_year}.nc
    acc_cp data_1m_salinity_y${before_current_year}.nc              ${nemo_data_1m_salinity}_dec_y${before_current_year}.nc

    acc_cp hicif_damping_y${after_current_year}.nc                  ${nemo_hicif_damping}_jan_y${after_current_year}.nc
    acc_cp frld_damping_y${after_current_year}.nc                   ${nemo_frld_damping}_jan_y${after_current_year}.nc
    acc_cp data_1m_potential_temperature_y${after_current_year}.nc  ${nemo_data_1m_potential_temperature}_jan_y${after_current_year}.nc
    acc_cp data_1m_salinity_y${after_current_year}.nc               ${nemo_data_1m_salinity}_jan_y${after_current_year}.nc

  elif [[ "$runmode" == NEMO-AGCM-dcpp-assim*-spin* ]] ; then

    nemo_data_1m_potential_temperature=uws_oras5_thetao_spin
    nemo_data_1m_salinity=uws_oras5_so_spin
    nemo_hicif_damping=uws_hicif_damping_spin
    nemo_frld_damping=uws_frld_damping_spin

    spin_year=${current_year}
    while [ $spin_year -gt 1967 ] ; do
      spin_year=`expr $spin_year - 10`
    done

    before_current_year=`expr $current_year - 1 | awk  '{printf "%04d",$1}'`
    after_current_year=`expr $current_year + 1 | awk  '{printf "%04d",$1}'`
    before_spin_year=`expr ${spin_year} - 1 | awk  '{printf "%04d",$1}'`
    after_spin_year=`expr ${spin_year} + 1 | awk  '{printf "%04d",$1}'`

    acc_cp sst_y${current_year}.nc                                  ${nemo_sst}_y${spin_year}.nc

    acc_cp hicif_damping_y${current_year}.nc                        ${nemo_hicif_damping}_1m_y${spin_year}.nc
    acc_cp frld_damping_y${current_year}.nc                         ${nemo_frld_damping}_1m_y${spin_year}.nc
    acc_cp data_1m_potential_temperature_y${current_year}.nc        ${nemo_data_1m_potential_temperature}_1m_y${spin_year}.nc
    acc_cp data_1m_salinity_y${current_year}.nc                     ${nemo_data_1m_salinity}_1m_y${spin_year}.nc

    acc_cp hicif_damping_y${before_current_year}.nc                 ${nemo_hicif_damping}_dec_y${before_spin_year}.nc
    acc_cp frld_damping_y${before_current_year}.nc                  ${nemo_frld_damping}_dec_y${before_spin_year}.nc
    acc_cp data_1m_potential_temperature_y${before_current_year}.nc ${nemo_data_1m_potential_temperature}_dec_y${before_spin_year}.nc
    acc_cp data_1m_salinity_y${before_current_year}.nc              ${nemo_data_1m_salinity}_dec_y${before_spin_year}.nc

    acc_cp hicif_damping_y${after_current_year}.nc                  ${nemo_hicif_damping}_jan_y${after_spin_year}.nc
    acc_cp frld_damping_y${after_current_year}.nc                   ${nemo_frld_damping}_jan_y${after_spin_year}.nc
    acc_cp data_1m_potential_temperature_y${after_current_year}.nc  ${nemo_data_1m_potential_temperature}_jan_y${after_spin_year}.nc
    acc_cp data_1m_salinity_y${after_current_year}.nc               ${nemo_data_1m_salinity}_jan_y${after_spin_year}.nc

  fi

  is_zero_size ahmcoef                && acc_cp ahmcoef                $nemo_ahmcoef
  is_zero_size coordinates.nc         && acc_cp coordinates.nc         $nemo_coordinates
  is_zero_size bathy_meter.nc         && acc_cp bathy_meter.nc         $nemo_bathy_meter
  is_zero_size mask_itf.nc            && acc_cp mask_itf.nc            $nemo_mask_itf
  is_zero_size M2rowdrg.nc            && acc_cp M2rowdrg.nc            $nemo_M2rowdrg
  is_zero_size K1rowdrg.nc            && acc_cp K1rowdrg.nc            $nemo_K1rowdrg
  is_zero_size Eddyengf.nc            && acc_cp Eddyengf.nc            $nemo_Eddyengf
#  is_zero_size geothermal_heating.nc  && acc_cp geothermal_heating.nc  $nemo_geothermal_heating
  is_zero_size runoff_core_monthly.nc && acc_cp runoff_core_monthly.nc $nemo_runoff_core_monthly
  is_zero_size sss_data.nc            && acc_cp sss_data.nc            $nemo_sss_data
  is_zero_size sst_data.nc            && acc_cp sst_data.nc            $nemo_sst_data
  is_zero_size chlorophyll.nc         && acc_cp chlorophyll.nc         $nemo_chlorophyll
  is_zero_size subbasins.nc           && acc_cp subbasins.nc           $nemo_subbasins

  if [[ "$runmode" == NEMO-AGCM-dcpp-assim* ]] ; then
    nemo_data_1m_potential_temperature_nomask=${nemo_data_1m_potential_temperature_nomask:=nemo_3.4_orca1_potemp_1m_z46_nomask.nc}
    nemo_data_1m_salinity_nomask=${nemo_data_1m_salinity_nomask:=nemo_3.4_orca1_salin_1m_z46_nomask.nc}
  else
    nemo_data_1m_potential_temperature_nomask=${nemo_data_1m_potential_temperature_nomask:=omip6_orca1_data_ptmp_nomask.nc}
    nemo_data_1m_salinity_nomask=${nemo_data_1m_salinity_nomask:=omip6_orca1_data_salt_nomask.nc}
  fi

  is_zero_size data_1m_potential_temperature_nomask.nc &&
      acc_cp data_1m_potential_temperature_nomask.nc $nemo_data_1m_potential_temperature_nomask
  is_zero_size data_1m_salinity_nomask.nc &&
      acc_cp data_1m_salinity_nomask.nc              $nemo_data_1m_salinity_nomask

  # Modify all FAFMIP related quantities
  if [[ $nemo_config == *"_FAFMIP"* ]]; then

    # Set specified or default names for fafmip forcing files
    nemo_fafmip_qtot=${nemo_fafmip_qtot:=cmip6_fafmip_hfds_orca1.nc}
    nemo_fafmip_tauu=${nemo_fafmip_tauu:=cmip6_fafmip_tauu_orca1.nc}
    nemo_fafmip_tauv=${nemo_fafmip_tauv:=cmip6_fafmip_tauv_orca1.nc}
    nemo_fafmip_wfo=${nemo_fafmip_wfo:=cmip6_fafmip_wfo_orca1.nc}
    # Access all the forcing files
    is_zero_size fafmip_qtot.nc && acc_cp fafmip_qtot.nc $nemo_fafmip_qtot
    is_zero_size fafmip_tauu.nc && acc_cp fafmip_tauu.nc $nemo_fafmip_tauu
    is_zero_size fafmip_tauv.nc && acc_cp fafmip_tauv.nc $nemo_fafmip_tauv
    is_zero_size fafmip_wfo.nc  && acc_cp fafmip_wfo.nc $nemo_fafmip_wfo
  fi
  is_zero_size o2.nc && acc_cp o2.nc nemo_o2



  if [[ "$nemo_forcing" == "bulk_iaf" ]]; then
      # Forcing files to be accessed
      # In the case of interannual forcing, just give the file prefix. The ${prefix}_yYYYY.nc will be added
      # by xnemo.
      # NOTE: we need to define these defaults some where else
      nemo_t=omip6_orca1_corev2_t_10
      nemo_u=omip6_orca1_corev2_u_10
      nemo_v=omip6_orca1_corev2_v_10
      nemo_q=omip6_orca1_corev2_q_10
      nemo_qsw=omip6_orca1_corev2_ncar_rad
      nemo_qlw=omip6_orca1_corev2_ncar_rad
      nemo_precip=omip6_orca1_corev2_ncar_precip
      nemo_snow=omip6_orca1_corev2_ncar_precip
      nemo_runoff=omip6_orca1_corev2_runoff

      # WEIGHTS file for this resolution
      nemo_weights_bicubic2=
      nemo_weights_bilinear2=

      yearc=`expr ${current_year} | awk  '{printf "%04d",$1}'`
      yearca=`expr ${current_year} - ${year_run_start} + 1 | awk  '{printf "%04d",$1}'`
      fy=`expr ${yearca} + ${iaf_year_offset} | awk  '{printf "%04d",$1}'`
      yd=`expr ${iaf_loop_year} - ${iaf_year_offset}`
      fyl=`expr ${fy} - '(' '(' ${yearca} - 1 ')' / ${yd} ')' \* ${yd}`
      forcing_year=`expr ${fyl} | awk  '{printf "%04d",$1}'`

      acc_cp tair10m_y${yearc}.nc          ${nemo_t}_y${forcing_year}.nc
      acc_cp uwnd10m_y${yearc}.nc          ${nemo_u}_y${forcing_year}.nc
      acc_cp vwnd10m_y${yearc}.nc          ${nemo_v}_y${forcing_year}.nc
      acc_cp humi10m_y${yearc}.nc          ${nemo_q}_y${forcing_year}.nc
      acc_cp qsw_y${yearc}.nc              ${nemo_qsw}_y${forcing_year}.nc
      acc_cp qlw_y${yearc}.nc              ${nemo_qlw}_y${forcing_year}.nc
      acc_cp precip_y${yearc}.nc           ${nemo_precip}_y${forcing_year}.nc
      acc_cp snow_y${yearc}.nc             ${nemo_snow}_y${forcing_year}.nc
      acc_cp runoff_y${yearc}.nc           ${nemo_runoff}_y${forcing_year}.nc
      is_defined $nemo_weights_bicubic2 && acc_cp weights_bic2.nc $nemo_weights_bicubic2
      is_defined $nemo_weights_bilinear2 && acc_cp weights_bil2.nc $nemo_weights_bilinear2
  fi

  if (( nemo_carbon == 1 )); then
    # Access PISCES files
    # note: defaults should be moved somewhere else
    nemo_presatm=${nemo_presatm:=uncs_orca1_presatm.nc}
    nemo_dust_orca=${nemo_dust_orca:=uncs_orca1_dust.orca.nc}
    nemo_river_orca=${nemo_river_orca:=nemo_3.4_orca2_river.orca.nc}
    nemo_ndeposition_orca=${nemo_ndeposition_orca:=uncs_orca1_ndeposition.orca.nc}
    nemo_bathy_orca=${nemo_bathy_orca:=uncs_orca1_bathy.orca.nc}

    is_zero_size presatm.nc          && acc_cp presatm.nc           $nemo_presatm
    is_zero_size dust.orca.nc        && acc_cp dust.orca.nc         $nemo_dust_orca
    is_zero_size river.orca.nc       && acc_cp river.orca.nc        $nemo_river_orca
    is_zero_size ndeposition.orca.nc && acc_cp ndeposition.orca.nc  $nemo_ndeposition_orca
    is_zero_size bathy.orca.nc       && acc_cp bathy.orca.nc        $nemo_bathy_orca

    if (( nemo_cmoc == 1 )); then
      nemo_fermask_orca=${nemo_fermask_orca:=nemo_3.4_orca1_femask.orca.nc}
      is_zero_size fermask.orca.nc && acc_cp fermask.orca.nc $nemo_fermask_orca
    fi

    if [[ "$nemo_forcing" == "bulk_iaf" ]]; then
        nemo_data_si_nomask=${nemo_data_si_nomask:=omip6_orca1_data_si_nomask.nc}
    else
        nemo_data_si_nomask=${nemo_data_si_nomask:=uncs_orca1_data_si_nomask.nc}
    fi

    nemo_data_dic_nomask=omip6_orca1_data_ct_preind_nomask.nc
    nemo_data_alkalini_nomask=omip6_orca1_data_at_nomask.nc
    nemo_data_o2_nomask=omip6_orca1_data_o2_nomask.nc
    nemo_data_po4_nomask=omip6_orca1_data_po4_nomask.nc
    nemo_data_no3_nomask=omip6_orca1_data_no3_nomask.nc
    nemo_data_doc_nomask=urjc_orca1_data_doc_nomask.nc
    nemo_data_fer_nomask=urjc_orca1_data_fer_nomask.nc
    nemo_data_atcco2=omip6_co2atm_annual.nc
    nemo_data_atc14c=omip6_Delta14co2.nc

    # Abiotic BGC
    nemo_data_at_abio_nomask=omip6_orca1_data_at_abio_nomask.nc
    nemo_data_c14t_abio_nomask=omip6_orca1_data_c14t_abio_nomask.nc
    nemo_data_ct_abio_nomask=omip6_orca1_data_ct_abio_nomask.nc
    nemo_data_o2_abio_nomask=omip6_orca1_data_o2abio_nomask.nc

    #cfc atmospheric history
    nemo_cfc_atmhist=ras003_nemo_cfc_atmhist.nc

    #c14 atmospheric history
    nemo_data_atc14c=omip6_delta14co2.nc

    is_zero_size data_dic_nomask.nc      && acc_cp data_dic_nomask.nc        $nemo_data_dic_nomask
    is_zero_size data_alkalini_nomask.nc && acc_cp data_alkalini_nomask.nc   $nemo_data_alkalini_nomask
    is_zero_size data_o2_nomask.nc       && acc_cp data_o2_nomask.nc         $nemo_data_o2_nomask
    is_zero_size data_po4_nomask.nc      && acc_cp data_po4_nomask.nc        $nemo_data_po4_nomask
    is_zero_size data_si_nomask.nc       && acc_cp data_si_nomask.nc         $nemo_data_si_nomask
    is_zero_size data_doc_nomask.nc      && acc_cp data_doc_nomask.nc        $nemo_data_doc_nomask
    is_zero_size data_fer_nomask.nc      && acc_cp data_fer_nomask.nc        $nemo_data_fer_nomask
    is_zero_size data_no3_nomask.nc      && acc_cp data_no3_nomask.nc        $nemo_data_no3_nomask

    # Abiotic biogeochemistry
    is_zero_size data_at_abio_nomask.nc   &&  acc_cp data_at_abio_nomask.nc    $nemo_data_at_abio_nomask
    is_zero_size data_c14t_abio_nomask.nc &&  acc_cp data_c14t_abio_nomask.nc  $nemo_data_c14t_abio_nomask
    is_zero_size data_ct_abio_nomask.nc   &&  acc_cp data_ct_abio_nomask.nc    $nemo_data_ct_abio_nomask
    is_zero_size data_o2abio_nomask.nc    &&  acc_cp data_o2abio_nomask.nc     $nemo_data_o2_abio_nomask

    if [[ "$nemo_ln_c14int" == ".true." ]]; then
      is_zero_size omip6_Delta14co2.nc &&  acc_cp omip6_Delta14co2.nc       $nemo_data_atc14c
    fi

    if (( nemo_cfc == 1 )); then
      is_zero_size nemo_cfc_atmhist.nc      &&  acc_cp nemo_cfc_atmhist.nc       $nemo_cfc_atmhist
    fi

    # Modify the pisces namelist to read CO2 from file, if specified in makefile
    if [[ "$nemo_ln_co2int" == ".true." ]]; then
      [ -s co2atm.nc ] ||  acc_cp omip6_co2atm.nc       $nemo_data_atcco2
    fi
  fi
  rm -f mesh_mask*.nc

echo "#################### Stop NEMO pre-processing #################"
