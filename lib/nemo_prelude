# NEMO prelude
#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
# TODO:
#   - make it so the variables used to define the expected restart names (cn_*rst_in/out)
#     variables are getting the information from canesm.cfg as opposed to being hard coded here
#   - come up with a new way that defaults are set (WAY TOO MANY THINGS ARE SET IN THIS SCRIPT)
#
# NOTE:
#   - this script relies on CanESM_shell_functions.sh

# Local Functions (these should be revaluated)
  function acc_cp() {
    # Attempt to access a file and if that fails attempt to copy it
    [ -z "$1" ] && bail "--> acc_cp <-- requires a local file name as the first arg"
    local_file=$1
    [ -z "$2" ] && bail "--> acc_cp $1 <-- requires a remote file name as the second arg"
    remote_file=$2
    shift 2
    access $local_file $remote_file $*
      #cp $remote_file $local_file ||
      #bail "--> acc_cp $local_file $remote_file $* <-- Unable to locate $remote_file"

    # sha1sum $local_file >> xnemo_access_log
  }

  function find_nemo_config_EXP00() {
    # Find a file in a CONFIG subdir of a NEMO repository
    [ -z "$1" ] && bail "find_nemo_config_EXP00: requires a file name as the first arg"
    if [ -n "$2" ]; then
      # If there is a second argument then assume it is the file name on DATAPATH
      acc_cp $1 $2 nocp=no
    else
      # Otherwise look for a configuration specific file in the config/namelists directory
      rm -f $1
      cp ${WRK_DIR}/config/namelists/$1 .
      [ -s $1 ] || bail "find_nemo_config_EXP00: Unable to copy $1 from ${WRK_DIR}/config/namelists/"
    fi
  }

echo "#################### Start NEMO pre-processing #################"
  # ======================================================
  # Make sure we have necessary variables from parent code
  # ======================================================
  is_defined $chunk_start_date      || bail "nemo_prelude: chunk_start_date must be defined"
  is_defined $chunk_start_year      || bail "nemo_prelude: chunk_start_year must be defined"
  is_defined $chunk_start_month     || bail "nemo_prelude: chunk_start_month must be defined"
  is_defined $run_start_year        || bail "nemo_prelude: run_start_year must be defined"
  is_defined $run_start_month       || bail "nemo_prelude: run_start_month must be defined"
  is_defined $run_stop_year         || bail "nemo_prelude: run_stop_year must be defined"
  is_defined $run_stop_month        || bail "nemo_prelude: run_stop_month must be defined"
  is_defined $CanNEMO_CONFIG           || bail "nemo_prelude: CanNEMO_CONFIG must be defined"
  is_defined $runid                 || bail "nemo_prelude: runid must be defined"
  is_defined $uxxx                  || bail "nemo_prelude: uxxx must be defined"
  is_defined $nemo_exec             || bail "nemo_prelude: nemo_exec must be defined"
  is_defined $runmode               || bail "nemo_prelude: runmode must be defined"
  is_defined $input_rs_date_string  || bail "nemo_prelude: input_rs_date_string must be defined"

  # This is the start of the simulation
  year_run_start=${run_start_time[0]:-1}

  # ===================
  # Access input files
  # ===================
  # - many are only pulled in they don't already exist

  # run namelists
  for f in ${nemo_namelists[@]}; do
      ! is_file ${f}_ref && cp ${WRK_DIR}/config/namelists/${f}_ref .
      ! is_file ${f}_cfg && cp ${WRK_DIR}/config/namelists/${f}_cfg .
  done
  # configuration input files
  is_defined $nemo_coordinates || bail "The variable nemo_coordinates must be defined in the configuration file."
  acc_cp domain_cfg.nc             $nemo_coordinates

  # Interannual forcing consideration
  if [[ $config == "ESM" ]]; then
    echo config == "ESM" : no forcing files needed, fields from CanCPL
  elif [[ $config == "OMIP" ]] && [[ $runmode == "CORE-NY" ]]; then
    acc_cp tair10m.nc          ${nemo_t}
    acc_cp uwnd10m.nc          ${nemo_u}
    acc_cp vwnd10m.nc          ${nemo_v}
    acc_cp humi10m.nc          ${nemo_q}
    acc_cp qsr.nc              ${nemo_qsr}
    acc_cp qlw.nc              ${nemo_qlw}
    acc_cp precip.nc           ${nemo_precip}
    acc_cp snow.nc             ${nemo_snow}
	acc_cp slp.nc              ${nemo_slp}
	acc_cp apr.nc              ${nemo_apr}
  elif [[ $config == "OMIP" ]] && [[ $runmode == "CanTODS" ]]; then
      # CanTODS setup
      # loop the forching for yyyy-1  to  yyyy+1  to do the interpolation with dec 31st of yyyy-1 and Jan 1st yyyy+1
      for current_year in `seq $(( 10#$chunk_start_year -1 )) $(( 10#$chunk_stop_year +1 )) `; do
        ## first and last year won't find the yyyy-1 and yyyy+1 (respectivelly).
        [[ $current_year -lt run_start_year || $current_year -gt run_stop_year ]] && continue

        yearc=`expr ${current_year} | awk  '{printf "%04d",$1}'`
        # In future, will want different forcing. For now, just repeat 2017.
        #forcing_year=`expr ${current_year} | awk  '{printf "%04d",$1}'`
        forcing_year=2017
        acc_cp tair_cantods025_y${yearc}.nc       ${nemo_t}_y${forcing_year}.nc
        acc_cp u_cantods025_y${yearc}.nc          ${nemo_u}_y${forcing_year}.nc
        acc_cp v_cantods025_y${yearc}.nc          ${nemo_v}_y${forcing_year}.nc
        acc_cp humi_cantods025_y${yearc}.nc        ${nemo_q}_y${forcing_year}.nc
        acc_cp qsr_cantods025_y${yearc}.nc        ${nemo_qsr}_y${forcing_year}.nc
        acc_cp qlw_cantods025_y${yearc}.nc       ${nemo_qlw}_y${forcing_year}.nc
        acc_cp prec_cantods025_y${yearc}.nc        ${nemo_precip}_y${forcing_year}.nc
        acc_cp snow_cantods025_y${yearc}.nc        ${nemo_snow}_y${forcing_year}.nc
        acc_cp slp_cantods025_y${yearc}.nc        ${nemo_slp}_y${forcing_year}.nc
        acc_cp apr_cantods025_y${yearc}.nc        ${nemo_apr}_y${forcing_year}.nc
        # boundaries
        acc_cp obc_north_cantods025_y${yearc}.nc     ${nemo_bn_north}_y${forcing_year}.nc
        acc_cp obc_south_cantods025_y${yearc}.nc     ${nemo_bn_south}_y${forcing_year}.nc
      done
	 
      #ICE IC
      if [[ $chunk_start_date == $run_start_date ]] ; then
        if [ ! -f restart_ice_in.nc ]; then
          acc_cp restart_ice_in.nc ctds-creg-2017-5y_ice_restart.nc
        fi
      fi

      # tides
      for tidebound in {north,south}; do
        acc_cp tide_${tidebound}_cantods025_grid_T.nc ${nemo_tide_elev}.nc 
        acc_cp tide_${tidebound}_cantods025_grid_U.nc ${nemo_tide_uvel}.nc
        acc_cp tide_${tidebound}_cantods025_grid_V.nc ${nemo_tide_vvel}.nc
      done

  elif [[ $config == "OMIP" ]]; then  # all the other OMIP runmode (e.g. omip1 ) 
      # loop the forching for yyyy-1  to  yyyy+1  to do the interpolation with dec 31st of yyyy-1 and Jan 1st yyyy+1
      for current_year in `seq $(( 10#$chunk_start_year -1 )) $(( 10#$chunk_stop_year +1 )) `; do
        ## first and last year won't find the yyyy-1 and yyyy+1 (respectivelly).
        [[ $current_year -lt run_start_year || $current_year -gt run_stop_year ]] && continue

        yearc=`expr ${current_year} | awk  '{printf "%04d",$1}'`
        fy=`expr ${yearc} - ${iaf_year_offset} | awk  '{printf "%04d",$1}'`
        yd=`expr ${iaf_loop_year} - ${iaf_year_offset}`
        fyl=`expr $iaf_year_offset + ${fy} % ${yd}`
        [ $fyl -le $iaf_year_offset ] && fyl=`expr $fyl + $yd`
        forcing_year=`expr ${fyl} | awk  '{printf "%04d",$1}'`
        acc_cp tair10m_y${yearc}.nc          ${nemo_t}_y${forcing_year}.nc
        acc_cp uwnd10m_y${yearc}.nc          ${nemo_u}_y${forcing_year}.nc
        acc_cp vwnd10m_y${yearc}.nc          ${nemo_v}_y${forcing_year}.nc
        acc_cp humi10m_y${yearc}.nc          ${nemo_q}_y${forcing_year}.nc
        acc_cp qsr_y${yearc}.nc              ${nemo_qsr}_y${forcing_year}.nc
        acc_cp qlw_y${yearc}.nc              ${nemo_qlw}_y${forcing_year}.nc
        acc_cp precip_y${yearc}.nc           ${nemo_precip}_y${forcing_year}.nc
        acc_cp snow_y${yearc}.nc             ${nemo_snow}_y${forcing_year}.nc
	    acc_cp slp_y${yearc}.nc              ${nemo_slp}_y${forcing_year}.nc
	    acc_cp apr_y${yearc}.nc              ${nemo_apr}_y${forcing_year}.nc
      done
  fi

if [[ $config != "AMIP" ]]; then 
  # in AMIP configuration, nemo is in SAS mode, no need for ocean input files
  if [[ $nemo_ln_weight == "on" ]];then
    is_defined $nemo_weights_bicubic2 && is_defined $nemo_weights_bilinear2  || 
        bail "The variables nemo_weights_bicubic2 and nemo_weights_bilinear2 must be defined in the configuration file"
    acc_cp weights_bic2.nc           $nemo_weights_bicubic2   # weights for bulk mode
    acc_cp weights_bil2.nc           $nemo_weights_bilinear2  # weights for bulk mode
  fi
  if [[ $nemo_ln_rnf == "on" ]]; then
    is_defined $nemo_runoff_core_monthly  || bail "The variables nemo_runoff_core_monthly must be defined in the configuration file"
    # first try with climatology, if file don't exist in the database, try the yearly vervion (with _yYYYY.nc).
    if [[ $config == "OMIP" ]] && [[ $runmode == "CanTODS" ]]; then
      acc_cp runoff_1m_nomask.nc    $nemo_runoff_core_monthly na
    else
      acc_cp runoffs.nc    $nemo_runoff_core_monthly na
    fi
    if [[ -n "$nemo_runoff" ]]; then # empty nemo_runoff means yearly files are not used. 
      for current_year in `seq $(( 10#$chunk_start_year -1 )) $(( 10#$chunk_stop_year +1 )) `; do
        ## first and last year won't find the yyyy-1 and yyyy+1 (respectivelly).
        [[ $current_year -lt run_start_year || $current_year -gt run_stop_year ]] && continue

        yearc=`expr ${current_year} | awk  '{printf "%04d",$1}'`
        fy=`expr ${yearc} - ${iaf_year_offset} | awk  '{printf "%04d",$1}'`
        yd=`expr ${iaf_loop_year} - ${iaf_year_offset}`
        fyl=`expr $iaf_year_offset + ${fy} % ${yd}`
        [ $fyl -le $iaf_year_offset ] && fyl=`expr $fyl + $yd`
        forcing_year=`expr ${fyl} | awk  '{printf "%04d",$1}'`
        acc_cp runoffs_y${yearc}.nc          ${nemo_runoff}_y${forcing_year}.nc
      done
    fi
  fi
  if [[ $nemo_ln_zdftmx == "on" ]]; then
    is_defined $nemo_mask_itf && is_defined $nemo_M2rowdrg && is_defined $nemo_K1rowdrg ||
        bail "The files for tidal mixing sheme must be defined in the configuration file."
    acc_cp mask_itf.nc               $nemo_mask_itf
    acc_cp M2rowdrg.nc               $nemo_M2rowdrg
    acc_cp K1rowdrg.nc               $nemo_K1rowdrg
  fi
  if [[ $nemo_ln_leewmx == "on" ]]; then
    is_defined $nemo_Eddyengf || bail "The file for lee wave mixing scheme must be defined in the configuration file."
    acc_cp Eddyengf.nc               $nemo_Eddyengf
  fi
  if [[ $nemo_ln_zdfiwm == "on" ]]; then
    is_defined $nemo_zdfiwm || bail "The file for tidal mixing parameterization must be defined in the configuration file."
    acc_cp zdfiwm_forcing.nc         $nemo_zdfiwm 
  fi 

  if [[ $nemo_nn_aei_ijk_t == -20 ]]; then
    is_defined $nemo_eddy_induced_velocity_2D || bail "The variable nemo_eddy_induced_velocity_2D must be defined in the configuration file."
    acc_cp eddy_induced_velocity_2D.nc $nemo_eddy_induced_velocity_2D
  fi
 
  if [[ $nemo_nn_ahm_ijk_t == -30 ]]; then
    is_defined $nemo_eddy_viscosity_3D || bail "The variable nemo_eddy_viscosity_3D must be defined in the configuration file."
    acc_cp eddy_viscosity_3D.nc      $nemo_eddy_viscosity_3D 
  fi

  if [[ $nemo_nn_ahm_ijk_t == -20 ]]; then
    is_defined $nemo_eddy_viscosity_2D || bail "The variable nemo_eddy_viscosity_2D must be defined in the configuration file."
    acc_cp eddy_viscosity_2D.nc      $nemo_eddy_viscosity_2D 
  fi

  if [[ $nemo_ln_tradmp == "on" ]]; then
    is_defined $nemo_resto || bail "The variable nemo_resto must be defined in the configuration file."
    acc_cp resto.nc                  $nemo_resto 
  fi 

  if [[ $nemo_nn_sssr != 0 ]]; then
    is_defined $nemo_sss_data || bail "The variable nemo_sss_data must be defined in the configuration file."
    acc_cp sss_data.nc               $nemo_sss_data
  fi 

  if [[ $nemo_ln_trabbc == "on" ]]; then
    is_defined $nemo_geothermal_heating || bail "The variable nemo_geothermal_heating must be defined in the configuration file."
    acc_cp geothermal_heating.nc     $nemo_geothermal_heating
  fi 
 
  if [  $nemo_traqrs != "bio" ] && [ $nemo_nn_chldta == 1 ]; then
    is_defined $nemo_chlorophyll || bail "The variable nemo_chlorophyll must be defined in the configuration file."
    acc_cp chlorophyll.nc            $nemo_chlorophyll
  fi 

  if [[ $nemo_ln_use_calving == "on" ]] || [[ nemo_nn_test_icebergs -eq -1 ]]; then
    is_defined $nemo_calving || bail "The variable nemo_calving must be defined in the configuration file."
    acc_cp calving.nc                $nemo_calving 
  fi 

  if [[ $nemo_bfr_boost != 0 ]]; then
    is_defined $nemo_bfr_coef || bail "The variable nemo_bfr_coef must be defined in the configuration file."
    acc_cp bfr_coef.nc               $nemo_bfr_coef
  fi 

  if [[ $nemo_ln_diaptr == "on" ]]; then
    is_defined $nemo_subbasins || bail "The variable nemo_subbasins must be defined in the configuration file."
    acc_cp subbasins.nc              $nemo_subbasins  
  fi 
  
  if [[ $nemo_nn_fwb == 2 ]];then
    is_defined $nemo_empave_old || bail "The variable nemo_empave_old must be defined in the configuration file."
    acc_cp EMPave_old.dat            $nemo_empave_old 
  fi

  # CanBGC IC and forcing files additional section defined in canesm.cfg.
  if [ "$nemo_trc" = "on" ] && [[ $nemo_carbon == "on" ]] ; then

      is_defined $nemo_presatm || bail "The variable nemo_presatm must be defined in canesm.cfg"
      acc_cp presatm.nc           $nemo_presatm
      
      is_defined $nemo_bathy_orca || bail "The variable nemo_bathy_orca must be defined in canesm.cfg"
      acc_cp bathy.orca.nc        $nemo_bathy_orca

      is_defined $nemo_chlorophyll || bail "The variable nemo_chlorophyll must be defined in canesm.cfg"
      acc_cp chlorophyll.nc       $nemo_chlorophyll  na 

      is_defined $nemo_dust_orca || bail "The variable nemo_dust_orca must be defined in canesm.cfg"
      acc_cp dust.orca.nc         $nemo_dust_orca
      
      is_defined $nemo_river_orca || bail "The variable nemo_river_orca must be defined in canesm.cfg"
      acc_cp river.orca.nc        $nemo_river_orca
      
      is_defined $nemo_par_orca || bail "The variable nemo_par_orca must be defined in canesm.cfg"      
      acc_cp par.orca.nc          $nemo_par_orca
      
      is_defined $nemo_solubility_orca || bail "The variable nemo_solubility_orca must be defined in canesm.cfg"      
      acc_cp solubility.orca.nc   $nemo_solubility_orca
      
      is_defined $nemo_hydrofe_orca || bail "The variable nemo_hydrofe_orca must be defined in canesm.cfg"      
      acc_cp hydrofe.orca.nc      $nemo_hydrofe_orca

      is_defined $nemo_ndeposition_orca || bail "The variable nemo_ndeposition_orca must be defined in canesm.cfg"      
      acc_cp ndeposition.orca.nc  $nemo_ndeposition_orca
      
      is_defined $nemo_data_dic_nomask || bail "The variable nemo_data_dic_nomask must be defined in canesm.cfg"      
      acc_cp data_DIC_nomask.nc        $nemo_data_dic_nomask
      
      is_defined $nemo_data_alkalini_nomask || bail "The variable nemo_data_alkalini_nomask must be defined in canesm.cfg"      
      acc_cp data_Alkalini_nomask.nc   $nemo_data_alkalini_nomask
      
      is_defined $nemo_data_o2_nomask || bail "The variable nemo_data_o2_nomask must be defined in canesm.cfg"      
      acc_cp data_O2_nomask.nc         $nemo_data_o2_nomask
      
      is_defined $nemo_data_po4_nomask || bail "The variable nemo_data_po4_nomask must be defined in canesm.cfg"      
      acc_cp data_PO4_nomask.nc        $nemo_data_po4_nomask
      
      is_defined $nemo_data_si_nomask || bail "The variable nemo_data_si_nomask must be defined in canesm.cfg"      
      acc_cp data_Si_nomask.nc        $nemo_data_si_nomask
      
      is_defined $nemo_data_doc_nomask || bail "The variable nemo_data_doc_nomask must be defined in canesm.cfg"      
      acc_cp data_DOC_nomask.nc        $nemo_data_doc_nomask
      
      is_defined $nemo_data_fer_nomask || bail "The variable nemo_data_fer_nomask must be defined in canesm.cfg"      
      acc_cp data_Fer_nomask.nc        $nemo_data_fer_nomask
      # trcsrc_canbgc.F90 use this file too.
      is_defined $nemo_fermask_orca    || bail "The variable nemo_fermask_orca must be defined in canesm.cfg"      
      acc_cp femask.nc                 $nemo_fermask_orca
      
      is_defined $nemo_data_no3_nomask || bail "The variable nemo_data_no3_nomask must be defined in canesm.cfg"      
      acc_cp data_NO3_nomask.nc        $nemo_data_no3_nomask

      # CanTODS BGC OBCs
      if [[ $runmode == "CanTODS" ]]; then
          is_defined $nemo_bn_bgc_north || bail "The variable nemo_bn_bgc_north must be defined in canesm.cfg"      
          acc_cp bdy_dta_trc_north.nc $nemo_bn_bgc_north
          is_defined $nemo_bn_bgc_south || bail "The variable nemo_bn_bgc_south must be defined in canesm.cfg"      
          acc_cp bdy_dta_trc_south.nc $nemo_bn_bgc_south
      fi
  fi

  # Access files required to run NEMO
  xios_files=( axis_def_nemo.xml \
               context_nemo.xml \
               domain_def_nemo.xml \
               field_def_nemo-ice.xml \
               field_def_nemo-oce.xml \
               file_def_nemo-ice.xml \
               file_def_nemo-oce.xml \
               grid_def_nemo.xml \
               iodef.xml )
  # add xios filoes if nemo_config is set to a CMOC, a CanOE or a PISCES config 
  if [[ $CanNEMO_CONFIG == *"CANOE" ]] ; then
	xios_files=( "${xios_files[@]}"  field_def_nemo-canoe.xml  file_def_nemo-canoe.xml )
  elif [[ $CanNEMO_CONFIG == *"CMOC" ]] ; then
	xios_files=( "${xios_files[@]}"  field_def_nemo-cmoc.xml    file_def_nemo-cmoc.xml )
  elif [[ $CanNEMO_CONFIG == *"PISCES" ]] ; then
	xios_files=( "${xios_files[@]}"  field_def_nemo-pisces.xml file_def_nemo-pisces.xml )
  fi

else
    echo "config == \"AMIP\" : surface condition for Stand alone surface module (SAS) forcing fields from CanCPL"
    # GT and SICN specified in SAS
    # get the forching for yyyy-1  to  yyyy+1  to do the interpolation with dec 31st of yyyy-1 and Jan 1st yyyy+1
    yearc=`expr ${current_year} - 1 | awk  '{printf "%04d",$1}'`
    acc_cp sst_data_y${yearc}.nc               ${sas_sst_data}_y${yearc}.nc  || true
    acc_cp siconc_data_y${yearc}.nc            ${sas_siconc_data}_y${yearc}.nc  || true
    acc_cp icemass_data_y${yearc}.nc           ${sas_simass_data}_y${yearc}.nc  || true
    yearc=`expr ${current_year} | awk  '{printf "%04d",$1}'`
    acc_cp sst_data_y${yearc}.nc               ${sas_sst_data}_y${yearc}.nc
    acc_cp siconc_data_y${yearc}.nc            ${sas_siconc_data}_y${yearc}.nc
    acc_cp icemass_data_y${yearc}.nc           ${sas_simass_data}_y${yearc}.nc
    yearc=`expr ${current_year} + 1 | awk  '{printf "%04d",$1}'`
    acc_cp sst_data_y${yearc}.nc               ${sas_sst_data}_y${yearc}.nc  || true
    acc_cp siconc_data_y${yearc}.nc            ${sas_siconc_data}_y${yearc}.nc  || true
    acc_cp icemass_data_y${yearc}.nc           ${sas_simass_data}_y${yearc}.nc  || true

    # If the file for yr-1 or yr+1 does not exist, NEMO will run but will not make time interpolation for 
    # the first part or the last part of the current_year.
        
  # Access files required to run NEMO
  xios_files=( axis_def_nemo.xml \
               context_nemo.xml \
               domain_def_nemo.xml \
               field_def_nemo-ice.xml \
               field_def_nemo-oce.xml \
               file_def_nemo-sas.xml \
               grid_def_nemo.xml \
               iodef.xml )

fi  # config != AMIP
  for file in "${xios_files[@]}"; do
    echo $file
    find_nemo_config_EXP00 $file
  done

  # disabled the ptr file if nemo_ln_diaptr="off"
  if [[ $nemo_ln_diaptr == "off" ]]; then
    sed -i '/diaptr/s/enabled=".TRUE."/enabled=".FALSE."/' file_def_nemo-oce.xml
  fi 
  # =====================
  # Set Inherited params
  # =====================

  # location of the source code
  nemo_repo=${nemo_repo:=$CCRNSRC/CanESM/CanNEMO}
  # Identify the location of the NEMO git repository and the commit within
  #   that repository that is associated with the current run
  if is_defined $nemo_ver; then
    # Dereference this commit and ensure we have a full sha1 hash
    nemo_ver=`(cd $nemo_repo; git rev-parse $nemo_ver)` ||
        bail "Unable to validate runtime nemo_ver"
  fi
  export nemo_ver nemo_repo CanNEMO_CONFIG
  echo "### NEMO runtime: nemo_repo   = $nemo_repo"
  echo "### NEMO runtime: nemo_ver    = $nemo_ver"
  echo "### NEMO runtime: CanNEMO_CONFIG = $CanNEMO_CONFIG"

  run_start_day=1
  run_start_date=$( printf "%04d-%02d-%02d" $run_start_year $run_start_month $run_start_day )
  run_stop_day=$(days_in_month $run_stop_month)
  run_stop_date=$( printf "%04d-%02d-%02d" $run_stop_year $run_stop_month $run_stop_day )
  echo "nemo_prelude: chunk_start_date=$chunk_start_date"
  echo "nemo_prelude: chunk_stop_date=$chunk_stop_date"
  echo "nemo_prelude: run_start_date=$run_start_date"
  echo "nemo_prelude: run_stop_date=$run_stop_date"

  # Touch xnemo_access_log so that it will exist even if it never gets apppended to
  rm -f xnemo_access_log
  touch xnemo_access_log

  # confirm a valid ice settings
  nn_ice=${nemo_nn_ice:=2}
  case $nn_ice in
    2) ;; # SI3 ice-model
    *) bail "Invalid value for nn_ice = $nn_ice" ;;
  esac

  # Ignore missing ice restart files when with_ice = off
  if (( nn_ice >= 2 )); then
    with_ice=1
  else
    with_ice=0
  fi

  # ==============================
  # Initial condition vs restart
  # ==============================
  nemo_from_rest=${nemo_from_rest:=off}
  # Switch 'nemo_from_rest' off if this isn't the first job in the run as it was
  #   _already_ started from rest
  if [[ $chunk_start_date != $run_start_date ]] && [[ "$nemo_from_rest" == "on" ]]; then
    nemo_from_rest='off'
  fi

  if [[ "$nemo_from_rest" == "on" ]]; then
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
    #=#=#=#    Start from rest    #=#=#=#
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

    echo "###############################"
    echo "###   Starting from rest.   ###"
    echo "###############################"

    # bail if use asked to use a specific restart and start from rest
    is_defined $nemo_restart && 
        bail "nemo_prelude: nemo_restart=$nemo_restart and nemo_from_rest='on' are mutually exclusive"
  
    # starting from rest, NOT a restart
    ln_rstart=.false.
    [ "$nemo_trc" = "on" ] && ln_rsttr=.false.

    # access the istate files
    if [[ $config != "AMIP" ]]; then # AMIP use the SAS modele how done not need intial state files
      is_defined $nemo_data_1m_temperature_rest && is_defined $nemo_data_1m_salinty_rest || bail "The variable nemo_data_1m_temperature_rest and nemo_data_1m_salinty_rest must be defined when Starting from rest."
      acc_cp data_1m_potential_temperature_nomask.nc $nemo_data_1m_temperature_rest
      acc_cp data_1m_salinity_nomask.nc              $nemo_data_1m_salinty_rest
    fi

  else
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#
    #=#=#=#   Start from a restart  #=#=#=#
    #=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#=#

    # starting from restart
    ln_rstart=.true.
    [ "$nemo_trc" = "on" ] && ln_rsttr=.true.

    # Determine what restart to use
    # -----------------------------
    # We start by trying to use the tiled restart, which is produced directly
    #   by the previous model run, but it won't be present for the first chunk
    rebuilt_restart_suffix="nemors"
    tiled_restart_suffix="tiled_nemors"
    restart_prefix=${uxxx}_${runid}_${input_rs_date_string}
    if fdb exists ${restart_prefix}_${tiled_restart_suffix}; then
        rs_file=${restart_prefix}_${tiled_restart_suffix}
    else
        rs_file=${restart_prefix}_${rebuilt_restart_suffix}
    fi

    # Access the restart and retrieve the contents
    # ----------------------------------------------
    echo "##########################"
    echo "###   Restarting from file $rs_file"
    echo "##########################"

    rm -f RESTART_ARC
    access RESTART_ARC $rs_file nocp=off || bail "Failed to access nemo restart!"

    # checksum the contents
    sha1sum RESTART_ARC/*restart* >> xnemo_access_log
    mv RESTART_ARC/*restart* . || bail "Cannot get files from restart directory"
    release RESTART_ARC

    # Rename each task specific restart files (extracted above)
    # ---------------------------------------------------------
    # - When starting a new run from an existing restart the ocean and ice restart
    #   file names found in the restart tar file will be prefixed with the runid used
    #   in the previous run.

    # Define the names that nemo will look for
    # - these files get extracted from the 'rs_file' file
    # - for INPUT files each domain's specific file will look like ${cn_*rst_in}_MMMM.nc
    #   while for OUTPUT files, each domain's specific file will look like ${runid}_NNNNNNN_${cn_*rst_out}_MMMM.nc
    #       - where MMMM is the MPI task number and NNNNNNNN is the timestep
    cn_ocerst_in="restart"          # ocean input
    cn_ocerst_out="restart"         # ocean output
    cn_icerst_in="restart_ice_in"   # ice input
    cn_icerst_out="restart_ice"     # ice output
    cn_trcrst_in="restart_trc_in"   # pisces input
    cn_trcrst_out="restart_trc"     # pisces output
    cn_icbrst_in="restart_icb_in"   # icb input
    cn_icbrst_out="restart_icb"     # icb output

    # Ocean restart files
    found_rs=`(ls -1 *_${cn_ocerst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_ocerst_out}.nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && bail "No ocean restart files were found in $rs_file"
    rm -f input_ocn_restart_file_names
    touch input_ocn_restart_file_names
    for rsfile in $found_rs; do
      [[ $rsfile =~ cpl_.*restart.nc ]] && continue
      sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
      [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
      mv $rsfile ${cn_ocerst_in}$sfx
      echo "${cn_ocerst_in}$sfx" >> input_ocn_restart_file_names
    done

    # Ice restart files
    rm -f input_ice_restart_file_names
    touch input_ice_restart_file_names
    found_rs=`(ls -1 *_${cn_icerst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_icerst_out}.nc || : ) 2>/dev/null`
    if [ -z "$found_rs" ]; then
      [ $nn_ice -ge 2 ] && bail "No ice restart files were found in $rs_file"
      with_ice=off
    else
      for rsfile in $found_rs; do
        [[ $rsfile =~ cpl_.*restart.nc ]] && continue
        sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
        [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
        mv $rsfile ${cn_icerst_in}$sfx
        echo "${cn_icerst_in}$sfx" >> input_ice_restart_file_names
      done
    fi

    # trc restart files
    rm -f input_trc_restart_file_names
    touch input_trc_restart_file_names
    found_rs=`(ls -1 *_${cn_trcrst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_trcrst_out}.nc || : ) 2>/dev/null`
    if [ -z "$found_rs" ]; then
      [ "$nemo_trc" = "on" ] && bail "No trc restart files were found in $nemo_rs"
    else
      for rsfile in $found_rs; do
        [[ $rsfile =~ cpl_.*restart.nc ]] && continue
        sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
        [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
        mv $rsfile ${cn_trcrst_in}$sfx
        echo "${cn_trcrst_in}$sfx" >> input_trc_restart_file_names
      done
    fi

    # icb restart files
    rm -f input_icb_restart_file_names
    touch input_icb_restart_file_names
    found_rs=`(ls -1 *_${cn_icbrst_out}_[0-9][0-9][0-9][0-9].nc || : ) 2>/dev/null`
    [ -z "$found_rs" ] && found_rs=`(ls -1 *_${cn_icbrst_out}.nc || : ) 2>/dev/null`
    if [ -z "$found_rs" ]; then
      [[ "$nemo_ln_icebergs" == "on" && $nemo_nn_test_icebergs -lt 0 ]] && bail "No icb restart files were found in $nemo_rs"
    else
      for rsfile in $found_rs; do
        [ $rsfile = 'cpl_restart.nc' ] && continue
        sfx=`echo $rsfile|sed 's/^.*\(_[0-9][0-9][0-9][0-9].nc\).*$/\1/'`
        [ "x$sfx" = "x$rsfile" ] && sfx=`echo $rsfile|sed 's/^.*\(\.nc\).*$/\1/'`
        mv $rsfile ${cn_icbrst_in}$sfx
        echo "${cn_icbrst_in}$sfx" >> input_icb_restart_file_names
      done
    fi
  fi

  # make namelist mods foir the restart switch 
    mod_nl namelist_cfg ln_rstart 
    [ "$nemo_trc" = "on" ] && mod_nl namelist_top_cfg ln_rsttr

  # in case of CanTODS (which has open boundaries), turn off tide ramp
  # on restart (it may not have been on, but this ensures it is off!)
  if [[ $config == "OMIP" ]] && [[ $runmode == "CanTODS" ]] && [[ "$ln_rstart" == ".true." ]]; then
    rn_tide_ramp_dt=0
    mod_nl namelist_cfg rn_tide_ramp_dt
  fi


  # force nn_istate=1 when  $output_level -ge 1  and $with_nemo_diag -eq 1 because 
  # ocean_diag needs the init.nc of the current year (1st Jan).
  # init.nc keep only if nemo_nn_istate
  if [ $output_level -ge 1 ] && [ $with_nemo_diag -eq 1 ] && [ $chunk_start_month == $run_start_month ];then 
    nn_istate=1
    mod_nl namelist_cfg nn_istate
  fi

  # nemo executable
  ! is_file $nemo_exec && cp ${EXEC_STORAGE_DIR}/$nemo_exec .
  # xios executable
  if [[ $nemo_use_xios_server -eq 1 ]]; then  
    is_defined $xios_exec             || bail "nemo_prelude: xios_exec must be defined"
    ! is_file $xios_exec && cp ${EXEC_STORAGE_DIR}/$xios_exec .
  fi                                 

echo "#################### Stop NEMO pre-processing #################"
