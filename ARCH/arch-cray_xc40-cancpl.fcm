# AIX P7 at CCCma
# NCDF_INC    netcdf include file
# NCDF_LIB    netcdf library
# FC          Fortran compiler command
# FCFLAGS     Fortran compiler flags
# FFLAGS      Fortran 77 compiler flags
# LD          linker
# LDFLAGS     linker flags, e.g. -L<lib dir> if you have libraries in a
# FPPFLAGS    pre-processing flags
# AR          assembler
# ARFLAGS     assembler flags
# MK          make  
# USER_INC    additional include files for the compiler,  e.g. -I<include dir> 
# USER_LIB    additional libraries to pass to the linker, e.g. -l<library>


%NCDF_INC            -I/opt/cray/hdf5/1.8.16/CRAY/8.3/include -I/opt/cray/netcdf/4.4.0/CRAY/8.3/include
%NCDF_LIB            -L/opt/cray/hdf5/1.8.16/CRAY/8.3/lib -lhdf5 -L/opt/cray/netcdf/4.4.0/CRAY/8.3/lib -lnetcdf -lnetcdff
%FC                  ftn
%FCFLAGS             -ffree -eZ -ra -O2 -Othread1,fp2,ipa1,vector2,cache2,scalar2 -h flex_mp=conservative -s real64 -s word_pointer -D_IMPI_=4 -O nointerchange -h byteswapio
%FFLAGS              -ffixed -eZ -ra -O2 -Othread1,fp2,ipa1,vector2,cache2,scalar2 -h flex_mp=conservative -s real64 -s word_pointer -D_IMPI_=4 -O nointerchange -h byteswapio
%LD                  ftn
%LDFLAGS    
%FPPFLAGS            -P -C
%AR                  ar  
%ARFLAGS             rs
%MK                  make 
%USER_INC            %NCDF_INC
%USER_LIB            %NCDF_LIB
