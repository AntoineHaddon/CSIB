# General CCCma CanNEMO compilation environment
#   - used for:
#       - nemo exe
#       - nemo diag executables
#       - nemo rtd executables
#       - rebuild nemo executable
#-----------------------------------------------------------
# Unload all modules and load Intel programming environment
#-----------------------------------------------------------
module purge
module load PrgEnv-intel/6.0.5

#---------------------------------
# Load specific modules as needed
#---------------------------------
module load craype-x86-skylake
module load cray-hdf5/1.10.2.0
module load cray-netcdf/4.6.1.3
module load cray-mpich/7.7.7
module load cray-shmem/7.7.7
module load atp/2.1.3
export ATP_ENABLED=1
export FOR_IGNORE_EXCEPTIONS=true

#--------------------------
# Unload modules as needed
#--------------------------
module unload cray-libsci   # conflicts with -mkl switch
