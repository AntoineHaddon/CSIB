#!/bin/bash
set -e
#
#   Usage: build-nemo [options] exec=name cfg=CONFIG \
#                     srcpath=SRCPATH \
#                     arch=ARCH_FILE \
#                     [refcfg=cfgdir] \
#                     [add_key=keys] \
#                     [del_key=keys] 
#          Quantities in square brackets are optional
#
# Purpose: Create a nemo executable, along with associated diagnostic/rtd executables. Note that
#           the final name of the nemo executable can be set by the user, but the diagnostic/rtd
#           executables will always use the names defined in their associated makefiles.
#
# Options:
# All options begin with a dash (-) and must appear before any other command line arg
#   -j num_proc     ...number of cpus to use for parallel compilation
#   -p strg_loc     ...instead of linking into CWD, link the executables into strg_loc (INCOMPATIBLE WITH -s)
#   -h              ...show this usage message
#   -d              ...compile an executable with debugging symbols (for use with DDT or GDB)
#   -x              ...run this script with 'set -x'
#   -s              ...save executables instead of linking them into the CWD (INCOMPATIBLE WITH -p)
#
# Variable definitions:
#   srcpath=srcpath     ...location of the NEMO source code. 
#   exec=name           ...name is the name of the nemo executable to be created
#                           On successful compilation, a file by this name will be linked [by default] into the CWD.
#                           Use -p to have them linked to a dif. location, or -s to have them saved to RUNPATH.
#   cfg=name            ...name is the name of a subdir under the CONFIG dir in the repository
#                           which will contain details of the model configuration (e.g. ORCA2_LIM)
#   refcfg=name         ...name is the name of a subdir under the CONFIG dir in the repository
#                           which will contain a reference configuration
#   arch=name           ...name is the name of an arch specific make include file found in the ARCH
#                           subdir that is used to define compiler switches and libs etc
#   add_key=keys        ...A whitespace separated list of cpp preprocessor keys to be added
#                           for this complie. If there is more than one then keys will need
#                           to be quoted. (e.g. add_keys="key_mpp_mpi key_vectopt_loop")
#   del_key=keys        ...A whitespace separated list of cpp preprocessor keys to be removed
#                           for this compile. If there is more than one then keys will need
#                           to be quoted. (e.g. del_keys="key_nproci key_nprocj")
#
# Examples:
#   build-nemo exec=nemo_v3.4_orca2_lim_exe cfg=ORCA2_LIM srcpath=/path/to/code/
#
#     -- Build an ORCA2_LIM configuration that uses the nemo code define in srcpath (with
#        a dir structure the same as the default).
#
########################################################################

#========================
# Define useful functions
#========================
THIS_SCRIPT_PATH=$(type $0|awk '{print $3}') # pathname of this script
THIS_SCRIPT_NAME=$(basename $THIS_SCRIPT_PATH)

# output the usage information
usage() {
    # if a message was passed into this function, output the message
    [ -n "$1" ] && echo "${THIS_SCRIPT_NAME}:" "$@"

    # finally, output the usage header
    sed -n '/^###/q; s/^#$/# /; s/^ *$/# /; 3,$s/^# //p;' "$THIS_SCRIPT_PATH"
}

# bail with non-zero exit status
bail(){
    echo "${THIS_SCRIPT_NAME}: *** ERROR *** $1"
    exit 1
}

#===========================================
# Set defaults and other pertinent variables
#===========================================
nemo_add_cpp_keys=''    # Nemo preprocessing keys to be added or removed at compile time
nemo_del_cpp_keys=''    # Nemo preprocessing keys to be added or removed at compile time
nemo_ref_config=''      # The reference configuration to be used with nemo_config
save_exec=''            # to "save" the execcutable or not
strg_loc=''             # if used, tells build-nemo to link executables here instead of CWD
is_coupled='no'         # Is this nemo build for a coupled model
comp_np=12              # Number of processors to use during compilation
debug=0                 # Set debug to 0 (turned off, regular optimizations used)
CWD=$(pwd)

printf "\n\n ------------------- \n"
printf "    build-nemo       \n"
printf " ------------------- \n"

#=======================================
# process command line options/arguments
#=======================================
# Flags
while getopts p:j:hxds opt; do
    case $opt in
        j) comp_np="$OPTARG" ;;
        x) set -x ;;
        s) save_exec="on" ;;
        p) strg_loc="$OPTARG" ;;
        d) debug=1 ;;
        h) usage ; exit 0 ;;
        ?) usage ; exit 1 ;;
    esac
done
shift $(( OPTIND - 1 ))

# Arguments
for arg in "$@"; do
    case $arg in
        *=*) 
            var=$(echo $arg | awk -F\= '{printf "%s",$1}')
            val=$(echo $arg | awk -F\= '{printf "%s",$2}')
            case $var in
                srcpath)    nemo_source_path="$val" ;;  # location of code in a dir structure (instead of cloning)
                exec)       nemo_exec="$val" ;;          # name for the executable created here
                cfg)        nemo_config="$val" ;;       # name of subdir in which config lives
                refcfg)     nemo_ref_config="$val" ;;   # name of subdir in which ref config lives
                arch)       nemo_arch="$val" ;;         # name of file with arch specific make defs
                add_key)    nemo_add_cpp_keys="$val" ;; # a list of cpp keys to add before compiling nemo
                del_key)    nemo_del_cpp_keys="$val" ;; # a list of cpp keys to remove before compiling nemo
                *)          usage "Invalid command line arg --> $arg <--"; exit 1  ;;
             esac
             ;;
        *) bail "Invalid command line arg --> $arg <--" ;;
  esac
done

#====================
# Consistency Checks
#====================
# Make sure -p and -s weren't used together
if [[ -n "$save_exec" && -n "$strg_loc" ]]; then
    usage "-p and -s are mutually exclusive flags!"; exit 1
fi

# if -p was used, make sure the given directory exists
if [[ -n "$strg_loc" ]]; then
    [[ -d "$strg_loc" ]] || bail "The desired executable output location ---> $strg_loc <--- doesn't exist!"
fi

# Make sure the required arguments were given
[[ -z "$nemo_source_path" ]]    && bail "srcpath must be given at the command line! See ${THIS_SCRIPT_NAME} -h"
[[ -z "$nemo_exec" ]]           && bail "exec must be given at the command line! See ${THIS_SCRIPT_NAME} -h"
[[ -z "$nemo_config" ]]         && bail "cfg must be given at the command line! See ${THIS_SCRIPT_NAME} -h"
[[ -z "$nemo_arch" ]]           && bail "arch must be given at the command line! See ${THIS_SCRIPT_NAME} -h"

# Perform some consistency checks
[[ -d "$nemo_source_path" ]] || bail "The given srcpath ---> $nemo_source_path <--- doesn't exist!"

# This script is intended to be run on the back end
case $TRUEHOST in
    xc3*|xc4*|banting|daley) ;;
        *) bail "This should be run on a back end machine" ;;
esac

#========================
# Set inherited variables
#========================
# define build directories
nemo_modl_blddir=${nemo_source_path}/nemo/CONFIG    # where makenemo gets called to build the model exec
nemo_diag_blddir=${nemo_source_path}/diag/build     # where make gets called to build the diagnostic execs
nemo_rtd_blddir=${nemo_source_path}/rtd/build       # where make gets called to build the rtd execs

# define produced executables (must be consistence with makenemo and diag/rtd makefiles)
produced_model_exec=${nemo_modl_blddir}/${nemo_config}/BLD/bin/nemo.exe
produced_diag_execs="nemo_diag.exe nemo_diag_cmoc.exe nemo_diag_canoe.exe"
produced_rtd_execs="nemo_physical_rtd.exe nemo_carbon-cmoc_rtd.exe nemo_carbon-canoe_rtd.exe nemo_ice_rtd.exe"

# prepends paths to diag/rtd exec lists 
#   - Note: "[^ ]*" -> matches words (strngs w/o interior spaces)
#           "&"     -> represents the matched pattern 
produced_diag_execs=$(echo $produced_diag_execs | sed "s#[^ ]*#${nemo_diag_blddir}/&#g")
produced_rtd_execs=$(echo $produced_rtd_execs | sed "s#[^ ]*#${nemo_rtd_blddir}/&#g")

# When debugging is requested, use the debug arch and update the name of the executable
if (( debug == 1 )); then
  nemo_arch="$nemo_arch-debug"
  nemo_exec="$nemo_exec-debug"
fi

#======================================
# Coupled consideration for model comp
#======================================
[[ "$nemo_config" == "CCC_CANCPL_"* ]] && is_coupled='yes'
if [[ "$is_coupled" == "yes" ]]; then
    # we must get code from the coupler repo, assumed to be housed in $CCRNSRC
    #  and cpp header files that should be contained in $WRK_DIR - confirm this
    [[ -z "$CCRNSRC" ]] && 
        bail "You are trying to compile for a coupled config and CCRNSRC isn't set! Has the coupled env been set up?"

    # define header files and check that they exist
    cppdef_config_file=${WRK_DIR}/cppdef_config.h
    cppdef_sizes_file=${WRK_DIR}/cppdef_sizes.h
    if [[ ! -f "$cppdef_config_file" ]] ; then
        bail_msg="You are trying to compile a coupled config but ${cppdef_config_file} doesn't exist!"
        bail "$bail_msg"
    fi
    if [[ ! -f "$cppdef_sizes_file" ]]; then
        bail_msg="You are trying to compile a coupled config but ${cppdef_config_file} doesn't exist!"
        bail "$bail_msg"
    fi

    # define other needed locations/files
    #   - Note: we must alter the extension of the linked cpp header files to be ".h90", as the
    #           the nemo compilation tools don't respect ".h" files.
    nemo_external_src_dir=${nemo_source_path}/nemo/NEMO/external                                # where the "external" code sits
    nemo_cppdef_config_link=${nemo_external_src_dir}/$(basename $cppdef_config_file .h).h90     # linked cpp config file
    nemo_cppdef_sizes_link=${nemo_external_src_dir}/$(basename $cppdef_sizes_file .h).h90       # linked cpp sizes file
    needed_cpl_src_file=${CCRNSRC}/CanESM/CanCPL/src/comm/com_cpl.F90                           # orig. needed cplr src file
    nemo_cpl_src_file=${nemo_external_src_dir}/com_cpl.F90                                      # copied (and modified) cplr src file

    # link in the cpp files
    [[ -f "$nemo_cppdef_config_link" ]] && rm -f $nemo_cppdef_config_link
    [[ -f "$nemo_cppdef_sizes_link" ]] && rm -f $nemo_cppdef_sizes_link
    ln -s $cppdef_config_file $nemo_cppdef_config_link
    ln -s $cppdef_sizes_file $nemo_cppdef_sizes_link

    # copy in external coupler file, and alter inlcude statements to use the .h90 links
    cp -f $needed_cpl_src_file $nemo_cpl_src_file
    sed -i "s/$(basename $cppdef_config_file)/$(basename $nemo_cppdef_config_link)/g" $nemo_cpl_src_file
    sed -i "s/$(basename $cppdef_sizes_file)/$(basename $nemo_cppdef_sizes_link)/g" $nemo_cpl_src_file
fi

#====================
# Compile the Model !
#====================
echo ""
echo "=================================="
echo "      Compiling the Model!        "
echo "=================================="
echo "Compiling in:  ${nemo_modl_blddir}"
cd $nemo_modl_blddir
#--- NECESSARY ? ---#
# Make everything user writeable so that an overwrite will clobber existing files
chmod -R u+w .
#-------------------#

# get compilation environment
source comp_env

# build command line args into a bash array -> array needed for potential space delim list in add_key/del_key
ARGS=( -j $comp_np -m $nemo_arch -n $nemo_config )
[[ -n "$nemo_ref_config" ]]     && ARGS+=( -r $nemo_ref_config )
[[ -n "$nemo_add_cpp_keys" ]]   && ARGS+=( add_key "$nemo_add_cpp_keys" )
[[ -n "$nemo_del_cpp_keys" ]]   && ARGS+=( del_key "$nemo_del_cpp_keys" )

# Create model executable
echo 'makenemo '"${ARGS[@]}"
./makenemo "${ARGS[@]}"

# reset the cfg.txt file to avoid dirtying the repo
echo "Resetting cfg.txt to HEAD"
git checkout HEAD cfg.txt || :

#======================
# Compile Diagnostics !
#======================
echo ""
echo "=================================="
echo "    Compiling the Diagnostics!    "
echo "=================================="
cd $nemo_diag_blddir

# source compilation environment and compile
source comp_env
make

#===============
# Compile RTDs!
#===============
echo ""
echo "=================================="
echo "    Compiling the RTDs!           "
echo "=================================="
cd $nemo_rtd_blddir

# source compilation environment and compile
source comp_env
make

#==============================================
# Save executables or link to desired directory
#==============================================
if [[ "$save_exec" == "on" ]]; then
    echo "Saving build-nemo produced executables to RUNPATH"

    # model exec
    save $produced_model_exec $nemo_exec || bail "Problem while saving $nemo_exec"
    
    # diag execs
    for diag_exec in $produced_diag_execs; do
        save $diag_exec $(basename $diag_exec) || bail "Problem while saving $diag_exec"
    done

    # rtd execs
    for rtd_exec in $produced_rtd_execs; do
        save $rtd_exec $(basename $rtd_exec) || bail "Problem while saving $rtd_exec"
    done
else
    # determine link location
    if [[ -n "$strg_loc" ]]; then
        link_loc=$strg_loc
    else
        link_loc=${CWD}
    fi
    echo "Linking build-nemo produced executables to $link_loc"

    # model exec
    [[ -f "${link_loc}/${nemo_exec}" ]] && rm ${link_loc}/${nemo_exec}
    ln -s $produced_model_exec ${link_loc}/${nemo_exec}

    # diag execs
    for diag_exec in $produced_diag_execs; do
        linked_exec=${link_loc}/$(basename $diag_exec)
        [[ -f "$linked_exec" ]] && rm $linked_exec
        ln -s $diag_exec $linked_exec
    done

    # rtd execs
    for rtd_exec in $produced_rtd_execs; do
        linked_exec=${link_loc}/$(basename $rtd_exec)
        [[ -f "$linked_exec" ]] && rm $linked_exec
        ln -s $rtd_exec $linked_exec
    done
fi

echo "build-nemo: DONE!"

# Return to the invocation directory
cd $CWD
