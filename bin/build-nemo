#!/bin/bash
#=====================================
# This script is adapted for NEMO4.0.3
# (D. Yang, OCT 2020)
#=====================================
set -e
#
#   Usage: build-nemo [options] exec=name cfg=CONFIG \
#                     srcpath=SRCPATH \
#                     nemo_arch=NEMO_ARCH_IDENTIFIER \
#                     util_arch=MAKE_TEMPLATE \
#                     comp_env=ENVIRONMENT_FILE \
#                     [refcfg=cfgdir] \
#                     [add_key=keys] \
#                     [del_key=keys]
#          Quantities in square brackets are optional
#
# Purpose: Create a nemo executable, along with associated diagnostic/rtd executables. Note that
#           the final name of the nemo executable can be set by the user, but the diagnostic/rtd
#           executables will always use the names defined in their associated makefiles.
#
# Options:
# All options begin with a dash (-) and must appear before any other command line arg
#   -j num_proc     ...number of cpus to use for parallel compilation
#   -p storage_loc  ...instead of storing executables in the CWD, store them in storage_loc
#   -h              ...show this usage message
#   -d              ...compile an executable with debugging symbols (for use with DDT or GDB)
#   -x              ...run this script with 'set -x'
#   -c              ...copy executables instead of linking them after building is complete
#   -f              ...force a "clean" compile
#
# Variable definitions:
#   srcpath=srcpath     ...location of the NEMO source code.
#   exec=name           ...name is the name of the nemo executable to be created
#                           On successful compilation, a file by this name will be linked [by default] into the CWD.
#                           Use -p to have them linked to a dif. location, or -s to have them saved to RUNPATH.
#   cfg=name            ...name is the name of a subdir under the CONFIG dir in the repository
#                           which will contain details of the model configuration (e.g. ORCA2_LIM)
#   refcfg=name         ...name is the name of a subdir under the CONFIG dir in the repository
#                           which will contain a reference configuration
#   nemo_arch=name      ...name is used by makenemo to identify the arch specific make include file found in the ARCH
#                           subdir that is used to define compiler switches and libs etc for the compilation
#                           of the nemo executable
#   util_arch=name      ...name is the make template file to be used in the compilation of nemo diagnostic/rtd/utility
#                           tools
#   comp_env=name       ...name is the file containing any necessary environment considerations for the compilation
#   add_key=keys        ...A whitespace separated list of cpp preprocessor keys to be added
#                           for this complie. If there is more than one then keys will need
#                           to be quoted. (e.g. add_keys="key_mpp_mpi key_vectopt_loop")
#   del_key=keys        ...A whitespace separated list of cpp preprocessor keys to be removed
#                           for this compile. If there is more than one then keys will need
#                           to be quoted. (e.g. del_keys="key_nproci key_nprocj")
#
# Examples:
#   build-nemo exec=nemo_v3.4_orca2_lim_exe cfg=ORCA2_LIM srcpath=/path/to/code/ \
#              nemo_arch=intel.eccc-xc50 util_arch=/path/to/make-template comp_env=/path/to/env/file
#
#     -- Build an ORCA2_LIM configuration that uses the nemo code define in srcpath (with
#        a dir structure the same as the default), using the intel.eccc-xc50 archfile.
#
########################################################################

#========================
# Define useful functions
#========================
THIS_SCRIPT_PATH=$(type $0|awk '{print $3}') # pathname of this script
THIS_SCRIPT_NAME=$(basename $THIS_SCRIPT_PATH)

# output the usage information
usage() {
    # if a message was passed into this function, output the message
    [ -n "$1" ] && echo "${THIS_SCRIPT_NAME}:" "$@"

    # finally, output the usage header
    sed -n '/^###/q; s/^#$/# /; s/^ *$/# /; 3,$s/^# //p;' "$THIS_SCRIPT_PATH"
}

# bail with non-zero exit status
bail(){
    echo "${THIS_SCRIPT_NAME}: *** ERROR *** $1"
    exit 1
}

#===========================================
# Set defaults and other pertinent variables
#===========================================
nemo_add_cpp_keys=''    # Nemo preprocessing keys to be added or removed at compile time
nemo_del_cpp_keys=''    # Nemo preprocessing keys to be added or removed at compile time
nemo_ref_config=''      # The reference configuration to be used with nemo_config
copy_execs=0            # to copy the execcutable or link (0=link, 1=copy)
storage_loc=$(pwd)      # tells build-nemo where to store executables
is_coupled=0            # Is this nemo build for a coupled model (0=ocean only, 1=coupled)
comp_np=12              # Number of processors to use during nemo compilation
xios_comp_np=4          # Number of processors to use during xios compilation
debug=0                 # Set debug to 0 (turned off, regular optimizations used)
clean_compile=0         # force build-nemo to run make clean on the diag/rtds and clean the temp NEMO comp dirs
CWD=$(pwd)

printf "\n\n ------------------- \n"
printf "    build-nemo       \n"
printf " ------------------- \n"

#=======================================
# process command line options/arguments
#=======================================
# Flags
while getopts p:j:hxdcf opt; do
    case $opt in
        j) comp_np="$OPTARG" ;;
        x) set -x ;;
        c) copy_execs=1 ;;
        p) storage_loc="$OPTARG" ;;
        d) debug=1 ;;
        h) usage ; exit 0 ;;
        f) clean_compile=1 ;;
        ?) usage ; exit 1 ;;
    esac
done
shift $(( OPTIND - 1 ))

# Arguments
for arg in "$@"; do
    case $arg in
        *=*)
            var=$(echo $arg | awk -F\= '{printf "%s",$1}')
            val=$(echo $arg | awk -F\= '{printf "%s",$2}')
            case $var in
                srcpath)    nemo_source_path="$val" ;;  # location of code in a dir structure (instead of cloning)
                exec)       nemo_exec="$val" ;;         # name for the executable created here
                cfg)        nemo_config="$val" ;;       # name of subdir in which config lives
                refcfg)     nemo_ref_config="$val" ;;   # name of subdir in which ref config lives
                arch)       nemo_arch="$val" ;;         # nemo arch name
                add_key)    nemo_add_cpp_keys="$val" ;; # a list of cpp keys to add before compiling nemo
                del_key)    nemo_del_cpp_keys="$val" ;; # a list of cpp keys to remove before compiling nemo
                exec)       nemo_exec="$val" ;;             # name for the executable created here
                cfg)        nemo_config="$val" ;;           # name of subdir in which config lives
                refcfg)     nemo_ref_config="$val" ;;       # name of subdir in which ref config lives
                nemo_arch)  nemo_arch_identifier="$val" ;;  # makenemo identifier for file with arch specific make defs
                util_arch)  nemo_util_arch_file="$val" ;;   # filename of the make template for nemo utilities
                comp_env)   compilation_env_file="$val";;   # filename containing the compilation environment
                add_key)    nemo_add_cpp_keys="$val" ;;     # a list of cpp keys to add before compiling nemo
                del_key)    nemo_del_cpp_keys="$val" ;;     # a list of cpp keys to remove before compiling nemo
                xios_arch)  xios_arch="$val"  ;;        # xios arch name
                xios_netcdf_lib)  xios_netcdf_lib="$val" ;; # choice of netcdf library (netcdf4_par or netcdf4_seq)
            	xios_full)  xios_full="--full" ;;           # The full compilation of xios
            	xios_dev)   xios_dev="--dev" ;;             # A developer mode for xios
                *)          usage "Invalid command line arg --> $arg <--"; exit 1  ;;
             esac
             ;;
        *) bail "Invalid command line arg --> $arg <--" ;;
  esac
done

#====================
# Consistency Checks
#====================
# if -p was used, make the directory if needed
if [[ -n "$storage_loc" ]]; then
    mkdir -p $storage_loc
fi

# make sure the required arguments were given
[[ -z "$nemo_source_path" ]]        && bail "srcpath must be given at the command line! See ${THIS_SCRIPT_NAME} -h"
[[ -z "$nemo_exec" ]]               && bail "exec must be given at the command line! See ${THIS_SCRIPT_NAME} -h"
[[ -z "$nemo_config" ]]             && bail "cfg must be given at the command line! See ${THIS_SCRIPT_NAME} -h"
[[ -z "$nemo_arch_identifier" ]]    && bail "nemo_arch must be given at the command line! See ${THIS_SCRIPT_NAME} -h"
[[ -z "$nemo_util_arch_file" ]]     && bail "util_arch must be given at the command line! See ${THIS_SCRIPT_PATH} -h"
[[ -z "$compilation_env_file" ]]    && bail "comp_env must be given at the command line! See ${THIS_SCRIPT_PATH} -h"

# make sure the source directory exists
[[ -d "$nemo_source_path" ]] || bail "The given srcpath ---> $nemo_source_path <--- doesn't exist!"

#========================
# Set inherited variables
#========================

xiosdir=xios-2.5
cfgdir=cfgs
xios_exec=xios_server.exe
tooldir=tools

# define build directories
nemo_xios_build_dir=${nemo_source_path}/nemo/${xiosdir}                    # where make_xios gets called to build the xios exec
nemo_model_build_dir=${nemo_source_path}/nemo                              # where makenemo gets called to build the model exec
nemo_diag_build_dir=${nemo_source_path}/diag/build                         # where make gets called to build the diagnostic execs
nemo_rtd_build_dir=${nemo_source_path}/rtd/build                           # where make gets called to build the rtd execs
nemo_rbld_build_dir=${nemo_source_path}/nemo/${tooldir}/REBUILD_NEMO/src/build  # where make gets called to build the tile rebuild execs

# define which build directories just use `make` and what compiler template they use
make_build_dirs="$nemo_diag_build_dir $nemo_rtd_build_dir $nemo_rbld_build_dir"

# define target executables (must be consistent with make_xios, makenemo and other makefiles)
target_xios_exec=${nemo_xios_build_dir}/bin/xios_server.exe
target_model_exec=${nemo_model_build_dir}/${cfgdir}/${nemo_config}/BLD/bin/nemo.exe
target_diag_execs="nemo_diag.exe nemo_diag_cmoc.exe nemo_diag_canoe.exe"
#target_rtd_execs="nemo_physical_rtd.exe nemo_carbon-cmoc_rtd.exe nemo_carbon-canoe_rtd.exe nemo_ice_rtd.exe"
target_rtd_execs="nemo_physical_rtd.exe"
target_rbld_execs="rebuild_nemo.exe rebuild_nemo_mpi.exe"

# prepends paths to diag/rtd/rbld exec lists
#   - Note: "[^ ]*" -> matches words (strngs w/o interior spaces)
#           "&"     -> represents the matched pattern
target_diag_execs=$(echo $target_diag_execs | sed "s#[^ ]*#${nemo_diag_build_dir}/&#g")
target_rtd_execs=$(echo $target_rtd_execs | sed "s#[^ ]*#${nemo_rtd_build_dir}/&#g")
target_rbld_execs=$(echo $target_rbld_execs | sed "s#[^ ]*#${nemo_rbld_build_dir}/&#g")

model_execs="$target_xios_exec $target_model_exec"

# all non-model executables get saved without renamining, store in list
# non_model_execs="$target_diag_execs $target_rtd_execs $target_rbld_execs"
non_model_execs="$target_rtd_execs $target_rbld_execs"

# When debugging is requested, use the debug arch and update the name of the executable
if (( debug == 1 )); then
  xios_debug="--debug"
  nemo_arch_identifier="$nemo_arch_identifier-debug"
  nemo_exec="$nemo_exec-debug"
fi

# set the working directory if it hasn't been set
if [[ -z "$WRK_DIR" ]]; then
    if [[ -n $SEQ_EXP_HOME ]]; then
        # if working within maestro use SEQ_EXP_HOME
        WRK_DIR=${SEQ_EXP_HOME}
    else
        # use working directory
        WRK_DIR=$(pwd)
    fi
fi

#======================================
# Coupled consideration for model comp
#======================================
[[ "$nemo_config" == "CCC_CANCPL_"* ]] && is_coupled=1
if (( is_coupled == 1 )); then
    # we must get code from the coupler repo, assumed to be clone besides the nemo source code
    canesm_src="${nemo_source_path}/../"

    # define header files and check that they exist
    cppdef_config_file=${WRK_DIR}/config/cppdef_config.h
    cppdef_sizes_file=${WRK_DIR}/config/cppdef_sizes.h
    if [[ ! -f "$cppdef_config_file" ]] ; then
        bail_msg="You are trying to compile a coupled config but ${cppdef_config_file} doesn't exist!"
        bail "$bail_msg"
    fi
    if [[ ! -f "$cppdef_sizes_file" ]]; then
        bail_msg="You are trying to compile a coupled config but ${cppdef_config_file} doesn't exist!"
        bail "$bail_msg"
    fi

    # define other needed locations/files
    #   - Note: we must alter the extension of the linked cpp header files to be ".h90", as the
    #           the nemo compilation tools don't respect ".h" files.
    nemo_external_src_dir=${nemo_source_path}/nemo/NEMO/external                                # where the "external" code sits
    nemo_cppdef_config_link=${nemo_external_src_dir}/$(basename $cppdef_config_file .h).h90     # linked cpp config file
    nemo_cppdef_sizes_link=${nemo_external_src_dir}/$(basename $cppdef_sizes_file .h).h90       # linked cpp sizes file
    needed_cpl_src_file=${canesm_src}/CanCPL/src/comm/com_cpl.F90                               # orig. needed cplr src file
    nemo_cpl_src_file=${nemo_external_src_dir}/com_cpl.F90                                      # copied (and modified) cplr src file

    # link in the cpp files (cleaning if they already exist)
    rm -f $nemo_cppdef_config_link
    rm -f $nemo_cppdef_sizes_link
    ln -s $cppdef_config_file $nemo_cppdef_config_link
    ln -s $cppdef_sizes_file $nemo_cppdef_sizes_link

    # copy in external coupler file, and alter inlcude statements to use the .h90 links
    cp -f $needed_cpl_src_file $nemo_cpl_src_file
    sed -i "s/$(basename $cppdef_config_file)/$(basename $nemo_cppdef_config_link)/g" $nemo_cpl_src_file
    sed -i "s/$(basename $cppdef_sizes_file)/$(basename $nemo_cppdef_sizes_link)/g" $nemo_cpl_src_file
fi

#===========
# Compile !
#===========

#-------------------
# compile the model
#-------------------
echo ""
echo "=================================="
echo "      Compiling the Model!        "
echo "=================================="

# Compiling xios first
echo "Compiling in:  ${nemo_xios_build_dir}"
cd ${nemo_xios_build_dir}

# build command line args into a bash array
ARGS=( --job $xios_comp_np --arch $xios_arch )
[[ -n $xios_full ]] && ARGS+=( $xios_full )
[[ -n $xios_debug ]] && ARGS+=( $xios_debug )
[[ -n $xios_dev ]] && ARGS+=( $xios_dev )
[[ -n $xios_netcdf_lib ]] && ARGS+=( $xios_netcdf_lib )

# Create xios executable (note that arch.env is sourced inside make_xios)
echo 'make_xios '"${ARGS[@]}"
./make_xios "${ARGS[@]}"

# Compiling nemo
echo "Compiling in:  ${nemo_model_build_dir}"
cd $nemo_model_build_dir

# source nemo compilation environment
source nemo_comp_env ||
    bail "Failed to source the nemo compilation environment! Are the modules available?"

# clean temporary dirs if this is a "clean" compile
if (( clean_compile == 1 )); then
    ./makenemo -n $nemo_config clean
fi

# build command line args into a bash array -> array needed for potential space delim list in add_key/del_key
ARGS=( -j $comp_np -m $nemo_arch_identifier -n $nemo_config )
[[ -n "$nemo_ref_config" ]]     && ARGS+=( -r $nemo_ref_config )
[[ -n "$nemo_add_cpp_keys" ]]   && ARGS+=( add_key "$nemo_add_cpp_keys" )
[[ -n "$nemo_del_cpp_keys" ]]   && ARGS+=( del_key "$nemo_del_cpp_keys" )

# Create model executable
echo 'makenemo '"${ARGS[@]}"
./makenemo "${ARGS[@]}"

# reset the cfg.txt and cpp_${CONFIG}.fcm files to avoid dirtying the repo
# files_to_reset="cfg.txt ${nemo_config}/cpp_${nemo_config}.fcm"
files_to_reset="${cfgdir}/${nemo_config}/cpp_${nemo_config}.fcm"

# log cpp_${nemo_config}.fcm
echo "${files_to_reset}:"
cat $files_to_reset

for f in $files_to_reset; do
    is_diff=0

    # check if the file has been changed
    git diff -s --exit-code $f || is_diff=1

    # reset if changed
    if (( is_diff == 1 )); then
        echo "Resetting $f to HEAD"
        git checkout HEAD $f
    fi
done

#-------------------------------
# compile exec's using makefiles
#-------------------------------
nemo_util_arch_file_basename=$(basename ${nemo_util_arch_file})
for build_dir in $make_build_dirs; do
    echo ""
    echo "=============================================="
    echo "    Compiling executables in $build_dir       "
    echo "=============================================="
    [[ -n "$build_dir" ]] && cd $build_dir

    # source environment
    [[ -n "$build_dir" ]] && source comp_env ||
        bail "Failed to source the compilation environment in ${build_dir}! Are the modules available?"

    # compile
    if (( clean_compile == 1 )); then
        make clean
    fi
    [[ -n "$build_dir" ]] && make
done

#---------------------------------
# confirm that compilation worked
#---------------------------------
for executable in $model_execs $non_model_execs; do
    [[ -f "$executable" ]] || bail "$executable doesn't exist! Did the compilation fail?"
done

#==============================================
# copy executables or link to desired directory
#==============================================
echo ""
echo "COMPILATION DONE"
echo ""

if (( copy_execs == 1 )); then
    echo "Copying build-nemo target executables to $storage_loc"
    cp -f $target_model_exec ${storage_loc}/${nemo_exec}
    cp -f $target_xios_exec ${storage_loc}/${xios_exec}
    for executable in $non_model_execs; do
        stored_exec=${storage_loc}/$(basename $executable)
        cp -f $executable $stored_exec
    done
else
    # determine link location
    if [[ -n "$storage_loc" ]]; then
        link_loc=$storage_loc
    else
        link_loc=${CWD}
    fi
    echo "Linking build-nemo target executables to $link_loc"

    # model exec (has the ability to be renamed via nemo_exec, which is why it is linked differently)
    for executable in $model_execs; do
        [[ -f "${link_loc}/${nemo_exec}" ]] && rm ${link_loc}/${nemo_exec}
    done
    ln -sf $target_xios_exec ${link_loc}/${xios_exec}
    ln -sf $target_model_exec ${link_loc}/${nemo_exec}

    # remaining execs, which can't be renamed
    for executable in $non_model_execs; do
        linked_exec=${storage_loc}/$(basename $executable)
        rm -rf $linked_exec ; ln -s $executable $linked_exec
    done
fi

echo "build-nemo: DONE!"

# Return to the invocation directory
cd $CWD
