# ====================
# "raw_env_setup_file" 
# ====================

runid_env=runid; export runid_env
WRK_DIR=/path/to/run; export WRK_DIR
CCRNSRC=/home/ords/crd/ccrn/scrd102/v5.1.0-0.0.9; export CCRNSRC

# access "access & fdb"
export PATH="$PATH:${CCRNSRC}/CanESM/CCCma_tools/scripts/subproc/:${CCRNSRC}/CanESM/CCCma_tools/scripts/comm/"

# source nemo_u2_site_profile
ORDS_ROOT=/home/ords/crd/ccrn
source ${ORDS_ROOT}/$(whoami)/${runid_env}/CanNEMO_tmp_src/utils/nemo_u2_site_profile

# determine HOSTID
HOSTID=`hostname | cut -d'.' -f1 `
HOSTID=${HOSTID:-`/usr/bin/hostname | cut -d'.' -f1 `} ; export HOSTID
if [ -n "${HOSTID}" ] ; then
  case ${HOSTID} in
         mom*) if [ -s "/fs/xc3lustre1/eccc/crd/." ] ; then
                . $CCRNSRC/CanESM/CCCma_tools/generic/banting_linux_setup_profile
               elif [ -s "/fs/xc4lustre1/eccc/crd/." ] ; then
                . $CCRNSRC/CanESM/CCCma_tools/generic/daley_linux_setup_profile
               fi                                                                                          ;;
         xc3*) . $CCRNSRC/CanESM/CCCma_tools/generic/banting_linux_setup_profile ;;
         xc4*) . $CCRNSRC/CanESM/CCCma_tools/generic/daley_linux_setup_profile ;;
        hpcr3*|cs3*|ppp3*|eccc*-ppp3*) . $CCRNSRC/CanESM/CCCma_tools/generic/ppp3_linux_setup_profile ;;
        hpcr4*|cs4*|ppp4*|eccc*-ppp4*) . $CCRNSRC/CanESM/CCCma_tools/generic/ppp4_linux_setup_profile ;;
        sc5*)  hall=hall5 ;;
        sc6*)  hall=hall6 ;;
        hpcr5*|*ppp5*) hall=hall5 ;;
        hpcr6*|*ppp6*) hall=hall6 ;;

            *) echo "nemo_env_setup_file: Sorry, no standard setup support yet for hostname --> $HOSTID  <-- !" ;;
  esac
else
  echo "nemo_env_setup_file: Sorry, not able to continue !"
  exit 2
fi

hall=hall5
echo "WARNING : hall=hall5 is forced for now"

# set RUNPATH & CCRNTMP & DATAPATH_DB
RUNPATH_ROOT="/space/${hall}/sitestore/eccc/crd/ccrn" ; export RUNPATH_ROOT
RUNPATH="${RUNPATH_ROOT}/users/$(whoami)" ;             export RUNPATH
CCRNTMP="${RUNPATH_ROOT}/ccrn_tmp/$(whoami)" ;          export CCRNTMP
# DATAPATH_DB="${RUNPATH_ROOT}/forcing/databases/datapath.db" ; export DATAPATH_DB
echo " DATAPATH_DB change to my personnal database file"
DATAPATH_DB="${RUNPATH}/forcing/databases/datapath.db" ; export DATAPATH_DB

# aliases
if [ -n "$SSH_TTY" ] ; then
 alias ll='/bin/ls -al'
 alias h='history'
 alias cls=' clear'
 alias cdferd='cd $RUNPATH'
 alias cdfetmp='cd $CCRNTMP'
 alias exph='export SEQ_EXP_HOME=`pwd`'
fi

# activate python infrastructure environment
if ! which conda >> /dev/null 2>&1 ; then
    # add cccma conda path if there is no conda on the path
    export PATH="${CCCMA_CONDA_PATH}:${PATH}"
fi
