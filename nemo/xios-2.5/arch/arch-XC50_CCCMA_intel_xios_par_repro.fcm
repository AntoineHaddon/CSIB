################################################################################
##             XIOS2.5 build instructions for parallel I/O (CCCma)            ##
##                                                                            ##
##  -std=c++98: The XIOS2.5 code uses shared_ptr (from boost) without using   ##
##              the boost namespace. The Intel 2019 C++ compiler defaults to  ##
##              a newer C++ standard, which implements std::shared_ptr.       ##
##              Therefore, the compiler does not know if it should use        ##
##              boost::shared_ptr or std::shared_ptr. C++98 standard library  ##
##              does not have a shared_ptr, so there is no ambiguity, which   ##
##              makes the compiler happy. Thanks to Philippe Blain.           ##
##  %BASE_FFLAGS: The options intend to be consistent with those in nemo4.*.  ##
##                                                                            ##
##  Tested on XC50 along with arch-XC50_CCCma_intel-pe_XIOS_par.env and       ##
##  arch-XC50_CCCma_intel-pe_XIOS_par.path.                                   ##
##                                                                            ##
##                            D. Yang, Aug/2020                               ##
################################################################################

%CCOMPILER      CC -std=c++98
%FCOMPILER      ftn
%LINKER         CC

%BASE_CFLAGS    

%PROD_CFLAGS    -O2
%DEV_CFLAGS     -O2
%DEBUG_CFLAGS   -g 

%BASE_FFLAGS    -free -fpp -D_IMPI_=4 -D_Cray_XC30 -Qoption,link,--noinhibit-exec -list -traceback -init=arrays -init=zero -fp-model precise -assume buffered_stdout,protect_parens -convert big_endian -r8 -align array32byte
%PROD_FFLAGS    -O3
%DEV_FFLAGS     -O2
%DEBUG_FFLAGS   -g

%BASE_INC       -D__NONE__
%BASE_LD        

%CPP            cpp
%FPP            cpp -P
%MAKE           gmake
