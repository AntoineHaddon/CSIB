#
# Intel compiler and Intel MPI
. ssmuse-sh -x main/opt/intelcomp/inteloneapi-2022.1.2/intelcomp+mpi+mkl >> /dev/null 2>&1

# NetCDF
. ssmuse-sh -x main/opt/hdf5-netcdf4/parallel/intelmpi-2022.1.2/static/inteloneapi-2022.1.2/01
#
export HDF5_INC_DIR=""
export HDF5_LIB_DIR=""
#
export NETCDF_INC_DIR=""
export NETCDF_LIB_DIR=""
