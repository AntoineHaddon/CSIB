# Make variables for the intel compiler on the Cray XC50
#=======================================================

# Fortran
FC = ftn
FFLAGS_OPT = -O2
FFLAGS_DEBUG = -O0 -g -traceback
FFLAGS_FLOAT_CONTROL = -mp1 -fp-model strict
FFLAGS_64BIT = -r8 -i8
FFLAGS_MOD = -module
FFLAGS_CPP = -fpp
FFLAGS_OMP = -qopenmp
FFLAGS_NETCDF = 
FFLAGS_MPI = 
FFLAGS_STATIC = -static
FFLAGS_CANDIAG = -fpic

# C 
CC = cc
### add C flags as necessary

# Note: we let the module system handle linking/includes on the xc50s
# Include Flags
INCLUDEFLAGS_USR =

# Linking Flags 
LDFLAGS_USR =
LDFLAGS_NETCDF = 
LDFLAGS_CANDIAG_PLT =
