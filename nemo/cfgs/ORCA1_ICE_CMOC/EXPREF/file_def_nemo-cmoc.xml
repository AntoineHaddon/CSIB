    <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" sync_freq="1mo" min_digits="4">
    <!-- <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" sync_freq="1d" min_digits="4"> -->
    
      <file_group id="1m" output_freq="1mo" output_level="10" enabled=".TRUE."> <!-- real monthly files -->
      <!-- <file_group id="1d" output_freq="1d" output_level="10" enabled=".TRUE."> <!-- real monthly files --> -->

        <file id="file32" name_suffix="_btrc_T" description="CMOC sms variables + TOP tracers" >
          <!-- BGCM standard : variables available with TOP activated alone  -->
          <field field_ref="DIC"      />
          <field field_ref="Alkalini" />
          <field field_ref="O2"       />
          <field field_ref="NO3"      /> 
          <!-- CMOC specific -->
          <field field_ref="POC"              />
          <field field_ref="PHY"              />
          <field field_ref="ZOO"              />
          <field field_ref="NCHL"             />
          <!-- <field ref="DICnat"           /> -->
          <!-- <field ref="ALKabio"          /> -->
          <!-- <field ref="DICabio"          /> -->
          <!-- <field ref="O2abio"           /> -->
          <!-- <field ref="DI14C"            /> -->
        </file>
        
        <file id="file33" name_suffix="_diad_T" description="additional CMOC diagnostics" >

          <!-- 3D fields here -->
          <field field_ref="pH"          />
          <!-- <field field_ref="CO3"         /> -->
          <!-- <field field_ref="CO3sat"      /> -->
          <!-- <field field_ref="HCO3"        /> -->

          <field field_ref="PAR"         />
          <field field_ref="PARDM"       />
          <field field_ref="PAR3"        />

          <field field_ref="PAR2BIO"     />
          <!-- PAR that we want to use in CanOE or CMOC production (1 or 3 bands) -->

          <field field_ref="tmask"       />
          <field field_ref="closea"      />

          <field field_ref="Irondep"     />    
          <field field_ref="Ironsed"     />    

         <!-- 2D fields here -->
          <field field_ref="Cflx"        />
          <field field_ref="Oflx"        />
          
          <field field_ref="KgCO2"       />
          <field field_ref="KgO2"        />
          
          <field field_ref="DpCO2"       />
          <field field_ref="DpO2"        />
          
