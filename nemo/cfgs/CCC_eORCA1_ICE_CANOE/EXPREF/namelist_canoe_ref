&namcandmp     !  Damping 
!,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
   ln_candmp    =  .true.     !  Relaxation of some tracers to a mean value
   nn_candmp    =   225       !  Frequency of Relaxation 
/
&namcanoenegtr   !   Switch on/off the negatrive tracer block
!-----------------------------------------------------------------------
   ln_canoenegtr = .false.    !  .false. means it will be skipped
/
!'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
&namcanmass     !  Mass conservation
!,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
   ln_check_mass =  .false.    !  Check mass conservation
/
