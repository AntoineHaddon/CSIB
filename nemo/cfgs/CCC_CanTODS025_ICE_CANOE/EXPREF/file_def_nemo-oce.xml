    <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" min_digits="4">

      <file_group id="5d" output_freq="5d" enabled=".TRUE."> <!-- real monthly files -->
      
        <file id="file11" name_suffix="_grid_T" description="ocean T grid variables">
          <field field_ref="toce"             name="thetao"         level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
          <field field_ref="soce"             name="so"             level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
          <field field_ref="sst"              name="tos"            level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
          <field field_ref="e3t"              name="e3t"            level="0" /> <!-- only rtd -->
          <field field_ref="ssh"              name="zos"            level="0" /> <!-- (Omon*) level = 1 in CMIP6  -->
          <field field_ref="empmr"            name="wfo"            level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
          <field field_ref="mldr10_1"         name="mlotst"         level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
	  <field field_ref="runoffs"          name="friver"         level="0" />	  
        </file>
        <file id="file12" name_suffix="_grid_U" description="ocean U grid variables">
          <field field_ref="uoce"        name="uo"       level="0" /> <!-- (Omon*) level = 1 in CMIP6  -->
          <!-- <field field_ref="uoce_eiv"    name="uoce_eiv" level="0" /> -->
          <field field_ref="utau"        name="tauuo"    level="0" /> <!-- (Omon*) level = 1 in CMIP6  -->
	  <field field_ref="e3u"         name="e3u"      level="0" /> <!-- only rtd -->
	  <!-- field field_ref="aeiu_2d"     name="aeiu2d"   level="0" -->
          <field field_ref="ahtuc_2d"    name="ahtuc2d"  level="0" operation="once" />
          <!-- <field field_ref="xatrp"            name="xatrp"         level="2"  /> <!-- (SImon*) <!-- Used for siareaacrossline in diag -->
          <!-- <field field_ref="xmtrpice"         name="xmtrpice"      level="2"  /> <!-- (SImon*) <!-- Used for simassacrossline in diag (i-direction not needed)-->
          <!-- <field field_ref="xmtrpsnw"         name="xmtrpsnw"      level="2"  /> <!-- (SImon*) <!-- Used for snmassacrossline in diag (i-direction not needed)-->
        </file>
        <file id="file13" name_suffix="_grid_V" description="ocean V grid variables">
          <field field_ref="voce"        name="vo"       level="0" /> <!-- (Omon*) level = 1 in CMIP6  -->
          <!-- <field field_ref="voce_eiv"    name="voce_eiv" level="0" /> -->
          <field field_ref="vtau"        name="tauvo"    level="0" /> <!-- (Omon*) level = 1 in CMIP6  -->
	  <field field_ref="e3v"         name="e3v"      level="0" /> <!-- only rtd -->
	  <!-- field field_ref="aeiv_2d"     name="aeiv2d"   level="0" -->
          <field field_ref="ahtvc_2d"    name="ahtvc2d"  level="0" operation="once" />
          <field field_ref="yatrp"            name="yatrp"         level="2"  /> <!-- (SImon*) <!-- Used for siareaacrossline in diag -->
          <field field_ref="ymtrpice"         name="ymtrpice"      level="2"  /> <!-- (SImon*) <!-- Used for simassacrossline in diag -->
          <field field_ref="ymtrpsnw"         name="ymtrpsnw"      level="2"  /> <!-- (SImon*) <!-- Used for snmassacrossline in diag -->
        </file>
        <file id="file14" name_suffix="_grid_W" description="ocean W grid variables">
          <field field_ref="woce"        name="wo"       level="0" /> <!-- (Omon) -->
          <!-- <field field_ref="woce_eiv"    name="woce_eiv" level="0" />  -->
	      <field field_ref="avt"         name="avt"      level="0" />
          <!-- <field field_ref="av_tmx"    name="av_tmx" level="0" /> -->
        </file>
          <!-- CMIP6 variables, started by NL, to be completed -->
        <file id="file15" name_suffix="_grid_T_ar6" description="ocean T grid variables">
          <field field_ref="botpres"          name="pbo"         level="1" /> <!-- (Omon*) -->
          <field field_ref="sbt"              name="tob"         level="1" /> <!-- (Omon*) -->
          <field field_ref="sss"              name="sos"         level="1" /> <!-- (Omon*) -->
          <field field_ref="sbs"              name="sob"         level="1" /> <!-- (Omon*) -->
          <field field_ref="qsr"              name="rsntds"      level="2" /> <!-- (Omon*) -->
          <field field_ref="runoffs"          name="friver"      level="2" /> <!-- (Omon*) -->
        </file>

        <file id="file16" name_suffix="_grid_U_ar6" description="ocean U grid variables">
          <field field_ref="u_masstr"         name="umo"           level="1" /> <!-- (Omon*) -->
          <field field_ref="xmtrptot"         name="sidmasstranx"  level="2"  /> <!-- (SImon*) <!-- Was Not in our CMIP6 but available in NEMO4 -->
        </file>

        <file id="file17" name_suffix="_grid_V_ar6" description="ocean V grid variables">
          <field field_ref="v_masstr"         name="vmo"           level="1" /> <!-- (Omon*) -->
          <field field_ref="ymtrptot"         name="sidmasstrany"  level="2"  /> <!-- (SImon*) <!-- Was Not in our CMIP6 but available in NEMO4 -->
        </file>

        <file id="file18" name_suffix="_grid_W_ar6" description="ocean W grid variables">
          <field field_ref="bn2"              name="obvfsq"      level="1" /> <!-- (Omon*) -->
          <field field_ref="w_masstr"         name="wmo"         level="1" /> <!-- (Omon*) -->
          <field field_ref="avt"              name="difvho"      level="3" /> <!-- (Oyr*) -->
          <field field_ref="avs"              name="difvso"      level="3" /> <!-- (Oyr*) -->
        </file>

      </file_group>

      <file_group id="3h"  output_freq="3h"  enabled=".TRUE."/> <!-- real yearly files -->
      <file_group id="1d"  output_freq="1d"  enabled=".TRUE."/> <!-- real yearly files -->
      <file_group id="1y"  output_freq="1y"  enabled=".TRUE."/> <!-- real yearly files -->
      <file_group id="1ts" output_freq="1ts"  enabled=".TRUE."/> <!-- 1 time step files -->
      <file_group id="2h"  output_freq="2h"   enabled=".TRUE."/> <!-- 2h files -->
      <file_group id="4h"  output_freq="4h"   enabled=".TRUE."/> <!-- 4h files -->
      <file_group id="6h"  output_freq="6h"   enabled=".TRUE."/> <!-- 6h files -->
      <file_group id="2m"  output_freq="2mo"  enabled=".TRUE."/> <!-- real 2m files -->
      <file_group id="3m"  output_freq="3mo"  enabled=".TRUE."/> <!-- real 3m files -->
      <file_group id="4m"  output_freq="4mo"  enabled=".TRUE."/> <!-- real 4m files -->
      <file_group id="6m"  output_freq="6mo"  enabled=".TRUE."/> <!-- real 6m files -->
      <file_group id="2y"  output_freq="2y"   enabled=".TRUE."/> <!-- real 2y files -->
      <file_group id="5y"  output_freq="5y"   enabled=".TRUE."/> <!-- real 5y files -->
      <file_group id="10y" output_freq="10y"  enabled=".TRUE."/> <!-- real 10y files -->

   </file_definition>




