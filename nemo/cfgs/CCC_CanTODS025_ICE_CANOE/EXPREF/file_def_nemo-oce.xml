<?xml version="1.0"?>

<!--
============================================================================================================
=                                           output files definition                                        =
=                                            Define your own filesfor ocean dynamics context               =
=                                         put the variables you want...                                    =
============================================================================================================
    -->

    <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" min_digits="4">

      <file_group id="5d" output_freq="5d" enabled=".TRUE."> <!-- real monthly files -->
      
        <file id="file11" name_suffix="_grid_T" description="ocean T grid variables">
          <field field_ref="toce"             name="thetao"         level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
          <field field_ref="soce"             name="so"             level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
          <field field_ref="sst"              name="tos"            level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
          <field field_ref="e3t"              name="e3t"            level="0" /> <!-- only rtd -->
          <field field_ref="ssh"              name="zos"            level="0" /> <!-- (Omon*) level = 1 in CMIP6  -->
          <field field_ref="empmr"            name="wfo"            level="0" /> <!-- (Omon*) level = 1 in CMIP6 -->
	  <field field_ref="runoffs"          name="friver"         level="0" />	  
        </file>
        <file id="file12" name_suffix="_grid_U" description="ocean U grid variables">
          <field field_ref="uoce"        name="uo"       level="0" /> <!-- (Omon*) level = 1 in CMIP6  -->
        </file>
        <file id="file13" name_suffix="_grid_V" description="ocean V grid variables">
          <field field_ref="voce"        name="vo"       level="0" /> <!-- (Omon*) level = 1 in CMIP6  -->
        </file>
        <file id="file14" name_suffix="_grid_W" description="ocean W grid variables">
          <field field_ref="woce"        name="wo"       level="0" /> <!-- (Omon) -->
        </file>
      </file_group>

      <file_group id="3h"  output_freq="3h"  enabled=".TRUE."/> <!-- real yearly files -->
      <file_group id="1d"  output_freq="1d"  enabled=".TRUE."/> <!-- real yearly files -->
      <file_group id="1y"  output_freq="1y"  enabled=".TRUE."/> <!-- real yearly files -->
      <file_group id="1ts" output_freq="1ts"  enabled=".TRUE."/> <!-- 1 time step files -->
      <file_group id="2h"  output_freq="2h"   enabled=".TRUE."/> <!-- 2h files -->
      <file_group id="4h"  output_freq="4h"   enabled=".TRUE."/> <!-- 4h files -->
      <file_group id="6h"  output_freq="6h"   enabled=".TRUE."/> <!-- 6h files -->
      <file_group id="2m"  output_freq="2mo"  enabled=".TRUE."/> <!-- real 2m files -->
      <file_group id="3m"  output_freq="3mo"  enabled=".TRUE."/> <!-- real 3m files -->
      <file_group id="4m"  output_freq="4mo"  enabled=".TRUE."/> <!-- real 4m files -->
      <file_group id="6m"  output_freq="6mo"  enabled=".TRUE."/> <!-- real 6m files -->
      <file_group id="2y"  output_freq="2y"   enabled=".TRUE."/> <!-- real 2y files -->
      <file_group id="5y"  output_freq="5y"   enabled=".TRUE."/> <!-- real 5y files -->
      <file_group id="10y" output_freq="10y"  enabled=".TRUE."/> <!-- real 10y files -->

   </file_definition>




