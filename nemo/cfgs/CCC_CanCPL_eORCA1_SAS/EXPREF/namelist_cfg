sn_snd_crtw   =   'none'                     ,    'no'    ,     ''      ,         ''           , 'U,V'
sn_snd_ifrac  =   'none'                     ,    'no'    ,     ''      ,         ''           ,   ''
sn_snd_wlev   =   'none'                     ,    'no'    ,     ''      ,         ''           ,   ''
sn_snd_cond   =   'none'                     ,    'no'    ,     ''      ,         ''           ,   ''
