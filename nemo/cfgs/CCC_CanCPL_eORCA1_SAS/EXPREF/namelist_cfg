sn_rcv_tau    =       'oce and ice'          ,    'no'    , 'spherical' , 'eastward-northward',  'T'   
sn_rcv_dqnsdt =       'coupled'              ,    'no'    ,     ''      ,         ''          ,   ''    
sn_rcv_qsr    =       'conservative'         ,    'no'    ,     ''      ,         ''          ,   ''    
sn_rcv_qns    =       'conservative'         ,    'no'    ,     ''      ,         ''          ,   ''    
sn_rcv_emp    =       'conservative'         ,    'no'    ,     ''      ,         ''          ,   ''    
