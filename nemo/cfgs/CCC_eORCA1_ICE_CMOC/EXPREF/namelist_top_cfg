! 1-band PAR
   kw_cmoc     =  0.04          ! PAR attenuation coefficient for seawater (m^-1)
   kchl_cmoc   =  0.03          ! PAR attenuation for chlorophyll          (m^-1) (mgChl m^-3)^-1
/
!-----------------------------------------------------------------------
&nambgcext     !   air-sea exchange
!-----------------------------------------------------------------------
   nn_co2int  =  0 ! =0, co2 constant (nn_atmco2) 
   nn_atmco2     =  288.0      ! Constant CO2 value in ppm (nn_co2int=0)
!-----------------------------------------------------------------------
   nn_patmint  =  0 ! =0, air pressure constant (nn_patm) 
   nn_patm     =  101325. ! Constant atmospheric pressure in Pa (nn_patmint=0)
/
