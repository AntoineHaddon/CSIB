!-----------------------------------------------------------------------
&namtrcsrcfe   !   iron deposition and sedimentation flux
!-----------------------------------------------------------------------
sedfeinput0  =  1000.    ! Coastal release of Iron
dustsolub0   =  0.01     ! Solubility of the dust
wdust0       =  2.0      ! Dust sinking speed
/
!-----------------------------------------------------------------------
&namtrcsrclog  !   external source switches
!-----------------------------------------------------------------------
   ln_dust0    =  .true.   ! dust input from the atmosphere
   ln_river0   =  .true.   ! river input of nutrients
   ln_ndepo0   =  .true.   ! atmospheric deposition of N
/
!-----------------------------------------------------------------------
&namtrc_opt    !   parameters for optics
!-----------------------------------------------------------------------
!              !  file name       ! frequency (hours) ! variable  ! time interp. !  clim  ! 'yearly'/ ! weights  ! rotation ! land/sea mask !
!              !                  !  (if <0  months)  !   name    !   (logical)  !  (T/F) ! 'monthly' ! filename ! pairing  ! filename      !
   sn_par      = 'par.orca'       ,     24.           , 'fr_par'  ,  .true.      , .true. , 'yearly'  , ''       , ''       , ''
