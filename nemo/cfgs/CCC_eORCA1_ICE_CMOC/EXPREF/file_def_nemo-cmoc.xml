          <field field_ref="O2"       name="O2"         level="0" />
          <field field_ref="NO3"      name="NO3"        level="0" /> 
          <!-- CMOC specific -->
          <field field_ref="POC"      name="POC"    level="0" />
          <field field_ref="PHY"      name="PHY"    level="0" />
          <field field_ref="ZOO"      name="ZOO"    level="0" />
          <field field_ref="NCHL"     name="NCHL"   level="0" />
