<?xml version="1.0"?>
    <!-- $id$ -->
    
 <!--
============================================================================================================
=                                           output files definition                                        =
=                                      Define your own files for sea ice                                   =
=                                         put the variables you want...                                    =
============================================================================================================
 -->
    
 <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" min_digits="4">
   
   <file_group id="1m" output_freq="1mo"  enabled=".TRUE.">  <!-- real monthly files -->   	
     <file id="file51" name_suffix="_icemod" description="ice variables">
       <field field_ref="icepres"         name="sitimefrac"     level="0"  /> <!-- (SImon*) -->
       <field field_ref="iceconc_pct"     name="siconc"         level="0"  /> <!-- (SImon*) -->
       <field field_ref="snwthic_cmip"    name="sisnthick"      level="0"  /> <!-- (SImon*) -->
       <field field_ref="icethic_cmip"    name="sithick"        level="0"  /> <!-- (SImon*) -->
       <field field_ref="icetemp"         name="iicetemp"       level="0"  /> <!-- only rtd -->
       <field field_ref="uice_cmip"       name="siu"            level="0"  /> <!-- (SImon*) -->
       <field field_ref="vice_cmip"       name="siv"            level="0"  /> <!-- (SImon*) -->
       <field field_ref="utau_ai_cmip"    name="sistrxdtop"     level="0"  /> <!-- (SImon*) <!-- Was Not in our CMIP6 but available in NEMO4 -->
       <field field_ref="vtau_ai_cmip"    name="sistrydtop"     level="0"  /> <!-- (SImon*) <!-- Was Not in our CMIP6 but available in NEMO4 -->
       <field field_ref="qtr_ice_bot"     name="qtr_ice_bot"    level="0"  /> <!-- only rtd -->
       <field field_ref="qt_ice_oce"      name="qt_ice_oce"     level="0"  /> <!-- only rtd -->
       <field field_ref="hfxsensib"       name="hfxsensib"      level="0" /> <!-- (Omon*) -->
       <field field_ref="O_QnsIce"        name="O_QnsIce"       level="0"  /> <!-- only rtd -->
       <field field_ref="O_QsrIce"        name="O_QsrIce"       level="0"  /> <!-- only rtd -->
       <field field_ref="qns_ice"         name="qns_ice"        level="0" /> <!-- only rtd -->
       <field field_ref="qsr_ice"         name="qsr_ice"        level="0" /> <!-- only rtd -->
       <field field_ref="hfxerr"         name="hfxerr"        level="0" /> <!-- only rtd -->
       <field field_ref="hflx_snow_ai_cea" name="hflx_snow_ai_cea"  level="0" /> <!-- (Omon*) level = 2 in CMIP6 -->
     </file>
     
   </file_group>

   <file_group id="1ts" output_freq="1ts" enabled=".TRUE."/> <!-- 1 time step files -->
   <file_group id="1h"  output_freq="1h"  enabled=".TRUE."> <!-- 1h files -->
   </file_group>
   <file_group id="2h"  output_freq="2h"  enabled=".TRUE."/> <!-- 2h files -->
   <file_group id="3h"  output_freq="3h"  enabled=".TRUE."/> <!-- 3h files -->     
   <file_group id="4h"  output_freq="4h"  enabled=".TRUE."/> <!-- 4h files -->
   <file_group id="6h"  output_freq="6h"  enabled=".TRUE."/> <!-- 6h files -->        
   <file_group id="1d"  output_freq="1d"  enabled=".TRUE."> <!-- 1d files -->        
     <file id="file53" name_suffix="_icemod" description="ice variables" >
          <field field_ref="icepres"          name="sitimefrac"  level="0" /> <!-- (SIday*) -->
          <field field_ref="iceconc_pct"      name="siconc"      level="0" /> <!-- (SIday*) -->
          <field field_ref="icethic_cmip"     name="sithick"     level="0" />  <!-- (SIday*) -->
          <field field_ref="snwthic_cmip"     name="sisnthick"   level="0" /> <!-- (SIday*) -->
          <field field_ref="icettop_cmip"     name="sitemptop"   level="0" /> <!-- (SIday*) -->
          <field field_ref="uice_cmip"        name="siu"         level="0" /> <!-- (SIday*) <!-- move from 1d_grid_U_ar6 to here-->
          <field field_ref="vice_cmip"        name="siv"         level="0" /> <!-- (SIday*) <!-- move from 1d_grid_V_ar6 to here-->
          <field field_ref="icevel_cmip"      name="sispeed"     level="0" /> <!-- (SIday*) -->
     </file>
   </file_group>

   <file_group id="2m"  output_freq="2mo" enabled=".TRUE."/> <!-- real 2m files -->
   <file_group id="3m"  output_freq="3mo" enabled=".TRUE."/> <!-- real 3m files -->
   <file_group id="4m"  output_freq="4mo" enabled=".TRUE."/> <!-- real 4m files -->
   <file_group id="6m"  output_freq="6mo" enabled=".TRUE."/> <!-- real 6m files -->
   <file_group id="1y"  output_freq="1y"  enabled=".TRUE."/> <!-- real yearly files -->
   <file_group id="2y"  output_freq="2y"  enabled=".TRUE."/> <!-- real 2y files -->
   <file_group id="5y"  output_freq="5y"  enabled=".TRUE."/> <!-- real 5y files -->
   <file_group id="10y" output_freq="10y" enabled=".TRUE."/> <!-- real 10y files -->
   
 </file_definition>
 
