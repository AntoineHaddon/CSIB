<?xml version="1.0"?> 
    <!-- $id$ -->
    
    <!-- 
============================================================================================================
=                                  definition of all existing variables                                    =
=                                            DO NOT CHANGE                                                 =
============================================================================================================
    -->

   <field_definition level="1" prec="4" operation="average" enabled=".TRUE." default_value="1.e20" >

============================================================================================================
                                     Biogeochemistry model variables + TOP tracers
============================================================================================================
    -->

      <!-- btrc on T grid -->

     <field_group id="btrc_T" grid_ref="grid_T_3D">
       <!-- BGCM standard : variables available with TOP activated alone  -->
       <field id="DIC"          long_name="Dissolved inorganic Concentration"        unit="mmol/m3" />
       <field id="Alkalini"     long_name="Total Alkalinity Concentration"           unit="mmol/m3" />
       <field id="O2"           long_name="Oxygen Concentration"                     unit="mmol/m3" />
       <field id="NO3"          long_name="NO3    Concentration"                     unit="mmol/m3" />
       <!-- CMOC specific -->
       <field id="POC"          long_name="Detritus CMOC"                            unit="mmolN/m3"  />
       <field id="PHY"          long_name="Phytoplankton Concentration CMOC"         unit="mmolN/m3"  />
       <field id="ZOO"          long_name="Zooplankton Concentration CMOC"           unit="mmolN/m3"  />
       <field id="NCHL"         long_name="Chlorophyll Concentration CMOC"           unit="mgChl/m3"  />
       <!-- <field id="DICabio"      long_name="Abiotic DIC"                              unit="mmolC/m3"  /> -->
       <!-- <field id="ALKabio"      long_name="Abiotic Alkalinity"                       unit="mmoleq/m3" /> -->
       <!-- <field id="O2abio"       long_name="Abiotic Oxygen"                           unit="umolO2/L"  /> -->
       <!-- <field id="DICnat"       long_name="Natural DIC"                              unit="mmolC/m3"  /> -->
       <!-- <field id="DI14C"        long_name="Radiocarbon DIC"                          unit="mmolC/m3"  /> -->
       
     </field_group>

     <!-- Additional diagnostics on T grid --> 

     <field_group id="diad_T">

       <!-- 3D fields here -->         
       <!-- <field id="CO3"         long_name="Carbonate"                             unit="mmol/m3"             grid_ref="grid_T_3D" /> -->
       <!-- <field id="CO3sat "     long_name="Carbonate saturation"                  unit="mmol/m3"             grid_ref="grid_T_3D" /> -->
       <!-- <field id="HCO3"        long_name="Bicarbonate"                           unit="mmol/m3"             grid_ref="grid_T_3D" /> -->
                                                                                  
       <!-- PAR that we want to use in CanOE or CMOC production (1 or 3 bands) -->
                                                                                  
       <field id="tmask"       long_name="tmask, from ocean physics"              unit="-"                   grid_ref="grid_T_3D" />
       <field id="closea"      long_name="BGCM closed sea masks"                  unit="-"                   grid_ref="grid_T_3D" />
                                                                                  
       <!-- 2D fields here -->
       <field id="pH"          long_name="pH"                                     unit="-"                   grid_ref="grid_T_2D" />
       <field id="Cflx"        long_name="CO2 flux positive if ocean gain"        unit="mol/m2/s"            grid_ref="grid_T_2D" />
       <field id="Oflx"        long_name="O2 flux positive if ocean gain"         unit="mol/m2/s"            grid_ref="grid_T_2D" />

       <field id="KgCO2"       long_name="CO2 Piston velocity"                    unit="m/s"                 grid_ref="grid_T_2D" />
       <field id="KgO2"        long_name="O2 Piston velocity"                     unit="m/s"                 grid_ref="grid_T_2D" />
       
       <field id="DpCO2"       long_name="Delta pCO2, air - sea"                  unit="uatm"                grid_ref="grid_T_2D" />
       <field id="DpO2"        long_name="Delta pO2, air - sea"                   unit="atm"                 grid_ref="grid_T_2D" />
       
       <field id="pCO2"        long_name="pCO2"                                   unit="uatm"                grid_ref="grid_T_2D" />
       <field id="pO2"         long_name="pO2"                                    unit="atm"                 grid_ref="grid_T_2D" />

       <field id="surf_chla"   long_name="surface chl-a external file"            unit="mg Chla/m3"          grid_ref="grid_T_2D" />

       <!-- CMOC PP diagnostics -->
       <field id="PPPHY"       long_name="Primary production"                     unit="mol/L/ts"            grid_ref="grid_T_3D" />
       <field id="Mumax"       long_name="Phyto growth rate"                      unit="s^-1"                grid_ref="grid_T_3D" />
       <field id="LNnut"       long_name="Nitrogen limitation term in Nanophyto"  unit="-"                   grid_ref="grid_T_3D" />
       <field id="LNFe"        long_name="Iron limitation term in Nanophyto"      unit="-"                   grid_ref="grid_T_2D" />
       <field id="LNlight"     long_name="Light limitation term in Nanophyto"     unit="-"                   grid_ref="grid_T_3D" />
       <field id="PARCMOC"     long_name="Photosynthetically Available Radiation" unit="W/m2"                grid_ref="grid_T_3D" />
       <field id="thchl2C"     long_name="Balanced chla:C ratio"                  unit="mg chla mg C^-3"     grid_ref="grid_T_3D" />
       <field id="chlaP"       long_name="Chl-a   production"                     unit="mg chla m^-3 s^-1"   grid_ref="grid_T_3D" />
       <field id="photor"      long_name="Photosynthetic rate"                    unit="s^-1"                grid_ref="grid_T_3D" />

       <!-- Temporary addition -->
       <field id="MORTP"       long_name="Phyto mortality rate"                   unit="mol/L/ts"            grid_ref="grid_T_3D" />
       <field id="REMNO3"      long_name="Nitrate remineralization rate/redet"    unit="mol/L/ts"            grid_ref="grid_T_3D" />
       <!-- CMOC export diagnostics -->
       <field id="oomask"      long_name="Open ocean mask v. level>= 28/ ~150m"   unit="-"                   grid_ref="grid_T_2D" />
       <field id="EPC100"      long_name="Export of carbon particles at 100 m"    unit="mol/m2/s"            grid_ref="grid_T_2D" />
       <field id="EPCALC100"   long_name="Export of Calcite at 100 m"             unit="mol/m2/s"            grid_ref="grid_T_2D" />
       <!-- CMOC N2 diagnostics -->        
       <field id="Nfix"        long_name="Nitrogen fixation at surface"           unit="mol/m2/s"            grid_ref="grid_T_2D" />
       <field id="Denit"       long_name="Water column denitrification"           unit="mol/m2/s"            grid_ref="grid_T_2D" />
          
       <field id="EPCz"        long_name="Export of carbon at all depths"         unit="mol/m2/s"            grid_ref="grid_T_3D" />
       <field id="GRAZZ"       long_name="Zooplankton grazing"                    unit="mol/L/ts"            grid_ref="grid_T_3D" />
       <field id="Z2POC"       long_name="Zooplankton excretion"                  unit="mol/L/ts"            grid_ref="grid_T_3D" />
       <field id="ZEXUD"       long_name="Zooplankton exudation"                  unit="mol/L/ts"            grid_ref="grid_T_3D" />
       <field id="ZMORT"       long_name="Zooplankton mortality (linear)"         unit="mol/L/ts"            grid_ref="grid_T_3D" />
       <field id="ZMORT2"      long_name="Zooplankton mortality (quadratic)"      unit="mol/L/ts"            grid_ref="grid_T_3D" />
       
       <!-- Temporary addition -->
       <!-- Ideal Age Tracer (IAT) from TOP -->
       <!-- <field id="Age"         long_name="Seawater age since contact with surface"  unit="years"             grid_ref="grid_T_3D"  /> --> -->


     </field_group>

   </field_definition>
