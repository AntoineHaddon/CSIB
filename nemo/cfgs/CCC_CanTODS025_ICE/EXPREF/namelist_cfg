  sn_wndi =  'u_cantods025',                    3        ,   'uas',       .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', 'U'       , '' 
  sn_wndj =  'v_cantods025',                    3        ,   'vas',       .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', 'V'       , '' 
  sn_qsr =   'qsr_cantods025',                  3        ,   'rsds',      .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', ''        , '' 
  sn_qlw =   'qlw_cantods025',                  3        ,   'rlds',      .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', ''        , '' 
  sn_tair =  'tair_cantods025',                 3        ,   'tas',       .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', ''        , '' 
  sn_humi =  'humi_cantods025',                 3        ,   'huss',      .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', ''        , '' 
  sn_prec =  'prec_cantods025',                 3        ,   'prra',      .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', ''        , '' 
  sn_snow =  'snow_cantods025',                 3        ,   'prsn',      .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', ''        , '' 
  sn_slp =   'slp_cantods025',                  3        ,   'psl',       .true.    ,   .false. , 'yearly'  , 'weights_bilinear_cantods025', ''        , '' 
