!-----------------------------------------------------------------------
&nambdy        !  unstructured open boundaries                          ("key_bdy")
!-----------------------------------------------------------------------
    ln_bdy = .true.                       ! use unstructured open boundaries
    nb_bdy         =  2                   !  number of open boundary sets
    ln_coords_file = .false., .false.     !  =T : read bdy coordinates from file
