################################################################################
##             NEMO4.* build instructions for parallel I/O (CCCma)            ##
##                                                                            ##
##  Required programing environment:                                          ##
##              module purge                                                  ##
##              module load PrgEnv-intel                                      ##
##              module load craype-x86-skylake                                ##
##              module load cray-mpich                                        ##
##              module load cray-netcdf-hdf5parallel                          ##
##  -std=c++98: The XIOS2.5 code uses shared_ptr (from boost) without using   ##
##              the boost namespace. The Intel 2019 C++ compiler defaults to  ##
##              a newer C++ standard, which implements std::shared_ptr.       ##
##              Therefore, the compiler does not know if it should use        ##
##              boost::shared_ptr or std::shared_ptr. C++98 standard library  ##
##              does not have a shared_ptr, so there is no ambiguity, which   ##
##              makes the compiler happy. Thanks to Philippe Blain.           ##
##  %XIOS_HOME: Currently fixed; will change to a variable.                   ##
##  -lstdc++:   Can probably be removed, but need a test.                     ##
##                                                                            ##
##             Tested on XC50, D. Yang, Aug/2020                              ##
################################################################################
#
# NCDF_HOME   root directory containing lib and include subdirectories for netcdf4
# HDF5_HOME   root directory containing lib and include subdirectories for HDF5
# XIOS_HOME   root directory containing lib for XIOS
# OASIS_HOME  root directory containing lib for OASIS
# NCDF_INC    netcdf include file
# NCDF_LIB    netcdf library
# FC          Fortran compiler command
# FCFLAGS     Fortran compiler flags
# FFLAGS      Fortran 77 compiler flags
# LD          linker
# LDFLAGS     linker flags, e.g. -L<lib dir> if you have libraries in a
# FPPFLAGS    pre-processing flags
# AR          assembler
# ARFLAGS     assembler flags
# MK          make  
# USER_INC    additional include files for the compiler,  e.g. -I<include dir>
# USER_LIB    additional libraries to pass to the linker, e.g. -l<library>
# CC          C compiler used to compile conv for AGRIF
# CFLAGS      compiler flags used with CC
#

%NCDF_HOME           /opt/cray/pe/netcdf-hdf5parallel/4.6.1.3/intel/16.0
%HDF5_HOME           
%XIOS_HOME           ${XIOS_DIR}
%OASIS_HOME          

%NCDF_INC            
%NCDF_LIB             

%XIOS_INC            -I%XIOS_HOME/inc
%XIOS_LIB            -L%XIOS_HOME/lib -lxios -lstdc++

%CPP                 cpp
%FC                  ftn

%FCFLAGS             -free -fpp -D_IMPI_=4 -D_Cray_XC30 -Qoption,link,--noinhibit-exec -list -traceback -O2 -init=arrays -init=zero -fp-model precise -assume buffered_stdout,protect_parens -convert big_endian -r8 -align array64byte -xSKYLAKE-AVX512
%FFLAGS              -fixed -fpp -D_IMPI_=4 -D_Cray_XC30 -Qoption,link,--noinhibit-exec -list -traceback -O2 -init=arrays -init=zero -fp-model precise -assume buffered_stdout,protect_parens -convert big_endian -r8 -align array64byte -xSKYLAKE-AVX512
%LDFLAGS    
%LD                  ftn
%FPPFLAGS            -P -C
%AR                  ar  
%ARFLAGS             rs
%MK                  gmake

%USER_INC            %NCDF_INC %XIOS_INC
%USER_LIB            %NCDF_LIB %XIOS_LIB

%CC                  CC -std=c++98
%CFLAGS              -O2
