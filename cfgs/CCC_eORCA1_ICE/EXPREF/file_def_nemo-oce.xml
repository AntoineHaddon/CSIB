          <field field_ref="hflx_snow_ao_cea" name="hfsnthermds"    level="0" /> <!-- (Omon) <!-- Not in CMIP6 but available in NEMO4 -->
          <field field_ref="hflx_snow_ai_cea" name="hfsnthermds2d"  level="0" /> <!-- (Omon) -->
          <field field_ref="hflx_rnf_cea"     name="hfrunoffds"     level="0" /> <!-- (Omon) <!-- Not in CMIP6 but available in NEMO4 -->
          <field field_ref="qt"               name="hfds"           level="0" /> <!-- (Omon) -->
          <field field_ref="qsr_tot"          name="qsr_tot"        level="0" /> <!-- only rtd -->
          <field field_ref="qns_tot"          name="qns_tot"        level="0" /> <!-- only rtd -->
        </file>
        <file id="file12" name_suffix="_grid_U" description="ocean U grid variables">
          <field field_ref="uoce"        name="uo"       level="0" /> <!-- (Omon) -->
          <field field_ref="uoce_eiv"    name="uoce_eiv" level="0" /> <!-- only rtd -->
          <field field_ref="utau"        name="tauuo"    level="0" /> <!-- (Omon) -->
          <field field_ref="e3u"         name="e3u"      level="0" /> <!-- only rtd -->
        </file>
        <file id="file13" name_suffix="_grid_V" description="ocean V grid variables">
          <field field_ref="voce"        name="vo"       level="0" /> <!-- (Omon) -->
          <field field_ref="voce_eiv"    name="voce_eiv" level="0" /> <!-- only rtd -->
          <field field_ref="vtau"        name="tauvo"    level="0" /> <!-- (Omon) -->
          <field field_ref="e3v"         name="e3v"      level="0" /> <!-- only rtd -->
        </file>
        <file id="file14" name_suffix="_grid_W" description="ocean W grid variables">
          <field field_ref="woce"        name="wo"       level="0" /> <!-- (Omon) -->
          <field field_ref="woce_eiv"    name="woce_eiv" level="0" />  <!-- only rtd -->
        </file>
          <!-- CMIP6 variables, started by NL, to be completed -->
        <file id="file15" name_suffix="_grid_T_ar6" description="ocean T grid variables">
          <field field_ref="botpres"          name="pbo"         level="1" /> <!-- (Omon) -->
          <field field_ref="tpt_dep"          name="zfullo"      level="1" /> <!--(Oclim) <!-- Not in CMIP6 but available in NEMO4 -->
          <field field_ref="sbt"              name="tob"         level="1" /> <!-- (Omon) -->
          <field field_ref="sss"              name="sos"         level="1" /> <!-- (Omon) -->
          <field field_ref="sbs"              name="sob"         level="1" /> <!-- (Omon) -->
          <field field_ref="mldr10_1min"      name="mlotstmin"   level="1" /> <!-- (Omon) -->
          <field field_ref="mldr10_1max"      name="mlotstmax"   level="1" /> <!-- (Omon) -->
          <field field_ref="mldr10_1_sq"      name="mlotstsq"    level="1" /> <!-- (Omon) <!-- codded in xios, to be check -->
          <field field_ref="hflx_ice_cea"     name="fsitherm"    level="1" /> <!-- (Omon) -->
          <field field_ref="rain_ao_cea"      name="prra"        level="1" /> <!-- (Omon) -->
          <field field_ref="qsr"              name="rsntds"      level="1" /> <!-- (Omon) -->
