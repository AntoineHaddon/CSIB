          <!-- <field field_ref=""             name="sfdsi"         level="1" />  <!-- (Omon)  not avaialble in NEMO4(need to code it?) -->
          <!-- <field field_ref=""             name="vsf"           level="1" />  <!-- (Omon)  not avaialble in  NEMO4(need to code it?) -->
        </file>

        <file id="file16" name_suffix="_grid_U_ar6" description="ocean U grid variables">
          <field field_ref="u_masstr"         name="umo"      level="1" /> <!-- (Omon) -->
