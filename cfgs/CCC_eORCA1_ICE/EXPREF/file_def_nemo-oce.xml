          <field field_ref="ymtrptot"         name="sidmasstrany"      level="3"  /> <!-- (SImon) <!-- Not in our CMIP6 but available in NEMO4 -->
        </file>

        <file id="file18" name_suffix="_grid_W_ar6" description="ocean W grid variables">
          <field field_ref="bn2"              name="obvfsq"      level="1" /> <!-- (Omon) -->
          <field field_ref="w_masstr"    name="wmo"      level="1" /> <!-- (Omon) -->
        </file>

        <file id="file19" name_suffix="_scalar_ar6" description="ocean scalar variables">
          <field field_ref="sshtot"           name="zosga"       level="1" /> <!-- (Omon) -->
          <field field_ref="ssttot"           name="tosga"       level="1" /> <!-- (Omon) -->
          <field field_ref="masstot"          name="masso"       level="1" /> <!-- (Omon) -->
          <field field_ref="voltot"           name="volo"        level="1" /> <!-- (Omon) -->
          <!-- <field field_ref="sshthster"        name="zostoga"     level="1" /> <!-- (Omon) NEMO ask for the file sali_ref_clim_monthly.nc -->
          <field field_ref="temptot"          name="thetaoga"    level="1" /> <!-- (Omon) -->
          <field field_ref="saltot"           name="sosga"        level="1" /> <!-- (Omon) -->
          <!-- <field field_ref="masstr_strait"    name="mfo"         level="1" /> <!-- (Omon)  maskMFO_* does not exist in field_def_neo-oce -->
        </file>


      </file_group>


      <file_group id="3h"  output_freq="3h"  enabled=".TRUE."> <!-- real yearly files -->
        <file id="file20" name_suffix="_grid_T_ar6" description="ocean T grid variables">
          <field field_ref="sst"              name="tos"            level="1" /> <!-- (Omon) -->
        </file>
      </file_group>

      <file_group id="1d"  output_freq="1d"  enabled=".TRUE."> <!-- real yearly files -->
        <file id="file21" name_suffix="_grid_T_ar6" description="ocean T grid variables">
            <field field_ref="sst"           name='tos'             level="1" /> <!-- (Omon) -->
            <field field_ref="sst2"          name='tossq'           level="1" /> <!-- (Omon) -->
            <field field_ref="sss"           name='sos'             level="3" /> <!-- (Omon) -->
            <field field_ref="sss2"          name='sossq'           level="3" /> <!-- (Omon) -->
            <field field_ref="mldkz5"        name='omldamax'        level="1" operation="maximum" />
        </file>
      </file_group>

      <file_group id="1y"  output_freq="1y"  enabled=".TRUE."> <!-- real yearly files -->
        <file id="file31" name_suffix="_grid_T_ar6" description="ocean T grid variables">
            <field field_ref="ttrd_xad"      name="ttrd_xad"        level="1" /> <!-- (Oyr)+diag -->
            <field field_ref="strd_xad"      name="strd_xad"        level="1" /> <!-- (Oyr)+ diag -->
