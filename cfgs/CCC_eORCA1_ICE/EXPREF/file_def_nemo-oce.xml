          <field field_ref="e3t"              name="thkcello"    level="1" /> <!--(Ofx) -->
          <field field_ref="volcello"         name="volcello"    level="1" /> <!--(Ofx) -->
          <field field_ref="runoffs"          name="friver"      level="1" /> <!-- (mon) -->
          <field field_ref="hflx_evap_cea"    name="hfevapds"    level="1" /> <!-- (Omon) <!-- Not in CMIP6 but available in NEMO4 -->
          <field field_ref="qlw_oce"          name="rlntds"      level="1" /> <!-- (Omon) <!-- Not in CMIP6 but available in NEMO4 -->
          <field field_ref="qla_oce"          name="hflso"       level="1" /> <!-- (Omon) <!-- Not in CMIP6 but available in NEMO4 -->
          <field field_ref="qsb_oce"          name="hfsso"       level="1" /> <!-- (Omon) <!-- Not in CMIP6 but available in NEMO4 -->
          <field field_ref="qsr3d"            name="rsdo"        level="1" /> <!-- (Omon) -->
          <field field_ref="fsal_virt_cea"    name="vsfsit"      level="2" /> <!-- (Omon) -->
          <field field_ref="ssh2"             name="zossq"       level="1" /> <!-- (Omon) -->
          <field field_ref="sst2"             name="tossq"       level="1" /> <!-- (Omon) -->
          <field field_ref="sss2"             name="sossq"       level="3" /> <!-- (Omon) <!-- Not in CMIP6 but available in NEMO4 -->
