    <file_definition type="one_file" name="@expname@_@freq@_@startdate@_@enddate@" min_digits="4">

      <file_group id="1m" output_freq="1mo"  enabled=".TRUE."> <!-- real monthly files -->

        <file id="file11" name_suffix="_grid_T" description="ocean T grid variables">
          <field field_ref="toce"             name="thetao"         level="0" /> <!-- (Omon) -->
          <field field_ref="soce"             name="so"             level="0" /> <!-- (Omon) -->
          <field field_ref="sst"              name="tos"            level="0" /> <!-- (Omon) -->
          <field field_ref="ssh"              name="zos"            level="0" /> <!-- (Omon) -->
          <field field_ref="empmr"            name="wfo"            level="0" /> <!-- (Omon) <!-- Not in CMIP6 but available in NEMO4 -->
          <field field_ref="mldr10_1"         name="mlotst"         level="0" /> <!-- (Omon) -->
          <field field_ref="snow_ai_cea"      name="sndmasssnf"     level="0" /> <!-- (SImon) -->
          <field field_ref="snowmel_cea"      name="sndmassmelt"    level="0" /> <!-- (SImon)  -->
          <field field_ref="snow_ao_cea"      name="prsn"           level="0" /> <!-- (Omon) -->
