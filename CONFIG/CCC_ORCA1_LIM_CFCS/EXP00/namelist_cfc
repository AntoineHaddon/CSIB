!,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
!              !    name   !           title of the field          !     units      !
!              !           !                                       !                !  
   cfcdia2d(1) = 'C11qtr  ' , 'CFC-11 surface flux                 ',  'mol/m2/s    '
   cfcdia2d(2) = 'C11qint ' , 'CFC-11 integrated surface flux      ',  'mol/m2      '
   cfcdia2d(3) = 'C12qtr  ' , 'CFC-12 surface flux                 ',  'mol/m2/s    '
   cfcdia2d(4) = 'C12qint ' , 'CFC-12 integrated surface flux      ',  'mol/m2      '
   cfcdia2d(5) = 'SF6qtr  ' , 'SF6 surface flux                    ',  'mol/m2/s    '
   cfcdia2d(6) = 'SF6fint ' , 'SF6 integrated surface lux          ',  'mol/m2      '
/
